.p-agree { display: flex; align-items: flex-start; padding: var(--mk-space-2) 0; }
.p-box { flex: none; width: 36rpx; height: 36rpx; line-height: 36rpx; text-align: center; border: var(--mk-border-strong); border-radius: 8rpx; margin: 4rpx var(--mk-space-2) 0 0; font-size: 24rpx; color: var(--mk-color-ink-inverse); }
.p-box.on { background: var(--mk-color-action-primaryFill); border-color: var(--mk-color-action-primaryFill); }
