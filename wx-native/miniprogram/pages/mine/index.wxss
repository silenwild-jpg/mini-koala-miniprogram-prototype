.mn-head { background: var(--mk-color-canvas-page); padding-top: var(--mk-space-5); padding-bottom: var(--mk-space-5); }
/* 任务卡组件自带下外边距、需求卡组件自带上外边距：这里抵掉任务卡的下外边距，让各卡之间都是一个卡间距（需真机确认） */
.mn-task { padding-top: var(--mk-space-cardGap); margin-bottom: calc(0rpx - var(--mk-space-cardGap)); }
.mn-avatar { width: 96rpx; height: 96rpx; border-radius: 50%; background: var(--mk-color-brand-tint); display: flex; align-items: center; justify-content: center; margin-right: var(--mk-space-3); flex: none; }
.mn-nm { display: block; }
.mn-lk { min-height: 64rpx; flex: none; }
.mn-login { flex: none; height: var(--mk-size-btnMdHeight); line-height: var(--mk-size-btnMdHeight); padding: 0 var(--mk-space-3); border: var(--mk-border-strong); border-radius: var(--mk-radius-control); font-size: var(--mk-font-size-md); }
.mn-card { margin-top: var(--mk-space-cardGap); }
.mn-new { border-left: 8rpx solid var(--mk-color-brand-fill); }
.mn-kicker { display: block; color: var(--mk-color-brand-text); font-size: var(--mk-font-size-xs); margin-bottom: var(--mk-space-1); }
.mn-block { display: block; }
.mn-cta { margin-top: var(--mk-space-3); }
.mn-gt { padding-bottom: var(--mk-space-1); }
.mn-all { min-height: 64rpx; }
.mn-asset { min-height: 128rpx; padding: var(--mk-space-2) 0; }
.mn-asset + .mn-asset { border-top: var(--mk-border-hairline); }
.mn-an { font-weight: var(--mk-font-weight-semibold); min-width: 0; }
.mn-tag { flex: none; margin-left: var(--mk-space-2); height: var(--mk-size-tagHeight); line-height: var(--mk-size-tagHeight); padding: 0 var(--mk-space-2); border-radius: var(--mk-radius-control); font-size: var(--mk-font-size-xs); background: var(--mk-color-status-infoFill); color: var(--mk-color-status-infoText); }
.mn-tag--ok { background: var(--mk-color-status-successFill); color: var(--mk-color-status-successText); }
.mn-tag--warn { background: var(--mk-color-status-warningFill); color: var(--mk-color-status-warningText); }
.mn-tag--err { background: var(--mk-color-status-errorFill); color: var(--mk-color-status-errorText); }
.mn-row { min-height: 104rpx; }
.mn-row + .mn-row { border-top: var(--mk-border-hairline); }
.mn-ic { margin-right: var(--mk-space-3); }
.mn-t { flex: none; font-weight: var(--mk-font-weight-medium); }
.mn-s { text-align: right; margin: 0 var(--mk-space-2) 0 var(--mk-space-3); }
.mn-badge { flex: none; min-width: 36rpx; height: 36rpx; line-height: 36rpx; padding: 0 10rpx; box-sizing: border-box; border-radius: 18rpx; text-align: center; background: var(--mk-color-status-errorStrong); color: var(--mk-color-ink-inverse); font-size: var(--mk-font-size-xs); margin-right: var(--mk-space-1); }
