<view class="mk-page">
  <view hover-class="mk-tap--hover" hover-stop-propagation="{{true}}" class="mn-head mk-gutter mk-row" bindtap="onHead" aria-role="button">
    <view class="mn-avatar"><image class="mk-icon mk-icon--md" src="/assets/icons/user-sub.svg" /></view>
    <view class="mk-grow">
      <text class="mk-h2 mn-nm">{{headTitle}}</text>
      <text class="mk-sub">{{headSub}}</text>
    </view>
    <view wx:if="{{loggedIn}}" class="mk-row mn-lk"><text class="mk-link">{{T.mine.profile}}</text><image class="mk-icon" src="/assets/icons/chev-brand.svg" /></view>
    <view wx:else class="mn-login">{{T.loginRegister}}</view>
  </view>
  <view class="mk-gutter">
    <view class="mn-task"><mk-task-card id="task" /></view>
    <mk-need-card />
    <view wx:if="{{showNew}}" class="mk-card mn-card mn-new">
      <text class="mn-kicker">{{T.mine.newCard.kicker}}</text>
      <text class="mk-title mn-block">{{T.mine.newCard.title}}</text>
      <text class="mk-sub mn-block">{{T.mine.newCard.sub}}</text>
      <button class="mk-btn mk-btn--md mn-cta" hover-class="mk-btn--hover" bindtap="onNewCta">{{T.mine.newCard.cta}}</button>
    </view>
  </view>
  <mk-sys-state wx:if="{{sys}}" type="{{sys}}" bind:retry="onRetry" />
  <view wx:else class="mk-gutter">
    <view wx:if="{{assets.length}}" class="mk-card mn-card">
      <view class="mk-between mn-gt">
        <text class="mk-title">{{T.mine.assets.title}}</text>
        <view hover-class="mk-tap--hover" hover-stop-propagation="{{true}}" wx:if="{{assetsAll}}" class="mk-row mn-all" bindtap="onAssetsAll" aria-role="button"><text class="mk-link">{{assetsAll}}</text><image class="mk-icon" src="/assets/icons/chev-brand.svg" /></view>
      </view>
      <view hover-class="mk-tap--hover" hover-stop-propagation="{{true}}" wx:for="{{assets}}" wx:key="id" class="mn-asset mk-row" data-id="{{item.id}}" bindtap="onAsset" aria-role="button">
        <view class="mk-grow">
          <view class="mk-row"><text class="mn-an mk-ellipsis">{{item.store}}</text><text class="mk-tag mk-tag--end mk-tag--{{item.tone}}">{{item.tag}}</text></view>
          <text class="mk-sub mn-block">{{item.unit}}</text>
          <text class="mk-mute mn-block">{{item.line}}</text>
        </view>
        <image class="mk-icon" src="/assets/icons/chev-mute.svg" />
      </view>
    </view>
    <view wx:for="{{groups}}" wx:key="key" class="mk-card mn-card">
      <text class="mk-title mn-gt mn-block">{{item.title}}</text>
      <mk-cell wx:for="{{item.items}}" wx:for-item="it" wx:for-index="ix" wx:key="k" icon="{{it.icon}}" title="{{it.t}}" value="{{it.s}}" badge="{{it.count || 0}}" divider="{{ix > 0}}" data-k="{{it.k}}" bindtap="onItem" />
    </view>
  </view>
  <view wx:if="{{demoLabel}}" class="mk-t-hint mn-demo" hover-class="mk-tap--hover" bindtap="onDemo" aria-role="button">{{demoLabel}}</view>
  <mk-login-sheet visible="{{loginVisible}}" tip="{{loginTip}}" bind:close="onLoginClose" bind:success="onLoginSuccess" />
</view>
