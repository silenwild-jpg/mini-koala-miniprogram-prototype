.hm-rule { width: 80rpx; height: 6rpx; border-radius: 3rpx; background: var(--mk-color-brand-fill); margin-top: var(--mk-space-2); }
.hm-tasks { display: flex; margin-top: var(--mk-space-cardGap); }
.hm-task { flex: 1; display: flex; flex-direction: column; margin-top: 0; padding: var(--mk-space-cardPadCompact); }
.hm-task + .hm-task { margin-top: 0; margin-left: var(--mk-space-3); }
.hm-ts { margin: 4rpx 0 var(--mk-space-3); }
.hm-weak { display: flex; margin-top: var(--mk-space-cardGap); padding: 0; }
.hm-wk { flex: 1; height: 96rpx; display: flex; align-items: center; justify-content: center; }
.hm-wk--r { border-left: var(--mk-border-hairline); }
.hm-wt { margin-left: var(--mk-space-2); font-weight: var(--mk-font-weight-medium); }
.hm-sec { margin: var(--mk-space-sectionGap) 0 var(--mk-space-3); }
.hm-fold { padding: var(--mk-space-3) 0; border-top: var(--mk-border-hairline); border-bottom: var(--mk-border-hairline); margin-bottom: 0; }
.hm-all { min-height: 64rpx; display: flex; align-items: center; }
.hm-rec { white-space: nowrap; width: 100%; }
.hm-rail { display: inline-flex; padding: 0 var(--mk-space-pageGutter); }
.hm-rcard { width: var(--mk-size-recCardWidth); margin-right: var(--mk-space-3); display: inline-flex; flex-direction: column; white-space: normal; box-sizing: border-box; padding: var(--mk-space-cardPadCompact); }
.hm-rcard + .hm-rcard { margin-top: 0; }
.hm-rn { font-size: var(--mk-font-size-md); display: block; }
.hm-rl { display: block; margin-top: 4rpx; }
.hm-rtags { display: flex; flex-wrap: wrap; overflow: hidden; height: var(--mk-size-tagHeight); margin: var(--mk-space-2) 0; }
.hm-scenes { display: flex; flex-wrap: wrap; margin-right: calc(0rpx - var(--mk-space-2)); }
.hm-scene { width: calc(33.33% - var(--mk-space-2)); margin: 0 var(--mk-space-2) var(--mk-space-2) 0; height: var(--mk-size-ctaHeight); display: flex; align-items: center; justify-content: center; background: var(--mk-color-canvas-card); border-radius: var(--mk-radius-thumb); font-size: var(--mk-font-size-sm); box-sizing: border-box; }
.hm-biz { display: flex; flex-direction: column; margin-top: var(--mk-space-sectionGap); }
.hm-btag { margin-left: var(--mk-space-2); }
.hm-bs { margin: 8rpx 0 var(--mk-space-2); }
.hm-nums { display: flex; }
.hm-num { flex: 1; display: flex; flex-direction: column; align-items: center; }
.hm-pn { font-size: var(--mk-font-size-2xl); font-weight: var(--mk-font-weight-bold); color: var(--mk-color-brand-text); }
.hm-about { margin-top: var(--mk-space-3); min-height: 64rpx; display: flex; align-items: center; justify-content: center; }
.hm-store-photo { display:block; width:100%; height:156rpx; margin-bottom:16rpx; border-radius:var(--mk-radius-thumb); }
