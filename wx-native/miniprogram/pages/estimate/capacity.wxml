<view class="mk-page cp-page">
  <mk-sys-state wx:if="{{sys}}" type="{{sys}}" bind:retry="onRetry" />
  <block wx:else>
    <view class="mk-gutter">
      <text class="mk-h2 cp-title">{{T.cap.title}}</text>
      <view class="cp-row mk-row {{error ? 'cp-bad' : ''}}">
        <view hover-class="mk-tap--hover" hover-stop-propagation="{{true}}" class="cp-step {{canMinus ? '' : 'cp-off'}}" data-dir="minus" bindtap="onStep" aria-role="button" aria-label="减少">−</view>
        <input class="cp-input mk-grow mk-num" type="digit" maxlength="-1" placeholder="{{unit === 'm3' ? T.cap.placeholderM3 : T.cap.placeholderM2}}" placeholder-class="cp-ph" value="{{raw}}" bindinput="onInput" bindblur="onBlur" />
        <view class="cp-units mk-row">
          <view hover-class="mk-tap--hover" hover-stop-propagation="{{true}}" class="cp-u {{unit === 'm3' ? 'cp-on' : ''}}" data-u="m3" bindtap="onUnit" aria-role="button">{{T.m3}}</view>
          <view hover-class="mk-tap--hover" hover-stop-propagation="{{true}}" class="cp-u {{unit === 'm2' ? 'cp-on' : ''}}" data-u="m2" bindtap="onUnit" aria-role="button">{{T.m2}}</view>
        </view>
        <view hover-class="mk-tap--hover" hover-stop-propagation="{{true}}" class="cp-step" data-dir="plus" bindtap="onStep" aria-role="button" aria-label="增加">＋</view>
      </view>
      <text wx:if="{{approx}}" class="mk-sub cp-line">{{approx}}</text>
      <text wx:if="{{error}}" class="mk-error cp-line">{{error}}</text>
      <view class="cp-quick">
        <view hover-class="mk-tap--hover" hover-stop-propagation="{{true}}" wx:for="{{quick}}" wx:key="v" class="mk-chip cp-q {{item.on ? 'mk-chip--on' : ''}}" data-v="{{item.v}}" bindtap="onQuick" aria-role="button">{{item.t}}</view>
      </view>
      <view class="cp-sec">
        <text class="mk-title cp-label">{{T.cap.term}}</text>
        <mk-term-seg value="{{term}}" hint="{{hint}}" bind:change="onTerm" />
      </view>
      <view wx:if="{{advise}}" class="cp-large"><text>大容量用仓，可联系专属配仓顾问</text><button class="mk-bare mk-link cp-contact" open-type="contact">立即咨询</button></view>
      <view class="cp-assist mk-row">
        <view hover-class="mk-tap--hover" hover-stop-propagation="{{true}}" class="cp-as mk-row" bindtap="onItems" aria-role="button"><image class="mk-icon" src="/assets/icons/box-ink.svg" /><text class="cp-ast">按物品估算</text></view>
        <view hover-class="mk-tap--hover" hover-stop-propagation="{{true}}" class="cp-as mk-row" bindtap="onAi" aria-role="button"><image class="mk-icon" src="/assets/icons/spark-ink.svg" /><view class="cp-ai"><text class="mk-sub">{{T.cap.ai}}</text><text class="mk-mute">{{T.cap.aiOff}}</text></view></view>
        <view hover-class="mk-tap--hover" hover-stop-propagation="{{true}}" class="cp-as mk-row" bindtap="onAdvisor" aria-role="button"><image class="mk-icon" src="/assets/icons/headset-brand.svg" /><text class="cp-ast">{{T.cap.advisor}}</text></view>
      </view>

      <view id="cp-ref" class="cp-sec">
        <view class="mk-between"><text class="mk-title">{{T.cap.ref}}</text><text wx:if="{{ref}}" class="mk-sub">{{ref.range}}</text></view>
        <view wx:if="{{ref}}" class="mk-card cp-ref">
          <text class="mk-title">{{ref.title}}</text><text class="mk-sub cp-line">{{ref.note}}</text>
          <view class="cp-things"><view wx:for="{{ref.things}}" wx:key="n" class="cp-thing"><text>{{item.n}}</text><text class="mk-sub">{{item.c}}</text></view></view>
        </view>
        <view wx:else class="cp-refbox mk-row"><image class="mk-icon" src="/assets/icons/cube-brand.svg" /><text class="mk-sub cp-ast">{{T.cap.refEmpty}}</text></view>
      </view>
    </view>
    <view class="mk-bottom-bar mk-row">
      <view class="mk-grow cp-sum">
        <view><text class="cp-sb">{{sumCap}}</text><text>{{sumTerm}}</text></view>
        <text wx:if="{{needText}}" class="{{needErr ? 'mk-error' : 'mk-mute'}}">{{needText}}</text>
      </view>
      <button class="mk-btn cp-submit {{ok ? '' : 'mk-btn--disabled'}}" hover-class="{{ok ? 'mk-btn--hover' : 'none'}}" bindtap="onSubmit">{{submitText}}</button>
    </view>
  </block>
</view>
