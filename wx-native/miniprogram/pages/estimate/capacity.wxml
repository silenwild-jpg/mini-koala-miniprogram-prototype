<view class="mk-page mk-page--plain cp-page">
  <mk-sys-state wx:if="{{sys}}" type="{{sys}}" bind:retry="onRetry" />
  <block wx:else>
    <view class="mk-sec cp-top">
      <text class="cp-title">{{T.cap.title}}</text>
      <view class="cp-row {{error ? 'cp-bad' : ''}}">
        <view hover-class="mk-tap--hover mk-press--stepHover" hover-stop-propagation="{{true}}" class="cp-step mk-press {{canMinus ? '' : 'cp-off'}}" data-dir="minus" bindtap="onStep" aria-role="button" aria-label="减少"><image class="mk-icon mk-icon--md" src="/assets/icons/{{canMinus ? 'minus-brand' : 'minus-mute'}}.svg" /></view>
        <view class="cp-val {{capBump}}">
          <input class="cp-input mk-num" style="width: {{numW}}rpx" type="digit" maxlength="-1" placeholder="{{unit === 'm3' ? T.cap.placeholderM3 : T.cap.placeholderM2}}" placeholder-class="cp-ph" value="{{raw}}" bindinput="onInput" bindblur="onBlur" />
          <text class="cp-unit">{{unit === 'm3' ? T.m3 : T.m2}}</text>
        </view>
        <view hover-class="mk-tap--hover mk-press--stepHover" hover-stop-propagation="{{true}}" class="cp-step mk-press" data-dir="plus" bindtap="onStep" aria-role="button" aria-label="增加"><image class="mk-icon mk-icon--md" src="/assets/icons/plus-brand.svg" /></view>
      </view>
      <view class="cp-units">
        <view hover-class="mk-tap--hover" hover-stop-propagation="{{true}}" class="cp-u mk-ease {{unit === 'm3' ? 'cp-on' : ''}}" data-u="m3" bindtap="onUnit" aria-role="button">{{T.m3}}</view>
        <view hover-class="mk-tap--hover" hover-stop-propagation="{{true}}" class="cp-u mk-ease {{unit === 'm2' ? 'cp-on' : ''}}" data-u="m2" bindtap="onUnit" aria-role="button">{{T.m2}}</view>
      </view>
      <text wx:if="{{approx}}" class="mk-t-caption cp-line">{{approx}}</text>
      <text wx:if="{{error}}" class="mk-error cp-line">{{error}}</text>

      <view class="cp-slider">
        <view id="cp-track" class="cp-track" bindtouchstart="onSlideStart" catchtouchmove="onSlideMove" bindtouchend="onSlideEnd" bindtouchcancel="onSlideEnd" aria-role="slider" aria-label="拖动选择容量">
          <view class="cp-rail">
            <view class="cp-fill {{sliding ? '' : 'mk-ease'}}" style="transform: scaleX({{pos}})"></view>
            <view wx:for="{{quick}}" wx:key="v" class="cp-dot {{item.left <= pos * 100 ? 'cp-dot--in' : ''}}" style="left: {{item.left}}%"></view>
          </view>
          <view class="cp-runner {{sliding ? '' : 'mk-ease'}}" style="transform: translateX({{pos * 100}}%)"><view class="cp-thumb {{sliding ? 'cp-thumb--on' : ''}}"><view class="cp-grip"></view><view class="cp-grip"></view><view class="cp-grip"></view></view></view>
        </view>
        <view class="cp-ticks">
          <view hover-class="mk-tap--hover" hover-stop-propagation="{{true}}" wx:for="{{quick}}" wx:key="v" class="cp-tick {{item.on ? 'cp-tick--on' : ''}}" style="left: {{item.left}}%" data-v="{{item.v}}" bindtap="onQuick" aria-role="button">
            <text class="cp-tv mk-num">{{item.t}}</text><text class="cp-ts">{{item.sub}}</text>
          </view>
        </view>
      </view>

      <view id="cp-ref" class="cp-ref">
        <view class="cp-stage" aria-role="img" aria-label="{{T.cap.ref}}">
          <view class="cp-depot mk-ease {{stage.on ? '' : 'cp-depot--off'}}" style="transform: scale({{stage.s}})">
            <image wx:for="{{stage.imgs}}" wx:key="key" class="cp-dimg mk-ease {{item.on ? 'cp-dimg--on' : ''}}" src="{{item.src}}" mode="aspectFit" />
          </view>
          <image wx:for="{{fly}}" wx:key="k" class="cp-fly cp-fly--l{{item.lane}} cp-fly--d{{item.d}} {{item.out ? 'cp-fly--out' : ''}}" src="/assets/icons/cube-brand.svg" />
        </view>
        <view wx:if="{{ref}}" class="cp-rb">
          <text class="mk-t-hint">{{ref.range}}</text>
          <text class="mk-t-title cp-rt">{{ref.title}}</text>
          <text class="mk-t-hint">{{ref.note}}</text>
          <view class="cp-things"><view wx:for="{{ref.things}}" wx:key="n" class="cp-thing"><text class="cp-tn">{{item.n}}</text><text class="cp-tc mk-num">{{item.c}}</text></view></view>
        </view>
        <view wx:else class="cp-rb cp-rb--empty"><text class="mk-t-title cp-rt">{{T.cap.ref}}</text><text class="mk-t-caption">{{T.cap.refEmpty}}</text></view>
      </view>
    </view>

    <view class="mk-sec">
      <view class="mk-sec__hd">{{T.cap.term}}</view>
      <mk-term-seg value="{{term}}" hint="{{hint}}" bind:change="onTerm" />
    </view>

    <view class="mk-sec">
      <view class="mk-sec__hd">{{T.cap.unsure}}</view>
      <view wx:if="{{advise}}" class="cp-large"><text class="mk-grow">{{T.cap.large}}</text><button class="mk-bare mk-link cp-contact" hover-class="mk-bare--hover" open-type="contact">{{T.cap.contact}}</button></view>
      <view class="cp-assist">
        <view hover-class="mk-tap--hover mk-press--hover" hover-stop-propagation="{{true}}" class="cp-as mk-press" bindtap="onItems" aria-role="button"><image class="mk-icon mk-icon--md" src="/assets/icons/box-ink.svg" /><text class="cp-ast">{{T.cap.byItemsBtn}}</text></view>
        <view hover-class="mk-tap--hover mk-press--hover" hover-stop-propagation="{{true}}" class="cp-as mk-press" bindtap="onAdvisor" aria-role="button"><image class="mk-icon mk-icon--md" src="/assets/icons/headset-ink.svg" /><text class="cp-ast">{{T.cap.advisor}}</text></view>
        <view hover-class="mk-tap--hover mk-press--hover" hover-stop-propagation="{{true}}" wx:if="{{ai}}" class="cp-as mk-press" bindtap="onAi" aria-role="button"><image class="mk-icon mk-icon--md" src="/assets/icons/spark-ink.svg" /><view class="cp-ai"><text class="cp-ast">{{T.cap.ai}}</text><text class="mk-t-hint cp-ast">{{T.cap.aiOff}}</text></view></view>
      </view>
    </view>

    <view class="mk-bottom-bar mk-row">
      <view class="mk-grow cp-sum">
        <view><text class="cp-sb mk-num {{sumBump}}">{{sumCap}}</text><text>{{sumTerm}}</text></view>
        <text wx:if="{{needText}}" class="{{needErr ? 'mk-error' : 'mk-mute'}}">{{needText}}</text>
      </view>
      <button class="mk-btn cp-submit {{ok ? '' : 'mk-btn--disabled'}}" hover-class="{{ok ? 'mk-btn--hover' : 'none'}}" bindtap="onSubmit">{{submitText}}</button>
    </view>
  </block>
</view>
