/* 填容量（IMPL-01）：白底小节，不用描边卡。上段 = 数值 + 单位 + 滑杆 + 仓库示意；下面依次是租期、拿不准时的出路。 */
.cp-page { padding-bottom: calc(220rpx + env(safe-area-inset-bottom)); }
.cp-top { padding-top: var(--mk-space-4); }
.cp-title { display: block; font-size: var(--mk-font-size-2xl); font-weight: var(--mk-font-weight-semibold); line-height: var(--mk-font-lineHeight-tight); }
/* 数值行：圆形加减 + 大数字 + 单位 */
.cp-row { display: flex; align-items: center; justify-content: center; margin-top: var(--mk-space-4); }
.cp-step { width: 96rpx; height: 96rpx; border-radius: var(--mk-radius-pill); background: var(--mk-color-canvas-sunken); display: flex; align-items: center; justify-content: center; flex: none; }
.cp-step.cp-off { opacity: var(--mk-opacity-disabled); }
.cp-val { display: flex; align-items: baseline; justify-content: center; width: 400rpx; margin: 0 var(--mk-space-2); border-bottom: 1px solid transparent; box-sizing: border-box; }
.cp-bad .cp-val { border-bottom: var(--mk-border-error); }
.cp-input { width: 150rpx; height: 112rpx; text-align: center; font-size: 72rpx; font-weight: var(--mk-font-weight-bold); color: var(--mk-color-ink-primary); }
.cp-ph { color: var(--mk-color-ink-tertiary); font-weight: var(--mk-font-weight-regular); font-size: var(--mk-font-size-2xl); }
.cp-unit { margin-left: 4rpx; font-size: var(--mk-font-size-lg); font-weight: var(--mk-font-weight-medium); color: var(--mk-color-ink-secondary); }
.cp-units { display: flex; width: 240rpx; margin: var(--mk-space-2) auto 0; padding: 4rpx; border-radius: var(--mk-radius-pill); background: var(--mk-color-canvas-sunken); box-sizing: border-box; }
.cp-u { flex: 1; height: 56rpx; display: flex; align-items: center; justify-content: center; border-radius: var(--mk-radius-pill); font-size: var(--mk-font-size-sm); color: var(--mk-color-ink-secondary); }
.cp-u.cp-on { background: var(--mk-color-action-primaryFill); color: var(--mk-color-ink-inverse); font-weight: var(--mk-font-weight-semibold); }
.cp-line { display: block; margin-top: var(--mk-space-2); text-align: center; }
/* 滑杆：轨道 + 刻度点 + 带防滑纹的滑块；下面一排刻度可点，写数值与仓型 */
.cp-slider { margin-top: var(--mk-space-4); padding: 0 var(--mk-space-6); }
.cp-track { position: relative; height: 88rpx; }
.cp-rail { position: absolute; left: 0; right: 0; top: 50%; height: 12rpx; margin-top: -6rpx; border-radius: var(--mk-radius-pill); background: var(--mk-color-line-hairline); }
.cp-fill { position: absolute; left: 0; top: 0; width: 100%; height: 100%; border-radius: var(--mk-radius-pill); background: var(--mk-color-brand-fill); transform-origin: left center; }
.cp-dot { position: absolute; top: 50%; width: 8rpx; height: 8rpx; margin: -4rpx 0 0 -4rpx; border-radius: var(--mk-radius-pill); background: var(--mk-color-ink-tertiary); }
.cp-dot--in { background: var(--mk-color-canvas-card); }
.cp-runner { position: absolute; left: 0; right: 0; top: 0; bottom: 0; pointer-events: none; }
.cp-thumb { position: absolute; left: 0; top: 50%; width: 64rpx; height: 64rpx; margin: -32rpx 0 0 -32rpx; border-radius: var(--mk-radius-pill); background: var(--mk-color-canvas-card); border: 4rpx solid var(--mk-color-brand-fill); box-shadow: var(--mk-elevation-float); box-sizing: border-box; display: flex; align-items: center; justify-content: center; transition: transform var(--mk-motion-fast) var(--mk-motion-easing); }
.cp-thumb--on { transform: scale(1.12); }
.cp-grip { width: 4rpx; height: 20rpx; margin: 0 3rpx; border-radius: var(--mk-radius-pill); background: var(--mk-color-brand-fill); }
.cp-ticks { position: relative; height: 84rpx; }
.cp-tick { position: absolute; top: 0; width: 104rpx; margin-left: -52rpx; padding: 4rpx 0; display: flex; flex-direction: column; align-items: center; border-radius: var(--mk-radius-control); }
.cp-tv { font-size: var(--mk-font-size-sm); color: var(--mk-color-ink-secondary); line-height: var(--mk-font-lineHeight-tight); }
.cp-ts { margin-top: 4rpx; font-size: var(--mk-font-size-xs); color: var(--mk-color-ink-hint); line-height: var(--mk-font-lineHeight-tight); white-space: nowrap; }
.cp-tick--on .cp-tv { color: var(--mk-color-brand-text); font-weight: var(--mk-font-weight-semibold); }
.cp-tick--on .cp-ts { color: var(--mk-color-brand-text); }
/* 尺寸示意区：左图右文，不描边。图随容量缩放（transform-origin 在底边中点）；箱子叠在底图与仓门框之间，落到位后留下 */
.cp-ref { display: flex; align-items: center; margin-top: var(--mk-space-1); }
.cp-stage { position: relative; width: 320rpx; height: 320rpx; flex: none; overflow: hidden; }
.cp-depot { position: absolute; left: 0; top: 0; width: 100%; height: 100%; transform-origin: 50% 100%; }
.cp-depot--off { opacity: 0.35; }
.cp-dimg { position: absolute; left: 0; top: 0; width: 100%; height: 100%; opacity: 0; }
.cp-dimg--on { opacity: 1; }
@keyframes cp-kf-box-in { 0% { opacity: 0; transform: translateY(-120rpx); } 30% { opacity: 1; } 100% { opacity: 1; transform: translateY(0); } }
@keyframes cp-kf-box-out { 0% { opacity: 1; transform: translateY(0); } 100% { opacity: 0; transform: translateY(-120rpx); } }
.cp-box { position: absolute; }
.cp-box--in { animation: cp-kf-box-in 300ms var(--mk-motion-easing) both; }
.cp-box--out { animation: cp-kf-box-out 300ms var(--mk-motion-easing) both; }
.cp-box--d1 { animation-delay: 60ms; }
.cp-box--d2 { animation-delay: 120ms; }
.cp-rb { flex: 1; min-width: 0; margin-left: var(--mk-space-1); display: flex; flex-direction: column; }
.cp-rt { margin: 4rpx 0; }
.cp-things { display: flex; flex-wrap: wrap; margin-top: var(--mk-space-1); }
.cp-thing { width: 100%; margin-top: var(--mk-space-1); display: flex; align-items: baseline; white-space: nowrap; }
.cp-tn { font-size: var(--mk-font-size-sm); color: var(--mk-color-ink-secondary); }
.cp-tc { margin-left: var(--mk-space-1); font-size: var(--mk-font-size-sm); font-weight: var(--mk-font-weight-semibold); }
/* 拿不准时的出路：两块浅灰底的入口，不描边 */
.cp-large { display: flex; align-items: center; margin-bottom: var(--mk-space-3); padding: var(--mk-space-2) var(--mk-space-3); border-radius: var(--mk-radius-thumb); background: var(--mk-color-canvas-sunken); color: var(--mk-color-ink-secondary); font-size: var(--mk-font-size-sm); }
.mk-bare.mk-bare.cp-contact { flex: none; margin: 0 0 0 var(--mk-space-2); padding: var(--mk-space-1) 0; background: transparent; font-size: inherit; line-height: 1.5; }
.cp-contact::after { border: 0; }
.cp-assist { display: flex; flex-wrap: wrap; margin: 0 calc(var(--mk-space-1) * -1); }
.cp-as { flex: 1; min-width: 40%; height: 96rpx; margin: 0 var(--mk-space-1) var(--mk-space-2); display: flex; align-items: center; justify-content: center; border-radius: var(--mk-radius-thumb); background: var(--mk-color-canvas-sunken); box-sizing: border-box; }
.cp-ast { margin-left: var(--mk-space-2); font-size: var(--mk-font-size-md); }
.cp-ai { display: flex; flex-direction: column; }
.cp-sum { display: flex; flex-direction: column; }
.cp-sb { font-weight: var(--mk-font-weight-semibold); }
.mk-btn.mk-btn.cp-submit { min-width: 280rpx; margin-left: var(--mk-space-3); }
