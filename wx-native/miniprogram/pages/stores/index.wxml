<view class="mk-page sl-page">
  <view class="sl-head">
    <view class="mk-row mk-gutter sl-top">
      <view hover-class="mk-tap--hover" hover-stop-propagation="{{true}}" class="mk-row sl-city" bindtap="onCity" aria-role="button" aria-label="用仓位置"><text class="sl-cn mk-ellipsis">{{cityText}}</text><view wx:if="{{!located}}" class="sl-dot"></view><image class="mk-icon" src="/assets/icons/down-ink.svg" /></view>
      <view hover-class="mk-tap--hover" hover-stop-propagation="{{true}}" class="mk-row mk-grow sl-search" bindtap="onSearch" aria-role="button" aria-label="搜索"><image class="mk-icon" src="/assets/icons/search-sub.svg" /><text class="mk-ellipsis sl-sph">{{T.search}}</text></view>
    </view>
    <view wx:if="{{nocity}}" class="sl-bubble mk-row mk-fade {{nocityLeave}}">
      <text class="mk-grow">{{nocity}}</text><text class="mk-link sl-act" bindtap="onSwitchCity" aria-role="button">{{T.switchCity}}</text>
      <view hover-class="mk-tap--hover" hover-stop-propagation="{{true}}" class="sl-x" bindtap="onCloseNocity" aria-role="button" aria-label="关闭"><image class="mk-icon" src="/assets/icons/close-sub.svg" /></view>
    </view>
    <view wx:elif="{{bubble}}" class="sl-bubble mk-row mk-fade {{bubbleLeave}}">
      <text class="mk-grow">{{bubble.text}}</text><text class="mk-link sl-act" bindtap="onBubbleAction" aria-role="button">{{bubble.action}}</text>
      <view hover-class="mk-tap--hover" hover-stop-propagation="{{true}}" class="sl-x" bindtap="hideBubble" aria-role="button" aria-label="关闭"><image class="mk-icon" src="/assets/icons/close-sub.svg" /></view>
    </view>
    <view wx:if="{{mode !== 'sales'}}" class="sl-fwrap">
      <view class="sl-fbar">
        <view hover-class="mk-tap--hover" hover-stop-propagation="{{true}}" class="sl-f mk-ease {{sort !== 'recommended' || (sheet === 'sort' && !sheetLeave) ? 'sl-f--on' : ''}}" data-k="sort" bindtap="onSheet" aria-role="button" aria-expanded="{{(sheet === 'sort' && !sheetLeave)}}"><text>{{sortLabel}}</text><image class="mk-icon sl-fic mk-rot {{(sheet === 'sort' && !sheetLeave) ? 'mk-rot--on' : ''}}" src="/assets/icons/{{sort !== 'recommended' || (sheet === 'sort' && !sheetLeave) ? 'down-brand' : 'down-ink'}}.svg" /></view>
        <view hover-class="mk-tap--hover" hover-stop-propagation="{{true}}" class="sl-f mk-ease {{maxKm !== null || (sheet === 'distance' && !sheetLeave) ? 'sl-f--on' : ''}}" data-k="distance" bindtap="onSheet" aria-role="button" aria-expanded="{{(sheet === 'distance' && !sheetLeave)}}"><text>{{distLabel}}</text><image class="mk-icon sl-fic mk-rot {{(sheet === 'distance' && !sheetLeave) ? 'mk-rot--on' : ''}}" src="/assets/icons/{{maxKm !== null || (sheet === 'distance' && !sheetLeave) ? 'down-brand' : 'down-ink'}}.svg" /></view>
        <view hover-class="mk-tap--hover" hover-stop-propagation="{{true}}" class="sl-f mk-ease {{svcOn || (sheet === 'services' && !sheetLeave) ? 'sl-f--on' : ''}}" data-k="services" bindtap="onSheet" aria-role="button" aria-expanded="{{(sheet === 'services' && !sheetLeave)}}"><text>{{svcLabel}}</text><text wx:if="{{svcN}}" class="mk-num sl-fn">{{svcN}}</text><image class="mk-icon sl-fic mk-rot {{(sheet === 'services' && !sheetLeave) ? 'mk-rot--on' : ''}}" src="/assets/icons/{{svcOn || (sheet === 'services' && !sheetLeave) ? 'down-brand' : 'down-ink'}}.svg" /></view>
      </view>
      <!-- 原位下拉：贴在筛选条正下方，盖住需求条与列表顶部 -->
      <view wx:if="{{sheet}}" class="sl-drop mk-drop-in {{sheetLeave ? 'mk-leave mk-leave--up' : ''}}" catchtouchmove="noop">
        <block wx:if="{{sheet === 'sort'}}">
          <view hover-class="mk-tap--hover" hover-stop-propagation="{{true}}" wx:for="{{sortOptions}}" wx:key="v" class="sl-opt mk-between mk-ease {{item.on ? 'sl-opt--on' : ''}}" data-v="{{item.v}}" bindtap="onOption" aria-role="button"><text>{{item.t}}</text><image wx:if="{{item.on}}" class="mk-icon" src="/assets/icons/check-brand.svg" /></view>
        </block>
        <block wx:elif="{{sheet === 'distance'}}">
          <view hover-class="mk-tap--hover" hover-stop-propagation="{{true}}" wx:for="{{distOptions}}" wx:key="v" class="sl-opt mk-between mk-ease {{item.on ? 'sl-opt--on' : ''}}" data-v="{{item.v}}" bindtap="onOption" aria-role="button"><text>{{item.t}}</text><image wx:if="{{item.on}}" class="mk-icon" src="/assets/icons/check-brand.svg" /></view>
        </block>
        <block wx:else>
          <text class="mk-sub sl-gt">{{T.stores.groupOffer}}</text>
          <view class="sl-svc"><view hover-class="mk-tap--hover" hover-stop-propagation="{{true}}" wx:for="{{offerOptions}}" wx:key="k" class="mk-chip sl-chip sl-sv mk-ease {{item.on ? 'mk-chip--on' : ''}}" data-k="{{item.k}}" bindtap="onOfferOption" aria-role="button">{{item.t}}</view></view>
          <block wx:if="{{svcOptions.length}}">
            <text class="mk-sub sl-gt">{{T.stores.groupService}}</text>
            <view class="sl-svc"><view hover-class="mk-tap--hover" hover-stop-propagation="{{true}}" wx:for="{{svcOptions}}" wx:key="t" class="mk-chip sl-chip sl-sv mk-ease {{item.on ? 'mk-chip--on' : ''}}" data-t="{{item.t}}" bindtap="onSvcOption" aria-role="button">{{item.t}}</view></view>
          </block>
          <view class="sl-acts"><button class="mk-btn mk-btn--ghost mk-btn--md sl-btn" hover-class="mk-btn--ghostHover" bindtap="onSvcClear">{{T.stores.reset}}</button><button class="mk-btn mk-btn--md sl-btn" hover-class="mk-btn--hover" bindtap="onSheetConfirm">{{T.stores.confirm}}</button></view>
        </block>
      </view>
    </view>
    <!-- 需求条：浅绿底的一条，不再用上下两条线夹着 -->
    <view class="mk-gutter sl-dwrap">
      <view class="mk-between sl-demand">
        <image class="mk-icon sl-dic" src="/assets/icons/cube-brand.svg" />
        <text wx:if="{{demandText}}" class="mk-grow mk-ellipsis st-demand-value {{needBump}}">{{T.stores.demandPrefix}}{{demandText}}</text>
        <text wx:else class="mk-grow mk-ellipsis">{{T.stores.unsure}}</text>
        <text wx:if="{{demandText}}" class="mk-link sl-mod" bindtap="onModify" aria-role="button">{{T.stores.modify}}</text>
        <text wx:else class="mk-link sl-mod" bindtap="onEstimate" aria-role="button">{{T.stores.estimateNow}}</text>
      </view>
    </view>
  </view>

  <view wx:if="{{sheet}}" class="sl-mask mk-scrim-in {{sheetLeave}}" bindtap="onSheetClose" catchtouchmove="noop"></view>
  <view wx:if="{{sys}}" class="mk-gutter"><mk-sys-state type="{{sys}}" skeleton="{{3}}" bind:retry="onRetry" /></view>
  <view wx:else class="mk-gutter sl-list">
    <block wx:if="{{mode === 'sales'}}">
      <mk-empty card="{{true}}" icon="/assets/icons/headset-brand.svg" title="{{T.stores.salesTitle}}" sub="{{T.salesSub}}">
        <button class="mk-btn mk-btn--ghost mk-btn--md mk-empty-btn" hover-class="mk-btn--ghostHover" bindtap="onModify">{{T.stores.modifyNeed}}</button>
        <button class="mk-btn mk-btn--md mk-empty-btn" hover-class="mk-btn--hover" bindtap="onAdvisorLead">{{T.stores.salesCta}}</button>
        <text class="mk-mute sl-hours">{{T.hours}}</text>
      </mk-empty>
      <mk-estore-card variant="list" />
    </block>
    <block wx:else>
      <mk-notice wx:if="{{far}}" plain="{{true}}" tone="warn" title="{{farTitle}}" text="{{farSub}}" />
      <text wx:elif="{{resultText}}" class="mk-sub sl-result">{{resultText}}</text>
      <mk-notice wx:if="{{largeNote}}" plain="{{true}}" title="{{T.stores.largeTitle}}" text="{{T.stores.largeSub}}"><button class="mk-bare mk-link sl-consult" hover-class="mk-bare--hover" open-type="contact">{{T.stores.consult}}</button></mk-notice>
      <block wx:if="{{noMatch}}">
        <mk-empty card="{{true}}" icon="/assets/icons/cube-brand.svg" title="{{T.stores.emptyTitle}}" sub="{{T.stores.emptySub}}">
          <button wx:if="{{filtered}}" class="mk-btn mk-btn--ghost mk-btn--md mk-empty-btn" hover-class="mk-btn--ghostHover" bindtap="onClearFilters">{{T.stores.clearFilters}}</button>
          <button wx:else class="mk-btn mk-btn--ghost mk-btn--md mk-empty-btn" hover-class="mk-btn--ghostHover" bindtap="onModify">{{T.stores.modifyNeed}}</button>
          <button class="mk-btn mk-btn--md mk-empty-btn" hover-class="mk-btn--hover" open-type="contact">{{T.stores.consult}}</button>
        </mk-empty>
        <mk-estore-card variant="list" />
        <text wx:if="{{total > 0}}" class="mk-title sl-bh">{{T.stores.nearbyTitle}}</text>
      </block>
      <block wx:for="{{items}}" wx:key="key">
        <mk-estore-card wx:if="{{item.type === 'estore'}}" variant="list" />
        <block wx:else>
          <text wx:if="{{item.hd}}" class="mk-sub sl-sh">{{item.hd}}</text>
          <mk-store-card card="{{item.card}}" variant="{{item.variant}}" enter="{{index < 4 ? index : -1}}" bump="{{priceBump}}" bind:store="onStore" bind:action="onAction" />
        </block>
      </block>
      <block wx:if="{{far}}">
        <mk-estore-card variant="far" />
        <mk-advisor-card title="{{T.leave.title}}" sub="{{T.leave.sub}}" />
      </block>
      <view wx:if="{{hasMore || far}}" class="sl-more">
        <button class="mk-btn mk-btn--ghost mk-btn--md sl-mb" hover-class="mk-btn--ghostHover" bindtap="onMore">{{far ? T.stores.allStores : T.stores.more}}</button>
      </view>
      <mk-advisor-card wx:if="{{advisor}}" title="{{advisor.title}}" sub="{{advisor.sub}}" />
    </block>
  </view>

  <mk-demand-sheet visible="{{demandSheet}}" bind:close="onDemandClose" bind:change="onDemandChange" bind:sales="onDemandSales" />
  <mk-login-sheet visible="{{loginVisible}}" bind:close="onLoginClose" bind:success="onLoginSuccess" />
  <mk-location-panel visible="{{panel}}" note="{{panelNote}}" focus="{{panelFocus}}" bind:close="onPanelClose" bind:change="onLocationChange" />
</view>
