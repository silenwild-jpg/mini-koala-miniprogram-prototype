<view class="mk-page sl-page">
  <view class="sl-head">
    <view class="mk-row mk-gutter sl-top">
      <view hover-class="mk-tap--hover" hover-stop-propagation="{{true}}" class="mk-row sl-city" bindtap="onCity" aria-role="button" aria-label="用仓位置"><text class="sl-cn mk-ellipsis">{{cityText}}</text><view wx:if="{{!located}}" class="sl-dot"></view><image class="mk-icon" src="/assets/icons/down-ink.svg" /></view>
      <view hover-class="mk-tap--hover" hover-stop-propagation="{{true}}" class="mk-row mk-grow sl-search" bindtap="onSearch" aria-role="button" aria-label="搜索"><image class="mk-icon" src="/assets/icons/search-sub.svg" /><text class="mk-ellipsis sl-sph">{{T.search}}</text></view>
    </view>
    <view wx:if="{{nocity}}" class="sl-bubble mk-row">
      <text class="mk-grow">{{nocity}}</text><text class="mk-link sl-act" bindtap="onSwitchCity" aria-role="button">{{T.switchCity}}</text>
      <view hover-class="mk-tap--hover" hover-stop-propagation="{{true}}" class="sl-x" bindtap="onCloseNocity" aria-role="button" aria-label="关闭"><image class="mk-icon" src="/assets/icons/close-sub.svg" /></view>
    </view>
    <view wx:elif="{{bubble}}" class="sl-bubble mk-row">
      <text class="mk-grow">{{bubble.text}}</text><text class="mk-link sl-act" bindtap="onBubbleAction" aria-role="button">{{bubble.action}}</text>
      <view hover-class="mk-tap--hover" hover-stop-propagation="{{true}}" class="sl-x" bindtap="hideBubble" aria-role="button" aria-label="关闭"><image class="mk-icon" src="/assets/icons/close-sub.svg" /></view>
    </view>
    <block wx:if="{{mode !== 'sales'}}">
      <view class="sl-fbar">
        <view hover-class="mk-tap--hover" hover-stop-propagation="{{true}}" class="sl-f {{sort !== 'recommended' ? 'sl-f--on' : ''}}" data-k="sort" bindtap="onSheet" aria-role="button"><text>{{sortLabel}}</text><image class="mk-icon" src="/assets/icons/down-ink.svg" /></view>
        <view hover-class="mk-tap--hover" hover-stop-propagation="{{true}}" class="sl-f {{maxKm !== null ? 'sl-f--on' : ''}}" data-k="distance" bindtap="onSheet" aria-role="button"><text>{{distLabel}}</text><image class="mk-icon" src="/assets/icons/down-ink.svg" /></view>
        <view hover-class="mk-tap--hover" hover-stop-propagation="{{true}}" class="sl-f {{services.length ? 'sl-f--on' : ''}}" data-k="services" bindtap="onSheet" aria-role="button"><text>{{svcLabel}}</text><image class="mk-icon" src="/assets/icons/down-ink.svg" /></view>
      </view>
      <view class="mk-gutter sl-chips">
        <view hover-class="mk-tap--hover" hover-stop-propagation="{{true}}" class="mk-chip sl-chip {{promo ? 'mk-chip--on' : ''}}" bindtap="onFilterPromo" aria-role="button">{{T.stores.promo}}</view>
        <view hover-class="mk-tap--hover" hover-stop-propagation="{{true}}" class="mk-chip sl-chip {{freeTransport ? 'mk-chip--on' : ''}}" bindtap="onFilterFree" aria-role="button">{{T.stores.freeTransport}}</view>
      </view>
    </block>
    <view class="mk-between mk-gutter sl-demand">
      <view class="sl-dmark"></view>
      <text wx:if="{{demandText}}" class="mk-grow mk-ellipsis st-demand-value">{{T.stores.demandPrefix}}{{demandText}}</text>
      <text wx:else class="mk-grow">{{T.stores.unsure}}</text>
      <text wx:if="{{demandText}}" class="mk-link sl-mod" bindtap="onModify" aria-role="button">{{T.stores.modify}}</text>
      <text wx:else class="mk-link sl-mod" bindtap="onEstimate" aria-role="button">{{T.stores.estimateNow}}</text>
    </view>
  </view>

  <view wx:if="{{sys}}" class="mk-gutter"><mk-sys-state type="{{sys}}" skeleton="{{3}}" bind:retry="onRetry" /></view>
  <view wx:else class="mk-gutter sl-list">
    <block wx:if="{{mode === 'sales'}}">
      <mk-empty card="{{true}}" icon="/assets/icons/headset-brand.svg" title="{{T.stores.salesTitle}}" sub="{{T.salesSub}}">
        <button class="mk-btn mk-btn--ghost mk-btn--md mk-empty-btn" hover-class="mk-btn--ghostHover" bindtap="onModify">{{T.stores.modify}}</button>
        <button class="mk-btn mk-btn--md mk-empty-btn" hover-class="mk-btn--hover" bindtap="onAdvisorLead">{{T.stores.salesCta}}</button>
        <text class="mk-mute sl-hours">{{T.hours}}</text>
      </mk-empty>
      <mk-estore-card variant="list" />
    </block>
    <block wx:else>
      <mk-notice wx:if="{{far}}" plain="{{true}}" tone="warn" title="{{farTitle}}" text="{{farSub}}" />
      <text wx:elif="{{resultText}}" class="mk-mute sl-result">{{resultText}}</text>
      <block wx:if="{{noMatch}}">
        <mk-empty card="{{true}}" icon="/assets/icons/cube-brand.svg" title="{{T.stores.emptyTitle}}" sub="{{T.stores.emptySub}}">
          <button wx:if="{{filtered}}" class="mk-btn mk-btn--ghost mk-btn--md mk-empty-btn" hover-class="mk-btn--ghostHover" bindtap="onClearFilters">{{T.stores.clearFilters}}</button>
          <button wx:else class="mk-btn mk-btn--ghost mk-btn--md mk-empty-btn" hover-class="mk-btn--ghostHover" bindtap="onModify">{{T.stores.modify}}</button>
          <button class="mk-btn mk-btn--md mk-empty-btn" hover-class="mk-btn--hover" bindtap="onAdvisorLead">{{T.stores.helpFind}}</button>
        </mk-empty>
        <mk-estore-card variant="list" />
        <text wx:if="{{total > 0}}" class="mk-title sl-bh">{{T.stores.nearbyTitle}}</text>
      </block>
      <block wx:for="{{items}}" wx:key="key">
        <mk-estore-card wx:if="{{item.type === 'estore'}}" variant="list" />
        <mk-store-card wx:else card="{{item.card}}" variant="{{item.variant}}" bind:store="onStore" bind:action="onAction" />
      </block>
      <block wx:if="{{far}}">
        <mk-estore-card variant="far" />
        <mk-advisor-card title="{{T.leave.title}}" sub="{{T.leave.sub}}" />
      </block>
      <view wx:if="{{hasMore || far}}" class="sl-more">
        <button class="mk-btn mk-btn--ghost mk-btn--md sl-mb" hover-class="mk-btn--ghostHover" bindtap="onMore">{{far ? T.stores.allStores : T.stores.more}}</button>
      </view>
      <mk-advisor-card wx:if="{{advisor}}" title="{{advisor.title}}" sub="{{advisor.sub}}" />
    </block>
  </view>

  <mk-sheet visible="{{sheet === 'sort'}}" title="{{T.stores.sort}}" bind:close="onSheetClose">
    <view hover-class="mk-tap--hover" hover-stop-propagation="{{true}}" wx:for="{{sortOptions}}" wx:key="v" class="sl-opt mk-between {{item.on ? 'sl-opt--on' : ''}}" data-v="{{item.v}}" bindtap="onOption" aria-role="button"><text>{{item.t}}</text><image wx:if="{{item.on}}" class="mk-icon" src="/assets/icons/check-brand.svg" /></view>
    <view class="sl-acts"><button class="mk-btn mk-btn--ghost sl-btn" hover-class="mk-btn--ghostHover" bindtap="onSheetClose">{{T.stores.cancel}}</button><button class="mk-btn sl-btn" hover-class="mk-btn--hover" bindtap="onSheetConfirm">{{T.stores.confirm}}</button></view>
  </mk-sheet>
  <mk-sheet visible="{{sheet === 'distance'}}" title="{{T.stores.distance}}" bind:close="onSheetClose">
    <view hover-class="mk-tap--hover" hover-stop-propagation="{{true}}" wx:for="{{distOptions}}" wx:key="v" class="sl-opt mk-between {{item.on ? 'sl-opt--on' : ''}}" data-v="{{item.v}}" bindtap="onOption" aria-role="button"><text>{{item.t}}</text><image wx:if="{{item.on}}" class="mk-icon" src="/assets/icons/check-brand.svg" /></view>
    <view class="sl-acts"><button class="mk-btn mk-btn--ghost sl-btn" hover-class="mk-btn--ghostHover" bindtap="onSheetClose">{{T.stores.cancel}}</button><button class="mk-btn sl-btn" hover-class="mk-btn--hover" bindtap="onSheetConfirm">{{T.stores.confirm}}</button></view>
  </mk-sheet>
  <mk-sheet visible="{{sheet === 'services'}}" title="{{T.stores.services}}" bind:close="onSheetClose">
    <view class="sl-svc"><view hover-class="mk-tap--hover" hover-stop-propagation="{{true}}" wx:for="{{svcOptions}}" wx:key="t" class="mk-chip sl-chip sl-sv {{item.on ? 'mk-chip--on' : ''}}" data-t="{{item.t}}" bindtap="onSvcOption" aria-role="button">{{item.t}}</view></view>
    <view class="sl-acts"><button class="mk-btn mk-btn--ghost sl-btn" hover-class="mk-btn--ghostHover" bindtap="onSvcClear">{{T.stores.clearServices}}</button><button class="mk-btn sl-btn" hover-class="mk-btn--hover" bindtap="onSheetConfirm">{{T.stores.confirm}}</button></view>
  </mk-sheet>
  <mk-demand-sheet visible="{{demandSheet}}" bind:close="onDemandClose" bind:change="onDemandChange" bind:sales="onDemandSales" />
  <mk-login-sheet visible="{{loginVisible}}" bind:close="onLoginClose" bind:success="onLoginSuccess" />
  <mk-location-panel visible="{{panel}}" note="{{panelNote}}" focus="{{panelFocus}}" bind:close="onPanelClose" bind:change="onLocationChange" />
</view>
