<view class="mk-page mt-page">
  <view class="mt-top">
    <view class="mk-gutter mt-need">
      <view class="mk-between">
        <view class="mk-row mt-sum">
          <text>约 </text><text class="mk-num mt-big">{{capNum}}</text><text class="mt-u">{{capUnit}}</text><text wx:if="{{capApprox}}" class="mk-sub mt-approx">{{capApprox}}</text>
          <view class="mt-sep"></view>
          <text>租 </text><text class="mk-num mt-big">{{term}}</text><text class="mt-u">{{T.month}}</text>
        </view>
        <view hover-class="mk-tap--hover" hover-stop-propagation="{{true}}" class="mk-link mt-mod" bindtap="onModify" aria-role="button">{{T.m.modify}} ›</view>
      </view>
    </view>
    <view hover-class="mk-tap--hover" hover-stop-propagation="{{true}}" class="mk-between mk-gutter mt-loc" bindtap="onLocation" aria-role="button">
      <view class="mk-row mk-grow"><image class="mk-icon" src="/assets/icons/pin-brand.svg" /><text class="mk-sub mt-lk">{{T.m.origin}}</text><text class="mk-ellipsis mk-grow">{{locText}}</text></view>
      <image class="mk-icon" src="/assets/icons/chev-mute.svg" />
    </view>
  </view>
  <view class="mk-band"></view>

  <view wx:if="{{sys === 'loading'}}" class="mk-gutter mt-body">
    <view class="mt-hd"><text class="mk-h2">{{T.m.recommending}}</text><text class="mk-sub">{{T.m.matching}}</text></view>
    <mk-sys-state type="loading" skeleton="{{2}}" />
  </view>
  <mk-sys-state wx:elif="{{sys}}" type="{{sys}}" bind:retry="onRetry" />
  <view wx:else class="mk-gutter mt-body">
    <mk-notice wx:if="{{goneTip}}" plain="{{true}}" tone="err" title="{{T.m.goneTitle}}" text="{{T.m.goneSub}}" />
    <mk-empty wx:if="{{mode === 'sales'}}" card="{{true}}" icon="/assets/icons/headset-brand.svg" title="{{T.m.salesTitle}}" sub="{{T.m.salesSub}}">
      <button class="mk-btn mk-btn--md mk-empty-btn" hover-class="mk-btn--hover" bindtap="onAdvisorLead">{{T.cta.toAdvisor}}</button>
      <button class="mk-btn mk-btn--ghost mk-btn--md mk-empty-btn" hover-class="mk-btn--ghostHover" bindtap="onModify">{{T.m.modifyCap}}</button>
    </mk-empty>
    <block wx:elif="{{mode === 'none'}}">
      <mk-empty card="{{true}}" icon="/assets/icons/cube-brand.svg" title="{{T.m.noneTitle}}" sub="{{noneSub}}">
        <button class="mk-btn mk-btn--md mk-empty-btn" hover-class="mk-btn--hover" bindtap="onMoreStores">{{T.m.allCity}}</button>
        <button class="mk-btn mk-btn--ghost mk-btn--md mk-empty-btn" hover-class="mk-btn--ghostHover" bindtap="onModify">{{T.m.modifyCap}}</button>
      </mk-empty>
      <mk-advisor-card wx:if="{{advisor}}" title="{{advisor.title}}" sub="{{advisor.sub}}" />
    </block>
    <block wx:else>
      <view class="mt-hd"><text class="mk-h2">{{title}}</text><text wx:if="{{sub}}" class="mk-sub">{{sub}}</text></view>
      <mk-store-card wx:for="{{cards}}" wx:key="id" card="{{item}}" variant="match" enter="{{index}}" bump="{{priceBump}}" bind:store="onStore" bind:action="onAction" bind:fees="onFees" />
      <view hover-class="mk-tap--hover" hover-stop-propagation="{{true}}" class="mt-more" bindtap="onMoreStores" aria-role="button" aria-label="更多仓位"><image class="mk-icon" src="/assets/icons/down-ink.svg" /></view>
      <mk-advisor-card wx:if="{{advisor}}" title="{{advisor.title}}" sub="{{advisor.sub}}" />
    </block>
    <view class="mt-estore"><mk-estore-card variant="match" /></view>
  </view>

  <mk-sheet visible="{{feesVisible}}" title="{{T.m.fees.title}}" bind:close="onFeesClose">
    <view wx:for="{{fees.rows}}" wx:key="k" class="mt-frow">
      <view class="mk-between"><view class="mk-grow mk-row"><text>{{item.k}}</text><text wx:if="{{item.sub}}" class="mk-mute mt-fsub">{{item.sub}}</text><text wx:if="{{item.tag}}" class="mk-tag mk-tag--promo mt-ftag">{{item.tag}}</text></view><text class="mk-num {{item.muted ? 'mt-muted' : ''}}">{{item.v}}</text></view>
      <text wx:if="{{item.note}}" class="mk-mute">{{item.note}}</text>
    </view>
    <view class="mk-between mt-ftotal"><text class="mk-title">{{T.m.fees.payable}}</text><text class="mk-num mt-fpay {{payBump}}">{{fees.payable}}</text></view>
    <button class="mk-btn" hover-class="mk-btn--hover" bindtap="onFeesClose">{{T.m.fees.ok}}</button>
  </mk-sheet>
  <mk-login-sheet visible="{{loginVisible}}" tip="{{loginTip}}" bind:close="onLoginClose" bind:success="onLoginSuccess" />
  <mk-location-panel visible="{{panel}}" bind:close="onPanelClose" bind:change="onLocationChange" />
</view>
