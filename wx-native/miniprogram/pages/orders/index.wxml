<view class="mk-page">
  <mk-sys-state wx:if="{{sys}}" type="{{sys}}" bind:retry="onRetry" />
  <block wx:else>
    <view wx:if="{{orders.length === 0}}" class="ol-empty">
      <image class="ol-pic" src="/assets/icons/order-sub.svg" />
      <text class="mk-title">{{T.empty}}</text>
      <text class="mk-sub ol-s">{{loggedIn ? T.emptySub : T.loginTip}}</text>
      <button wx:if="{{loggedIn}}" class="mk-btn mk-btn--md" hover-class="mk-btn--hover" bindtap="onGoStores">{{T.goStores}}</button>
      <button wx:else class="mk-btn mk-btn--md" hover-class="mk-btn--hover" bindtap="onLogin">{{T.login}}</button>
    </view>
    <view wx:else class="mk-gutter ol-list">
      <view class="mk-between ol-head"><text class="mk-title">{{T.all}}</text><text class="mk-sub">{{T.sort}}</text></view>
      <view wx:for="{{orders}}" wx:key="id" data-id="{{item.id}}" bindtap="onOrder" aria-role="button">
        <mk-order-card order="{{item}}" variant="list" />
      </view>
    </view>
  </block>
  <mk-login-sheet visible="{{loginVisible}}" bind:close="onLoginClose" bind:success="onLoginSuccess" />
</view>
