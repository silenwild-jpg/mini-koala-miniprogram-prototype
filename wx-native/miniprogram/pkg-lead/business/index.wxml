<view class="mk-page mk-page--plain ldf-page">
  <view wx:if="{{sys}}" class="mk-sys-wrap"><mk-sys-state type="{{sys}}" skeleton="{{3}}" bind:retry="onRetry" /></view>
  <block wx:else>
    <view class="lbz-steps">
      <view class="lbz-step {{step === 1 ? 'lbz-step--on' : ''}}"><text class="lbz-n mk-num">1</text><text>{{T.z.steps[0]}}</text></view>
      <view class="lbz-line"></view>
      <view class="lbz-step {{step === 2 ? 'lbz-step--on' : ''}}"><text class="lbz-n mk-num">2</text><text>{{T.z.steps[1]}}</text></view>
    </view>
    <view class="ldf-ptitle lbz-head">
      <view class="mk-between">
        <text class="{{step === 1 ? 'ldf-h1' : 'mk-h2'}} mk-grow lbz-ht">{{step === 1 ? T.z.title : T.z.steps[1]}}</text>
        <view hover-class="mk-tap--hover" hover-stop-propagation="{{true}}" class="ldf-textbtn lbz-needs" bindtap="onNeeds" aria-role="button"><text>{{T.c.viewNeeds}}</text><image class="mk-icon" src="/assets/icons/chev-brand.svg" /></view>
      </view>
      <block wx:if="{{step === 1}}">
        <text class="ldf-p">{{T.z.intro}}</text>
        <text class="lbz-perks mk-ellipsis">{{benefitLine}}</text>
      </block>
    </view>
    <view wx:if="{{blocked || (editing && !saved) || status === 'failed' || status === 'unknown' || restored}}" class="mk-gutter ldf-ntc">
      <mk-notice wx:if="{{blocked}}" tone="err" title="{{T.z.blockedTitle}}" text="{{T.z.blockedMsg}}" link="{{T.z.newLead}}" bind:link="onNewLead" />
      <mk-notice wx:elif="{{editing && !saved}}" title="{{T.z.editTitle}}" text="{{T.z.editMsg}}" link="{{T.z.newLead}}" bind:link="onNewLead" />
      <mk-notice wx:if="{{status === 'failed'}}" tone="err" title="{{editing ? T.z.failedTitle : T.c.failedTitle}}" text="{{T.c.failedHint}}" link="{{T.c.retry}}" bind:link="onRetrySubmit" />
      <mk-notice wx:if="{{status === 'unknown'}}" tone="err" title="{{T.c.unknownTitle}}" text="{{T.c.unknownHint}}" link="{{T.c.recheck}}" bind:link="onRetrySubmit" />
      <mk-notice wx:if="{{restored}}" title="{{T.z.restoredTitle}}" text="{{T.z.restoredMsg}}" />
    </view>
    <view wx:if="{{step === 1}}" class="ldf-form mk-fade">
      <mk-field class="ldf-fld" label="{{T.z.location}}">
        <view class="ldf-input"><input class="ldf-native" value="{{location}}" maxlength="{{addressMax}}" disabled="{{locked}}" placeholder="{{T.z.locationPh}}" placeholder-class="ldf-ph" bindinput="onLocation" /></view>
        <block wx:if="{{areasOpen}}">
          <mk-field label="{{T.z.areas}}" mark="{{T.c.multi}}" hint="{{areasNote}}">
          <view class="ldf-chips"><view hover-class="mk-tap--hover" hover-stop-propagation="{{true}}" wx:for="{{areaChips}}" wx:key="a" class="ldf-chip {{item.on ? 'ldf-chip--on' : ''}}" data-i="{{index}}" bindtap="onArea" aria-role="button"><image wx:if="{{item.on}}" class="mk-icon" src="/assets/icons/check-brand.svg" /><text>{{item.a}}</text></view></view>
          </mk-field>
        </block>
        <view hover-class="mk-tap--hover" hover-stop-propagation="{{true}}" wx:else class="ldf-textbtn lbz-add" bindtap="onAreasOpen" aria-role="button"><image class="mk-icon" src="/assets/icons/pin-brand.svg" /><text>{{T.z.addArea}}</text></view>
      </mk-field>
      <mk-field label="{{T.z.size}}" error="{{sizeErr}}" hint="{{sizeNote}}">
        <view class="ldf-chips">
          <view hover-class="mk-tap--hover" hover-stop-propagation="{{true}}" wx:for="{{bandChips}}" wx:key="key" class="ldf-chip {{item.on ? 'ldf-chip--on' : ''}}" data-k="{{item.key}}" bindtap="onBand" aria-role="button"><image wx:if="{{item.on}}" class="mk-icon" src="/assets/icons/check-brand.svg" /><text>{{item.label}}</text></view>
          <view hover-class="mk-tap--hover" hover-stop-propagation="{{true}}" class="ldf-chip {{custom ? 'ldf-chip--on' : ''}}" data-k="custom" bindtap="onBand" aria-role="button"><image wx:if="{{custom}}" class="mk-icon" src="/assets/icons/check-brand.svg" /><text>{{T.z.custom}}</text></view>
        </view>
        <view wx:if="{{custom}}" class="ldf-input {{sizeErr ? 'ldf-input--err' : ''}}"><input class="ldf-native" type="digit" value="{{sizeRaw}}" disabled="{{locked}}" placeholder="{{T.z.sizePh}}" placeholder-class="ldf-ph" bindinput="onSize" /><text class="ldf-suffix">{{T.c.m3}}</text></view>
      </mk-field>
      <view class="ldf-fld"><view hover-class="mk-tap--hover" hover-stop-propagation="{{true}}" class="ldf-textbtn lbz-add" bindtap="onEstimate" aria-role="button"><image class="mk-icon" src="/assets/icons/cube-brand.svg" /><text>{{T.z.estimate}}</text></view></view>
      <mk-field class="ldf-fld" label="{{T.z.term}}" error="{{termErr}}">
        <view class="lbz-term"><mk-term-seg value="{{term}}" bind:change="onTerm" /></view>
      </mk-field>
      <mk-field class="ldf-fld" label="{{T.z.types}}" mark="{{T.c.multi}}">
        <view class="ldf-chips"><view hover-class="mk-tap--hover" hover-stop-propagation="{{true}}" wx:for="{{typeChips}}" wx:key="t" class="ldf-chip {{item.on ? 'ldf-chip--on' : ''}}" data-i="{{index}}" bindtap="onType" aria-role="button"><image wx:if="{{item.on}}" class="mk-icon" src="/assets/icons/check-brand.svg" /><text>{{item.t}}</text></view></view>
        <view wx:if="{{typeOtherOn}}" class="ldf-input"><input class="ldf-native" value="{{typeOther}}" maxlength="{{nameMax}}" disabled="{{locked}}" placeholder="{{T.z.typeOtherPh}}" placeholder-class="ldf-ph" bindinput="onTypeOther" /></view>
      </mk-field>
      <mk-field class="ldf-fld" label="{{T.z.move}}">
        <view class="lbz-seg"><view hover-class="mk-tap--hover" hover-stop-propagation="{{true}}" wx:for="{{moveChips}}" wx:key="t" class="lbz-segcell ldf-seg-ease {{item.on ? 'lbz-segcell--on' : ''}}" data-i="{{index}}" bindtap="onMove" aria-role="button">{{item.t}}</view></view>
        <mk-notice wx:if="{{moveNeed}}" class="lbz-movenote" plain="{{true}}" title="{{T.z.moveNoteTitle}}" text="{{T.z.moveNote}}" />
      </mk-field>
    </view>
    <view wx:else class="ldf-form mk-fade">
      <view class="ldf-block mk-between lbz-sum">
        <view class="mk-grow"><text class="mk-sub lbz-sumk">{{T.z.sumLabel}}</text><text class="lbz-sumv lbz-sumv--main mk-num">{{sumText}}</text><text wx:if="{{typeSum}}" class="mk-sub lbz-sumv">{{typeSum}}</text><text wx:if="{{areaSum}}" class="mk-sub lbz-sumv">{{areaSum}}</text></view>
        <view hover-class="mk-tap--hover" hover-stop-propagation="{{true}}" class="ldf-textbtn" bindtap="onPrev" aria-role="button">{{T.c.modify}}</view>
      </view>
      <mk-field class="ldf-fld" label="{{T.z.name}}" mark="{{T.c.optionalFill}}">
        <view class="ldf-input"><input class="ldf-native" value="{{name}}" maxlength="{{nameMax}}" disabled="{{locked}}" placeholder="{{T.z.namePh}}" placeholder-class="ldf-ph" bindinput="onName" /></view>
      </mk-field>
      <mk-field class="ldf-fld" label="{{T.z.company}}" mark="{{T.c.optionalFill}}">
        <view class="ldf-input"><input class="ldf-native" value="{{company}}" maxlength="{{nameMax}}" disabled="{{locked}}" placeholder="{{T.z.companyPh}}" placeholder-class="ldf-ph" bindinput="onCompany" /></view>
      </mk-field>
      <mk-field class="ldf-fld" label="{{T.phoneLabel}}" mark="{{T.c.required}}" mark-tone="req">
        <lead-phone id="phone" what="{{what}}" error="{{errPhone}}" disabled="{{locked}}" bind:change="onPhoneChange" bind:login="onPhoneLogin" />
      </mk-field>
      <mk-field class="ldf-fld" label="{{T.z.when}}" mark="{{T.c.optionalFill}}" error="{{errDate}}">
        <view hover-class="mk-tap--hover" hover-stop-propagation="{{true}}" class="ldf-input {{errDate ? 'ldf-input--err' : ''}}" bindtap="onOpenDate" aria-role="button"><image class="mk-icon lbz-lead" src="/assets/icons/cal-ink.svg" /><text class="mk-grow {{date ? '' : 'ldf-ph'}}">{{date || T.c.pickDate}}</text><image class="mk-icon" src="/assets/icons/chev-mute.svg" /></view>
      </mk-field>
      <mk-field class="ldf-fld" label="{{T.z.notes}}" mark="{{T.c.optionalFill}}">
        <view class="ldf-input ldf-input--tall"><textarea class="ldf-area" value="{{notes}}" maxlength="{{notesMax}}" disabled="{{locked}}" placeholder="{{T.z.notesPh}}" placeholder-class="ldf-ph" bindinput="onNotes" /><text class="ldf-count">{{notesCount}}</text></view>
      </mk-field>
      <text class="ldf-paynote">{{payNote}}</text>
    </view>
    <view class="mk-bottom-bar ldf-acts">
      <block wx:if="{{step === 1}}">
        <button class="mk-btn {{locked ? 'mk-btn--disabled' : 'mk-btn--ghost'}}" hover-class="{{locked ? 'none' : 'mk-btn--ghostHover'}}" bindtap="onBrowse">{{T.z.browse}}</button>
        <button class="mk-btn {{blocked || locked ? 'mk-btn--disabled' : ''}}" hover-class="{{blocked || locked ? 'none' : 'mk-btn--hover'}}" bindtap="onNext">{{T.z.next}}</button>
      </block>
      <block wx:else>
        <button class="mk-btn {{locked ? 'mk-btn--disabled' : 'mk-btn--plain'}}" hover-class="{{locked ? 'none' : 'mk-btn--plainHover'}}" bindtap="onPrev">{{T.z.prev}}</button>
        <button class="mk-btn {{blocked || status === 'unknown' ? 'mk-btn--disabled' : ''}}" hover-class="{{blocked || status === 'unknown' ? 'none' : 'mk-btn--hover'}}" loading="{{status === 'submitting'}}" bindtap="onSubmit">{{primary}}</button>
      </block>
    </view>
  </block>
  <mk-sheet visible="{{sheet === 'date'}}" title="{{T.c.dateSheet}}" bind:close="onSheetClose">
    <view hover-class="mk-tap--hover" hover-stop-propagation="{{true}}" wx:for="{{dateOptions}}" wx:key="d" class="ldf-optrow {{item.on ? 'ldf-optrow--on' : ''}}" data-i="{{index}}" bindtap="onPickDate" aria-role="button"><text class="mk-num">{{item.d}}</text><image wx:if="{{item.on}}" class="mk-icon" src="/assets/icons/check-brand.svg" /></view>
    <view class="ldf-sheetacts"><button class="mk-btn mk-btn--plain" hover-class="mk-btn--plainHover" bindtap="onSheetClose">{{T.c.cancel}}</button><button class="mk-btn" hover-class="mk-btn--hover" bindtap="onDateOk">{{T.c.confirm}}</button></view>
  </mk-sheet>
  <view wx:if="{{dialog}}" class="lbz-mask mk-fade {{dialogLeave}}" catchtouchmove="noop" bindtap="onDialogClose">
    <view class="lbz-dialog mk-fade-in {{dialogLeave}} mk-leave--zoom" catchtap="noop">
      <view class="ldf-okic"><image class="mk-icon mk-icon--md" src="/assets/icons/check-brand.svg" /></view>
      <text class="mk-h2 lbz-dt">{{dialog.title}}</text>
      <text class="lbz-dm">{{dialog.ack}}</text>
      <text wx:if="{{dialog.fine}}" class="mk-sub lbz-df">{{dialog.fine}}</text>
      <text class="mk-sub lbz-df">{{dialog.hoursNote}}</text>
      <text class="lbz-no mk-num">{{dialog.no}}</text>
      <view class="ldf-sheetacts lbz-dacts">
        <button class="mk-btn mk-btn--plain" hover-class="mk-btn--plainHover" bindtap="onDialogFind">{{T.c.goFind}}</button>
        <button class="mk-btn" hover-class="mk-btn--hover" bindtap="onDialogNeeds">{{T.c.viewNeeds}}</button>
      </view>
    </view>
  </view>
</view>
