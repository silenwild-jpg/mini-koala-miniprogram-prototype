<view wx:if="{{loggedIn}}" class="lph-box {{error ? 'lph-box--err' : ''}}">
  <text class="lph-num mk-num mk-grow">{{masked}}</text>
  <text class="mk-tag mk-tag--end mk-tag--ok">{{T.verified}}</text>
  <view class="lph-mod" hover-class="mk-tap--hover" hover-stop-propagation="{{true}}" bindtap="onModify" aria-role="button">{{T.modify}}</view>
</view>
<block wx:else>
  <button class="mk-btn lph-wx {{error ? 'lph-box--err' : ''}}" hover-class="mk-btn--plainHover" bindtap="onUseWechat">{{T.useWechat}}</button>
  <text class="lph-hint">{{T.hint}}</text>
</block>
<text wx:if="{{error}}" class="mk-error lph-err">{{error}}</text>
<mk-login-sheet visible="{{loginVisible}}" bind:close="onLoginClose" bind:success="onLoginSuccess" />
<mk-sheet visible="{{sheet}}" title="{{T.sheetTitle}}" bind:close="onSheetClose">
  <text class="mk-sub lph-note">{{sheetNote}}</text>
  <view hover-class="mk-tap--hover" hover-stop-propagation="{{true}}" class="lph-row" bindtap="onPickLogin" aria-role="button">
    <view class="mk-grow"><text class="mk-num {{other ? '' : 'lph-on'}}">{{loginMasked}}</text><text class="mk-sub lph-sub">{{T.wechatPhone}}</text></view>
    <image wx:if="{{!other}}" class="mk-icon" src="/assets/icons/check-brand.svg" />
  </view>
  <view wx:if="{{other}}" class="lph-row">
    <view class="mk-grow"><text class="mk-num lph-on">{{otherMasked}}</text><text class="mk-sub lph-sub">{{T.otherPhone}}</text></view>
    <image class="mk-icon" src="/assets/icons/check-brand.svg" />
  </view>
  <view hover-class="mk-tap--hover" hover-stop-propagation="{{true}}" class="lph-row" bindtap="onPickOther" aria-role="button">
    <view class="mk-grow"><text>{{T.other}}</text><text class="mk-sub lph-sub">{{T.otherSub}}</text></view>
    <image class="mk-icon" src="/assets/icons/chev-mute.svg" />
  </view>
  <button class="mk-btn lph-done" hover-class="mk-btn--hover" bindtap="onSheetClose">{{T.done}}</button>
</mk-sheet>
<mk-sheet visible="{{sms}}" title="{{T.smsTitle}}" bind:close="onSmsClose">
  <mk-field label="{{T.phoneLabel}}">
    <view class="lph-field"><input class="lph-input" type="number" maxlength="11" placeholder="{{T.phonePh}}" placeholder-class="lph-ph" value="{{phone}}" bindinput="onPhone" /></view>
  </mk-field>
  <mk-field label="{{T.codeLabel}}" error="{{smsError}}" hint="{{hint}}">
    <view class="mk-row">
      <view class="lph-field mk-grow"><input class="lph-input" type="number" maxlength="6" placeholder="{{T.codePh}}" placeholder-class="lph-ph" value="{{code}}" bindinput="onCode" /></view>
      <view class="lph-send {{sendOff ? 'lph-off' : ''}}" hover-class="{{sendOff ? 'none' : 'mk-tap--hover'}}" hover-stop-propagation="{{true}}" bindtap="onSend" aria-role="button">{{sendText}}</view>
    </view>
  </mk-field>
  <button class="mk-btn lph-done" hover-class="mk-btn--hover" loading="{{busy}}" bindtap="onVerify">{{T.ok}}</button>
  <text class="mk-sub lph-hint">{{fine}}</text>
</mk-sheet>
