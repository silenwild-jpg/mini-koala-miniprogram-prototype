.lak-card { display: flex; flex-direction: column; align-items: center; text-align: center; }
.lak-pic { display: flex; align-items: center; justify-content: center; width: 112rpx; height: 112rpx; border-radius: 50%; background: var(--mk-color-brand-tint); margin: var(--mk-space-2) 0 var(--mk-space-3); }
.lak-t { display: block; }
.lak-m { display: block; margin-top: var(--mk-space-1); font-size: var(--mk-font-size-md); }
.lak-s { display: block; margin-top: 4rpx; }
.lak-acts { display: flex; width: 100%; margin-top: var(--mk-space-4); }
