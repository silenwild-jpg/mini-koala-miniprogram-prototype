@import "../lead.wxss";
/* 联系顾问：本页特有的部分 */
.lsp-top { padding-top: var(--mk-space-3); padding-bottom: var(--mk-space-3); }
.ldf-secs > .mk-sec:first-child { border-top: 0; }
.lsp-gap { margin-top: var(--mk-space-cardGap); }
.lsp-act { flex: 1; min-width: 0; }
.mk-btn.mk-btn.lsp-act--r { margin-left: var(--mk-space-3); }
.lsp-t { display: block; font-size: var(--mk-font-size-md); font-weight: var(--mk-font-weight-medium); }
.lsp-s { display: block; margin-top: 4rpx; }
.lsp-ico { margin-right: var(--mk-space-2); }
.lsp-seg { display: flex; padding: 6rpx; border-radius: var(--mk-radius-control); background: var(--mk-color-canvas-sunken); }
.lsp-segcell { flex: 1; display: flex; align-items: center; justify-content: center; height: var(--mk-size-btnMdHeight); border-radius: var(--mk-radius-control); color: var(--mk-color-ink-secondary); font-size: var(--mk-font-size-sm); white-space: nowrap; }
.lsp-segcell--on { background: var(--mk-color-canvas-card); color: var(--mk-color-brand-text); font-weight: var(--mk-font-weight-medium); }
.lsp-saved { display: block; margin-top: var(--mk-space-2); font-size: var(--mk-font-size-md); }
