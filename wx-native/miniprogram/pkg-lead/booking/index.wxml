<view class="mk-page mk-page--plain {{status === 'success' ? '' : 'ldf-page'}}">
  <view wx:if="{{sys}}" class="mk-sys-wrap"><mk-sys-state type="{{sys}}" skeleton="{{3}}" bind:retry="onRetry" /></view>
  <block wx:elif="{{status === 'success'}}">
    <view class="lbk-result mk-fade-in">
      <view class="lbk-ic"><image class="lbk-tick" src="/assets/icons/check-white.svg" /></view>
      <text class="lbk-done">{{T.ack.submitted}}</text>
      <text class="lbk-ack">{{result.ack}}</text>
      <text wx:if="{{result.hoursNote}}" class="mk-sub lbk-fine">{{result.hoursNote}}</text>
      <text wx:if="{{result.notLock}}" class="mk-sub lbk-fine">{{result.notLock}}</text>
      <text class="lbk-no mk-num">{{result.no}}</text>
      <view wx:if="{{sub === 'accepted'}}" class="lbk-sub mk-row"><image class="mk-icon" src="/assets/icons/check-brand.svg" /><text class="lbk-subok">{{T.b.subOk}}</text></view>
      <view wx:elif="{{sub === 'declined'}}" class="lbk-sub lbk-sub--col"><text class="mk-sub">{{T.b.subNo}}</text><view class="lbk-subask" hover-class="mk-tap--hover" hover-stop-propagation="{{true}}" bindtap="onSubAsk" aria-role="button">{{T.b.subAsk}}</view></view>
      <view class="ldf-acts lbk-acts">
        <button class="mk-btn mk-btn--ghost" hover-class="mk-btn--ghostHover" bindtap="onNeeds">{{needsBtn}}</button>
        <button class="mk-btn mk-btn--plain" hover-class="mk-btn--plainHover" bindtap="onFind">{{T.c.goFind}}</button>
      </view>
    </view>
    <view class="ldf-secs ldf-secs--top mk-fade-in mk-fade-in--d2"><view class="mk-sec">
      <view class="mk-sec__hd">{{T.b.infoTitle}}</view>
      <view wx:for="{{result.rows}}" wx:key="k" class="ldf-kv {{item.last ? 'ldf-kv--last' : ''}}"><text class="ldf-k">{{item.k}}</text><text class="ldf-v">{{item.v}}</text></view>
    </view></view>
  </block>
  <block wx:else>
    <view wx:if="{{status === 'failed' || status === 'unknown'}}" class="mk-gutter ldf-ntc"><mk-notice tone="err" title="{{statusTitle}}" text="{{statusMsg}}" link="{{statusBtn}}" bind:link="onRetrySubmit" /></view>
    <view class="ldf-ptitle"><text class="ldf-h1">{{M.h1}}</text><text class="ldf-p">{{M.p}}</text></view>
    <view wx:if="{{mode === 'business'}}" class="lbk-tobiz mk-sub"><text>{{T.b.toBusinessTip}}</text><view class="mk-link lbk-tolink" hover-class="mk-tap--hover" hover-stop-propagation="{{true}}" bindtap="onToBusiness" aria-role="link">{{T.b.toBusiness}}</view></view>
    <view class="ldf-form">
      <view wx:if="{{store}}" class="ldf-block lbk-store">
        <view class="mk-row"><text class="mk-title mk-ellipsis mk-grow lbk-sn">{{store.name}}</text><text class="mk-tag mk-tag--end mk-tag--brand">{{T.b.storeTag}}</text></view>
        <view class="lbk-ss"><image class="mk-icon lbk-pin" src="/assets/icons/pin-sub.svg" /><text wx:if="{{store.km}}" class="mk-num lbk-km">{{store.km}}</text><text class="mk-sub mk-ellipsis mk-grow">{{store.addr}}</text></view>
      </view>
      <mk-field label="{{T.b.address}}" mark="{{advisor ? T.c.optionalFill : T.c.required}}" mark-tone="{{advisor ? '' : 'req'}}" error="{{errAddress}}">
        <view class="ldf-input {{errAddress ? 'ldf-input--err' : ''}}"><input class="ldf-native" value="{{address}}" maxlength="{{addressMax}}" disabled="{{locked}}" placeholder="{{T.b.addressPh}}" placeholder-class="ldf-ph" bindinput="onAddress" /></view>
      </mk-field>
      <view class="ldf-helprow ldf-fld"><text class="mk-sub mk-grow lbk-help">{{help}}</text><view hover-class="mk-tap--hover" hover-stop-propagation="{{true}}" class="ldf-textbtn" bindtap="onLocate" aria-role="button"><image class="mk-icon" src="/assets/icons/locate-ink.svg" /><text>{{T.b.locate}}</text></view></view>
      <mk-field class="ldf-fld" label="{{T.phoneLabel}}" mark="{{T.c.required}}" mark-tone="req">
        <view wx:if="{{advisor && !phoneReady}}" class="ldf-input lbk-manual"><input class="ldf-native" type="number" maxlength="11" disabled="{{locked}}" placeholder="{{T.manualPhone}}" placeholder-class="ldf-ph" value="{{manualPhone}}" bindinput="onManualPhone" /></view>
        <lead-phone id="phone" what="{{what}}" error="{{errPhone}}" disabled="{{locked}}" bind:change="onPhoneChange" bind:login="onPhoneLogin" />
      </mk-field>
      <mk-field class="ldf-fld" label="{{T.b.when}}" mark="{{T.c.optional}}">
        <view class="ldf-chips">
          <view hover-class="mk-tap--hover" hover-stop-propagation="{{true}}" wx:for="{{hints}}" wx:key="t" class="ldf-chip ldf-chip--line {{item.on ? 'ldf-chip--on' : ''}}" data-i="{{index}}" bindtap="onHint" aria-role="button"><image wx:if="{{item.on}}" class="mk-icon" src="/assets/icons/check-brand.svg" /><text>{{item.t}}</text></view>
        </view>
        <view hover-class="mk-tap--hover" hover-stop-propagation="{{true}}" class="ldf-input" bindtap="onOpenDate" aria-role="button"><image class="mk-icon lbk-lead" src="/assets/icons/cal-ink.svg" /><text class="mk-grow {{date ? '' : 'ldf-ph'}}">{{date || T.c.pickDate}}</text><image class="mk-icon" src="/assets/icons/chev-mute.svg" /></view>
      </mk-field>
      <mk-field class="ldf-fld" label="{{T.b.need}}" mark="{{T.c.optional}}" hint="{{salesCap ? T.b.salesNote : ''}}">
        <view class="lbk-rows">
          <view hover-class="mk-tap--hover" hover-stop-propagation="{{true}}" class="lbk-row" bindtap="onOpenItems" aria-role="button"><image class="mk-icon lbk-lead" src="/assets/icons/user-ink.svg" /><text class="mk-grow">{{T.b.items}}</text><text class="{{items ? '' : 'ldf-ph'}}">{{items || T.c.pick}}</text><image class="mk-icon lbk-chev" src="/assets/icons/chev-mute.svg" /></view>
          <view hover-class="mk-tap--hover" hover-stop-propagation="{{true}}" class="lbk-row" bindtap="onOpenCapacity" aria-role="button"><image class="mk-icon lbk-lead" src="/assets/icons/cube-ink.svg" /><text class="mk-grow">{{T.b.capacity}}</text><text class="{{capHint ? '' : 'ldf-ph'}}">{{capHint || T.c.pick}}</text><image class="mk-icon lbk-chev" src="/assets/icons/chev-mute.svg" /></view>
          <view hover-class="mk-tap--hover" hover-stop-propagation="{{true}}" class="lbk-row lbk-row--last" bindtap="onOpenDuration" aria-role="button"><image class="mk-icon lbk-lead" src="/assets/icons/cal-ink.svg" /><text class="mk-grow">{{T.b.duration}}</text><text class="{{termHint ? '' : 'ldf-ph'}}">{{termHint || T.c.pick}}</text><image class="mk-icon lbk-chev" src="/assets/icons/chev-mute.svg" /></view>
        </view>
      </mk-field>
      <mk-field class="ldf-fld" label="{{T.b.note}}">
        <view class="ldf-input ldf-input--tall"><textarea class="ldf-area" value="{{note}}" maxlength="{{noteMax}}" disabled="{{locked}}" placeholder="{{T.b.notePh}}" placeholder-class="ldf-ph" bindinput="onNote" /><text class="ldf-count">{{noteCount}}</text></view>
      </mk-field>
    </view>
    <text class="ldf-paynote">{{payNote}}</text>
    <view class="mk-bottom-bar"><button class="mk-btn" hover-class="mk-btn--hover" loading="{{status === 'submitting'}}" bindtap="onSubmit">{{status === 'submitting' ? T.b.submitting : status === 'unknown' ? T.c.recheck : M.submit}}</button></view>
  </block>
  <mk-sheet visible="{{sheet === 'items'}}" title="{{T.b.items}}" bind:close="onSheetClose">
    <view hover-class="mk-tap--hover" hover-stop-propagation="{{true}}" wx:for="{{itemOptions}}" wx:key="t" class="ldf-optrow {{item.on ? 'ldf-optrow--on' : ''}}" data-i="{{index}}" bindtap="onPickItem" aria-role="button"><text>{{item.t}}</text><image wx:if="{{item.on}}" class="mk-icon" src="/assets/icons/check-brand.svg" /></view>
  </mk-sheet>
  <mk-sheet visible="{{sheet === 'capacity'}}" title="{{T.b.capacity}}" bind:close="onSheetClose">
    <mk-field error="{{capErr}}">
    <view class="ldf-input {{capErr ? 'ldf-input--err' : ''}}">
      <input class="ldf-native" type="digit" value="{{capRaw}}" placeholder="{{T.b.capPh}}" placeholder-class="ldf-ph" bindinput="onCapInput" />
      <view hover-class="mk-tap--hover" hover-stop-propagation="{{true}}" class="lbk-unit {{capUnit === 'm3' ? 'lbk-unit--on' : ''}}" data-u="m3" bindtap="onCapUnit" aria-role="button">{{T.c.m3}}</view>
      <view hover-class="mk-tap--hover" hover-stop-propagation="{{true}}" class="lbk-unit {{capUnit === 'm2' ? 'lbk-unit--on' : ''}}" data-u="m2" bindtap="onCapUnit" aria-role="button">{{T.c.m2}}</view>
    </view>
    </mk-field>
    <view class="ldf-chips lbk-quick"><view hover-class="mk-tap--hover" hover-stop-propagation="{{true}}" wx:for="{{capQuick}}" wx:key="t" class="ldf-chip {{item.on ? 'ldf-chip--on' : ''}}" data-i="{{index}}" bindtap="onCapQuick" aria-role="button">{{item.t}}</view></view>
    <text class="mk-sub">{{T.b.capNote}}</text>
    <view class="ldf-sheetacts"><button class="mk-btn mk-btn--plain" hover-class="mk-btn--plainHover" bindtap="onSheetClose">{{T.c.cancel}}</button><button class="mk-btn" hover-class="mk-btn--hover" bindtap="onCapOk">{{T.c.confirm}}</button></view>
  </mk-sheet>
  <mk-sheet visible="{{sheet === 'duration'}}" title="{{T.b.duration}}" bind:close="onSheetClose">
    <view class="lbk-term"><mk-term-seg value="{{termDraft}}" allow-unsure="{{true}}" bind:change="onTermDraft" /></view>
    <view class="ldf-sheetacts"><button class="mk-btn mk-btn--plain" hover-class="mk-btn--plainHover" bindtap="onSheetClose">{{T.c.cancel}}</button><button class="mk-btn" hover-class="mk-btn--hover" bindtap="onDurationOk">{{T.c.confirm}}</button></view>
  </mk-sheet>
  <mk-sheet visible="{{sheet === 'date'}}" title="{{T.c.dateSheet}}" bind:close="onSheetClose">
    <view hover-class="mk-tap--hover" hover-stop-propagation="{{true}}" wx:for="{{dateOptions}}" wx:key="d" class="ldf-optrow {{item.on ? 'ldf-optrow--on' : ''}}" data-i="{{index}}" bindtap="onPickDate" aria-role="button"><text class="mk-num">{{item.d}}</text><image wx:if="{{item.on}}" class="mk-icon" src="/assets/icons/check-brand.svg" /></view>
    <view class="ldf-sheetacts"><button class="mk-btn mk-btn--plain" hover-class="mk-btn--plainHover" bindtap="onSheetClose">{{T.c.cancel}}</button><button class="mk-btn" hover-class="mk-btn--hover" bindtap="onDateOk">{{T.c.confirm}}</button></view>
  </mk-sheet>
</view>
