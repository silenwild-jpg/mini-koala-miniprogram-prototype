<view class="mk-page mk-page--plain ldf-page">
  <view class="les-top">
    <view class="mk-sec">
      <text class="les-kicker">{{T.kicker}}</text>
      <text class="mk-h2 les-title">{{T.title}}</text>
      <text class="mk-sub les-lead">{{T.lead}}</text>
    </view>
    <view class="mk-sec">
      <view class="mk-sec__hd">{{T.cmpTitle}}</view>
      <view class="les-cmp">
        <view class="les-col">
          <text class="les-ct">{{T.self}}</text>
          <text wx:for="{{T.selfList}}" wx:key="*this" class="mk-sub les-li">{{item}}</text>
          <button class="mk-btn mk-btn--plain mk-btn--md les-btn" hover-class="mk-btn--plainHover" bindtap="onSelf">{{T.goSelf}}</button>
        </view>
        <view class="les-col les-col--r">
          <text class="les-ct">{{T.title}}</text>
          <text wx:for="{{T.estoreList}}" wx:key="*this" class="mk-sub les-li">{{item}}</text>
        </view>
      </view>
    </view>
    <view class="mk-sec">
      <view class="mk-sec__hd">{{T.flowTitle}}</view>
      <view wx:for="{{flow}}" wx:key="t" class="les-step">
        <view class="les-rail"><view class="les-dot"></view><view wx:if="{{!item.last}}" class="les-bar"></view></view>
        <view class="mk-grow les-stepbody"><text class="les-st">{{item.t}}</text><text wx:if="{{item.s}}" class="mk-sub les-ss">{{item.s}}</text></view>
      </view>
    </view>
    <view class="mk-sec">
      <view class="mk-sec__hd">{{T.infoTitle}}</view>
      <view wx:for="{{T.info}}" wx:key="k" class="les-info">
        <text class="mk-sub les-ik">{{item.k}}</text>
        <text class="les-iv {{item.mute ? 'les-iv--mute' : ''}}">{{item.v}}</text>
        <view wx:if="{{item.link}}" class="mk-link les-link" hover-class="mk-tap--hover" hover-stop-propagation="{{true}}" bindtap="onBanList" aria-role="link">{{item.link}}</view>
      </view>
      <text class="mk-mute les-fine">{{T.fine}}</text>
    </view>
  </view>
  <view class="mk-bottom-bar"><button class="mk-btn" hover-class="mk-btn--hover" bindtap="onConsult">{{T.cta}}</button></view>
</view>
