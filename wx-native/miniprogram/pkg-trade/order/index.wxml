<view class="mk-page mk-page--plain od-page">
  <view wx:if="{{sys === 'loading'}}" class="mk-gutter od-loading"><mk-sys-state type="loading" skeleton="{{3}}" /></view>
  <mk-sys-state wx:elif="{{sys}}" type="{{sys}}" bind:retry="onRetry" />
  <mk-empty wx:elif="{{empty}}" icon="/assets/icons/order-sub.svg" title="{{T.emptyTitle}}" sub="{{T.emptyDesc}}">
    <button class="mk-btn mk-btn--md mk-empty-btn" hover-class="mk-btn--hover" bindtap="onBackOrders">{{T.backOrders}}</button>
  </mk-empty>
  <view wx:elif="{{order}}">
    <view class="mk-gutter od-top">
      <view class="od-head {{headFx}}">
        <view class="mk-h2">{{head.title}}</view>
        <view class="od-subs">
          <text wx:if="{{headNote}}" class="od-subitem od-headnote od-headnote--{{head.tone}}">{{headNote}}</text>
          <text wx:for="{{subs}}" wx:key="*this" class="mk-sub od-subitem">{{item}}</text>
          <text wx:if="{{clock}}" class="mk-sub od-subitem od-clock mk-num">{{clock}}</text>
        </view>
      </view>
      <mk-notice wx:if="{{paidLine}}" text="{{paidLine}}" />
      <mk-notice wx:if="{{subLine}}" text="{{subLine === 'accepted' ? T.subOk : T.subNo}}" link="{{subLine === 'declined' ? T.subAsk : ''}}" bind:link="onSubAsk" />
      <mk-notice wx:if="{{note}}" title="{{note.title}}" text="{{note.text}}" tone="{{note.tone}}" />
      <view class="od-cardgrp">
        <view class="od-cardwrap"><mk-order-card order="{{order}}" /></view>
        <view wx:if="{{paid}}" class="od-prog" aria-label="{{T.progress}}">
          <view wx:for="{{progress}}" wx:key="k" class="mk-between od-kv"><text class="mk-sub">{{item.k}}</text><text class="{{item.soft ? 'mk-sub' : 'od-kvv'}} {{item.warn ? 'od-kvv--warn' : ''}}">{{item.v}}</text></view>
        </view>
      </view>
    </view>
    <view class="od-secs">
      <view wx:if="{{storeSvc}}" class="mk-sec">
        <view class="mk-sec__hd">{{T.storeSvc}}</view>
        <view wx:if="{{grid.length > 1}}" class="od-grid">
          <view hover-class="mk-tap--hover mk-press--hover" hover-stop-propagation="{{true}}" wx:for="{{grid}}" wx:key="a" class="od-cell mk-press" data-a="{{item.a}}" bindtap="onAct" aria-role="button"><image class="mk-icon mk-icon--md" src="/assets/icons/{{item.icon}}.svg" /><text class="od-celltext">{{item.t}}</text></view>
        </view>
        <view hover-class="mk-tap--hover" hover-stop-propagation="{{true}}" wx:elif="{{grid.length === 1}}" class="od-row" data-a="{{grid[0].a}}" bindtap="onAct" aria-role="button"><image class="mk-icon" src="/assets/icons/{{grid[0].icon}}.svg" /><text class="mk-grow od-rowk">{{grid[0].t}}</text><image class="mk-icon" src="/assets/icons/chev-mute.svg" /></view>
        <view wx:if="{{arrivalRow}}" hover-class="mk-tap--hover" hover-stop-propagation="{{true}}" class="od-row" data-a="arrival" bindtap="onAct" aria-role="button"><image class="mk-icon" src="/assets/icons/pin-brand.svg" /><text class="mk-grow od-rowk">{{T.arrival}}</text><image class="mk-icon" src="/assets/icons/chev-mute.svg" /></view>
        <text wx:if="{{withUnlock}}" class="mk-mute od-rule">{{T.unlockRule}}</text>
      </view>
      <view wx:if="{{paid}}" class="mk-sec">
        <view class="mk-sec__hd od-hd--rows">{{T.services}}</view>
        <view hover-class="mk-tap--hover" hover-stop-propagation="{{true}}" wx:for="{{services}}" wx:key="k" class="od-row od-row--line" data-a="{{item.a}}" bindtap="onAct" aria-role="button">
          <image class="mk-icon" src="/assets/icons/{{item.icon}}.svg" /><text class="mk-grow od-rowk">{{item.k}}</text>
          <text class="od-rowv {{item.on ? 'od-rowv--on' : ''}}">{{item.v}}</text><image class="mk-icon" src="/assets/icons/chev-mute.svg" />
        </view>
      </view>
      <view class="mk-sec">
        <view class="mk-sec__hd od-hd--fee">{{T.feeTitle}}</view>
        <mk-fee-detail order="{{order}}" plain="{{true}}" locked="{{true}}" />
      </view>
      <view wx:if="{{cancelable}}" class="od-cancel"><view hover-class="mk-tap--hover" hover-stop-propagation="{{true}}" class="od-cancelbtn" bindtap="onCancel" aria-role="button">{{T.cancelOrder}}</view></view>
    </view>
  </view>
  <view wx:if="{{showBar && !sys}}" class="mk-bottom-bar od-bar">
    <view wx:if="{{bar.mode === 'pay'}}" class="mk-grow"><view class="mk-sub">{{T.payable}}</view><view class="mk-num od-amt">{{bar.amount}}</view></view>
    <button wx:if="{{bar.secondary}}" class="mk-btn mk-btn--ghost od-barbtn" hover-class="mk-btn--ghostHover" data-a="{{bar.secondary.a}}" bindtap="onAct">{{bar.secondary.t}}</button>
    <button class="mk-btn od-barbtn" hover-class="mk-btn--hover" data-a="{{bar.primary.a}}" bindtap="onAct">{{bar.primary.t}}</button>
  </view>
  <view wx:if="{{payingDlg}}" class="od-scrim mk-fade {{payingDlgLeave}}" catchtouchmove="noop">
    <view class="od-dialog mk-fade-in {{payingDlgLeave ? 'mk-leave mk-leave--zoom' : ''}}"><view class="od-spin"></view><text class="mk-title">{{T.payingTitle}}</text><text class="mk-sub od-dialogdesc">{{T.payingDesc}}</text></view>
  </view>
  <mk-login-sheet visible="{{loginVisible}}" bind:close="onLoginClose" />
</view>
