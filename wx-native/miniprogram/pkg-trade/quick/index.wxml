<view class="mk-page qk-page">
  <view class="qk-steps">
    <block wx:for="{{T.steps}}" wx:key="*this">
      <view wx:if="{{index > 0}}" class="qk-stepline"></view>
      <view class="qk-step"><text class="qk-stepn {{index === 0 ? 'qk-stepn--on' : ''}} mk-num">{{index + 1}}</text><text class="{{index === 0 ? 'qk-stept--on' : 'mk-sub'}}">{{item}}</text></view>
    </block>
  </view>
  <view wx:if="{{sys === 'loading'}}" class="mk-gutter"><mk-sys-state type="loading" skeleton="{{3}}" /></view>
  <mk-sys-state wx:elif="{{sys}}" type="{{sys}}" bind:retry="onRetry" />
  <view wx:else class="mk-gutter">
    <mk-notice wx:if="{{gone && held}}" plain="{{true}}" tone="warn" title="{{T.heldTitle}}" text="{{T.heldDesc}}" link="{{T.heldLink}}" bind:link="onHeld" />
    <mk-notice wx:elif="{{gone}}" plain="{{true}}" tone="err" title="{{T.goneTitle}}" text="{{T.goneDesc}}" />
    <view class="mk-card">
      <view class="qk-ct"><image class="mk-icon mk-icon--md" src="/assets/icons/pin-brand.svg" /><text class="mk-title qk-ctt">{{T.storeUnit}}</text></view>
      <view hover-class="mk-tap--hover" hover-stop-propagation="{{true}}" class="mk-between qk-loc" bindtap="onLocation" aria-role="button">
        <text class="mk-sub">{{T.location}}</text>
        <view class="mk-row"><text>{{locText}}</text><text class="mk-link qk-change">{{T.change}}</text><image class="mk-icon" src="/assets/icons/chev-mute.svg" /></view>
      </view>
      <view hover-class="mk-tap--hover" hover-stop-propagation="{{true}}" class="qk-pick" bindtap="onStoreSheet" aria-role="button">
        <image wx:if="{{store && store.photo}}" class="qk-ph qk-img" src="{{store.photo}}" mode="aspectFill" />
        <view wx:else class="qk-ph"><image class="mk-icon mk-icon--md" src="/assets/icons/store-brand.svg" /></view>
        <view class="mk-grow qk-main">
          <view class="mk-ellipsis {{store ? 'mk-title' : 'qk-hint'}}">{{store ? store.name : T.pickStore}}</view>
          <view wx:if="{{store}}" class="qk-meta"><image class="mk-icon qk-pin" src="/assets/icons/pin-sub.svg" /><text wx:if="{{store.kmText}}" class="mk-num qk-km">{{store.kmText}}</text><text class="mk-sub mk-ellipsis mk-grow">{{store.address}}</text></view>
          <view wx:else class="mk-sub mk-ellipsis qk-line2">{{storeHint}}</view>
          <view wx:if="{{store}}" class="mk-link qk-detail" catchtap="onStoreDetail" aria-role="button">{{T.viewStore}}<image class="mk-icon" src="/assets/icons/chev-brand.svg" /></view>
        </view>
        <image class="mk-icon" src="/assets/icons/chev-mute.svg" />
      </view>
      <view wx:if="{{carried}}" class="mk-mute qk-carried">{{T.carried}}</view>
      <view class="qk-unit">
        <image wx:if="{{unit && unit.thumb}}" class="qk-ph qk-ph--sm qk-img" src="{{unit.thumb}}" mode="aspectFill" />
        <view wx:else class="qk-ph qk-ph--sm"><image class="mk-icon mk-icon--md" src="/assets/icons/cube-brand.svg" /></view>
        <view class="mk-grow qk-main">
          <view wx:if="{{unit}}" class="qk-unitline"><text class="mk-unitno qk-no">{{unit.code}}</text><text class="mk-num qk-vol">{{unit.vol}}</text></view>
          <view wx:else class="qk-hint">{{T.pickUnit}}</view>
          <view class="mk-sub mk-num qk-line2">{{unit ? unit.sub : unitHint}}</view>
          <view wx:if="{{unit && gone}}" class="mk-sub qk-line2">{{T.unitGone}}</view>
          <view wx:elif="{{unit && !est}}" class="qk-line2"><text class="mk-num qk-from">{{fromText}}</text><text class="mk-sub">{{TC.perMonthFrom}}</text></view>
        </view>
        <view hover-class="mk-tap--hover" hover-stop-propagation="{{true}}" class="mk-link qk-swap" bindtap="onUnitSheet" aria-role="button">{{unit ? T.swap : T.choose}}<image class="mk-icon" src="/assets/icons/chev-brand.svg" /></view>
      </view>
    </view>
    <view class="mk-card">
      <view class="qk-ct"><image class="mk-icon mk-icon--md" src="/assets/icons/cal-ink.svg" /><text class="mk-title qk-ctt">{{T.termDate}}</text></view>
      <view class="qk-term"><mk-term-seg value="{{term}}" hint="{{hint}}" bind:change="onTerm" /></view>
      <view class="mk-sub qk-datelabel">{{T.date}}</view>
      <picker mode="date" value="{{startDate}}" start="{{startMin}}" end="{{startMax}}" bindchange="onDate">
        <view class="qk-date"><text class="mk-num {{startDate ? '' : 'qk-hint'}}">{{startDate || T.pickDate}}</text><image class="mk-icon" src="/assets/icons/cal-ink.svg" /></view>
      </picker>
    </view>
    <view class="qk-notes">
      <view class="qk-noteline">{{T.dateNote}}</view>
      <view wx:if="{{est}}" class="qk-noteline mk-num">{{est.sub}}</view>
      <view wx:if="{{access}}" class="qk-noteline">{{access}}</view>
    </view>
  </view>
  <view wx:if="{{!sys}}" class="mk-bottom-bar qk-bar">
    <view hover-class="{{est ? 'mk-tap--hover' : 'none'}}" hover-stop-propagation="{{true}}" class="mk-grow qk-barinfo" bindtap="onFees" aria-role="button">
      <view class="qk-barlabel"><text class="mk-sub">{{barLabel}}</text><text wx:if="{{est}}" class="mk-sub qk-barterm">{{est.term}}</text></view>
      <view class="qk-baramtrow"><text class="mk-num {{barMuted ? 'qk-baramt--muted' : 'qk-baramt'}} {{amtBump}}">{{barAmount}}</text><text wx:if="{{est && est.tag}}" class="mk-tag mk-tag--promo qk-esttag">{{est.tag}}</text></view>
      <view wx:if="{{barNeed}}" class="mk-mute">{{barNeed}}</view>
      <view wx:elif="{{est}}" class="mk-link qk-fees">{{T.fees}}<image class="mk-icon" src="/assets/icons/chev-brand.svg" /></view>
    </view>
    <button class="mk-btn {{btnDisabled ? 'mk-btn--disabled' : ''}} qk-next" hover-class="{{btnDisabled ? 'none' : 'mk-btn--hover'}}" bindtap="onNext">{{btnText}}</button>
  </view>
  <mk-sheet visible="{{storeSheet}}" title="{{T.storeSheet}}" bind:close="onStoreSheetClose">
    <view hover-class="mk-tap--hover" hover-stop-propagation="{{true}}" wx:for="{{storeRows}}" wx:key="id" class="qk-opt {{item.on ? 'qk-opt--on' : ''}}" data-id="{{item.id}}" bindtap="onPickStore" aria-role="button">
      <view class="mk-grow qk-main"><view class="mk-ellipsis qk-optn">{{item.name}}</view><view class="qk-meta"><text wx:if="{{item.kmText}}" class="mk-num qk-km">{{item.kmText}}</text><text class="mk-sub mk-ellipsis mk-grow">{{item.address || item.none}}</text></view></view>
      <view wx:if="{{item.price}}" class="qk-optp"><text class="mk-num">{{item.price}}</text><text class="mk-mute">{{TC.perCubicFrom}}</text></view>
      <image wx:if="{{item.on}}" class="mk-icon" src="/assets/icons/check-brand.svg" />
    </view>
  </mk-sheet>
  <mk-sheet visible="{{unitSheet}}" title="{{T.unitSheet}}" bind:close="onUnitSheetClose">
    <view wx:if="{{unitRows.length === 0}}" class="mk-sub qk-none">{{T.noUnit}}</view>
    <view hover-class="mk-tap--hover" hover-stop-propagation="{{true}}" wx:for="{{unitRows}}" wx:key="id" class="qk-opt {{item.on ? 'qk-opt--on' : ''}}" data-id="{{item.id}}" bindtap="onPickUnit" aria-role="button">
      <view class="mk-grow qk-main"><view class="qk-unitline"><text class="mk-unitno qk-no">{{item.code}}</text><text class="mk-num qk-vol">{{item.vol}}</text><text wx:if="{{item.tier}}" class="mk-tag mk-tag--brand qk-tier">{{item.tier}}</text></view><view class="mk-sub mk-num qk-line2">{{item.sub}}</view></view>
      <view class="qk-optp"><text class="mk-num">{{item.price}}</text><text class="mk-mute">{{TC.perMonthFrom}}</text></view>
      <image wx:if="{{item.on}}" class="mk-icon" src="/assets/icons/check-brand.svg" />
    </view>
  </mk-sheet>
  <mk-sheet visible="{{feeSheet}}" title="{{T.fees}}" bind:close="onFeesClose">
    <mk-fee-detail order="{{draft}}" plain="{{true}}" show-coupon="{{true}}" />
    <button class="mk-btn qk-know" hover-class="mk-btn--hover" bindtap="onFeesClose">{{TC.know}}</button>
  </mk-sheet>
  <mk-login-sheet id="login-sheet" tip="{{loginTip}}" visible="{{loginVisible}}" bind:close="onLoginClose" bind:success="onLoginSuccess" />
  <mk-location-panel visible="{{panel}}" bind:close="onPanelClose" bind:change="onLocationChange" />
</view>
