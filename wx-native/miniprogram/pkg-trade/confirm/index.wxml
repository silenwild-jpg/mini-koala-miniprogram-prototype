<view class="mk-page cf-page {{bar.showAgree ? 'cf-page--agree' : ''}}">
  <view wx:if="{{sys === 'loading'}}" class="mk-gutter cf-body"><mk-sys-state type="loading" skeleton="{{3}}" /></view>
  <mk-sys-state wx:elif="{{sys}}" type="{{sys}}" bind:retry="onRetry" />
  <mk-empty wx:elif="{{mode === 'empty'}}" icon="/assets/icons/order-sub.svg" title="{{emptyKind === 'order' ? TO.emptyTitle : T.emptyTitle}}">
    <button class="mk-btn mk-btn--md mk-empty-btn" hover-class="mk-btn--hover" bindtap="onEmptyBtn">{{emptyKind === 'order' ? TO.backOrders : T.emptyBtn}}</button>
  </mk-empty>
  <view wx:else class="mk-gutter cf-body">
    <view wx:if="{{head}}" class="cf-head {{headFx || 'mk-fade'}}">
      <view class="mk-between"><text class="mk-h2 mk-grow">{{paying ? T.payingHead : head.title}}</text><text class="mk-tag mk-tag--{{head.tone}} mk-tag--end">{{head.tag}}</text></view>
      <view class="cf-subs">
        <text wx:for="{{headSubs}}" wx:key="*this" class="mk-sub cf-subitem">{{item}}</text>
        <text wx:if="{{clock}}" class="cf-subitem mk-num cf-clock">{{T.left}}{{clock}}</text>
      </view>
      <view wx:if="{{head.reason}}" class="cf-why">{{head.reason}}</view>
      <view class="mk-sub">{{head.note}}</view>
    </view>
    <mk-notice wx:if="{{recheck}}" title="{{recheck.title}}" tone="{{recheck.ok ? '' : 'warn'}}">
      <view wx:for="{{recheck.rows}}" wx:key="k" class="mk-between cf-check">
        <text class="mk-sub">{{item.k}}</text>
        <view class="mk-row"><image class="mk-icon cf-checkicon" src="/assets/icons/{{item.ok ? 'check-brand' : 'close-ink'}}.svg" /><text class="{{item.ok ? '' : 'mk-error'}}">{{item.v}}</text></view>
      </view>
    </mk-notice>
    <mk-notice wx:if="{{quoteExpired}}" tone="warn" title="{{T.quoteExpired}}" />
    <mk-notice wx:if="{{held}}" plain="{{true}}" tone="warn" title="{{T.heldTitle}}" text="{{T.heldDesc}}" />
    <mk-notice wx:elif="{{gone}}" plain="{{true}}" tone="err" title="{{T.goneTitle}}" text="{{T.goneDesc}}" />
    <mk-order-card order="{{cardOrder}}" show-km="{{true}}" swap="{{swapText}}" editable="{{editable}}" hint="{{hint}}" dead="{{dead}}" date-note="{{mode === 'compose' && editable ? T.startNote : ''}}" bind:swap="onSwap" bind:term="onTerm" bind:date="onDate" />
    <view wx:if="{{dead}}">
      <view wx:if="{{alts.length}}" class="mk-card cf-card">
        <view class="mk-between cf-sectitle"><text class="mk-title">{{T.altTitle}}</text><text class="mk-sub">{{T.altBy}}</text></view>
        <view hover-class="mk-tap--hover" hover-stop-propagation="{{true}}" wx:for="{{alts}}" wx:key="id" class="cf-alt" data-id="{{item.id}}" bindtap="onAlt" aria-role="button">
          <view class="mk-grow cf-altmain"><view class="mk-ellipsis cf-altn">{{item.name}}</view><view class="cf-altmeta"><text wx:if="{{item.kmText}}" class="mk-sub mk-num cf-altkm">{{item.kmText}}</text><text class="mk-tag cf-altvol mk-num">{{item.vol}}</text></view></view>
          <view class="cf-altp"><view class="mk-num cf-altamt">{{item.price}}</view><view class="mk-mute">{{item.term}}</view></view>
          <image class="mk-icon" src="/assets/icons/chev-mute.svg" />
        </view>
      </view>
      <button class="mk-btn mk-btn--ghost mk-btn--md" hover-class="mk-btn--ghostHover" bindtap="onAdvisor">{{T.btnAdvisor}}</button>
    </view>
    <view wx:else>
      <view class="mk-card cf-card cf-person {{!idv.verified && !locked ? 'cf-person--todo' : ''}}">
        <view class="mk-title cf-sectitle">{{T.person}}</view>
        <view class="cf-prow">
          <text class="mk-sub cf-pk">{{T.personPhone}}</text>
          <text class="mk-grow mk-num cf-kvv">{{phoneText}}</text>
          <view hover-class="mk-tap--hover" hover-stop-propagation="{{true}}" wx:if="{{!locked}}" class="mk-link cf-kvlink" bindtap="onContact" aria-role="button">{{T.contactSwap}}<image class="mk-icon cf-linkchev" src="/assets/icons/chev-brand.svg" /></view>
        </view>
        <view class="cf-prow">
          <text class="mk-sub cf-pk">{{T.identity}}</text>
          <block wx:if="{{idv.verified}}"><text class="mk-grow mk-ellipsis cf-kvv">{{idv.text}}</text><text class="mk-tag mk-tag--ok mk-tag--end">{{T.identityDone}}</text></block>
          <block wx:else><view class="mk-grow"><text class="mk-tag mk-tag--warn">{{T.identityTodo}}</text></view><button wx:if="{{!locked}}" class="mk-btn mk-btn--ghost mk-btn--sm cf-idvbtn" hover-class="mk-btn--ghostHover" bindtap="onIdv">{{T.identityGo}}</button></block>
        </view>
        <view wx:if="{{!idv.verified && !locked}}" class="cf-ptip"><image class="mk-icon cf-ptipicon" src="/assets/icons/info-sub.svg" /><text class="mk-grow">{{T.personTip}}</text></view>
      </view>
      <mk-fee-detail order="{{cardOrder}}" editable="{{couponEditable}}" show-coupon="{{true}}" locked="{{locked}}" no-saved="{{!!price}}" no-total="{{true}}" total-label="{{T.payable}}" placeholder="{{feePlaceholder}}" note="{{feeNote}}" coupon-text="{{couponText}}" bind:coupon="onCoupon" />
      <view hover-class="mk-tap--hover mk-press--hover" hover-stop-propagation="{{true}}" class="mk-card cf-card cf-entry mk-press" bindtap="onProtect" aria-role="button">
        <image class="mk-icon mk-icon--md" src="/assets/icons/shield-ink.svg" />
        <view class="mk-grow cf-entrytext"><view class="cf-entryt">{{T.protect}}</view><view class="mk-sub">{{T.protectSub}}</view></view>
        <image class="mk-icon" src="/assets/icons/chev-mute.svg" />
      </view>
      <view hover-class="mk-tap--hover mk-press--hover" hover-stop-propagation="{{true}}" class="mk-card cf-card cf-entry mk-press" bindtap="onTransport" aria-role="button">
        <image class="mk-icon mk-icon--md" src="/assets/icons/truck-brand.svg" />
        <view class="mk-grow cf-entrytext"><view class="cf-entryt">{{T.transport}}</view><view class="mk-sub">{{T.transportSub}}</view></view>
        <image class="mk-icon" src="/assets/icons/chev-mute.svg" />
      </view>
      <view wx:if="{{cancelable}}" class="cf-cancel"><view hover-class="mk-tap--hover" hover-stop-propagation="{{true}}" class="cf-cancelbtn" bindtap="onCancel" aria-role="button">{{T.cancelOrder}}</view></view>
    </view>
  </view>
  <view wx:if="{{showBar && !sys}}" class="mk-bottom-bar cf-bar">
    <view wx:if="{{bar.showAgree}}" class="cf-agree">
      <view hover-class="mk-tap--hover" hover-stop-propagation="{{true}}" class="cf-hit" bindtap="onAgree" aria-role="checkbox" aria-checked="{{agreed}}"><view class="cf-box {{agreed ? 'cf-box--on' : ''}}"><image wx:if="{{agreed}}" class="cf-tick" src="/assets/icons/check-white.svg" /></view></view>
      <view class="mk-grow mk-sub cf-agreetext"><text bindtap="onAgree">{{T.agreePrefix}}</text><text class="mk-link" bindtap="onNotice">{{docNotice}}</text><text bindtap="onAgree">{{T.agreeMid}}</text><text class="mk-link" bindtap="onProhibited">{{T.agreeProhibited}}</text></view>
    </view>
    <view class="cf-barmain">
      <view wx:if="{{!bar.solo}}" class="mk-grow" bindtap="onFees">
        <view class="cf-barlabel"><text class="mk-sub">{{bar.label}}</text><text wx:if="{{bar.saved && !bar.muted}}" class="cf-saved mk-num">{{bar.saved}}</text></view>
        <view class="mk-num {{bar.muted ? 'cf-amt--muted' : 'cf-amt'}}"><text class="{{amtBump}}">{{bar.amount}}</text></view>
      </view>
      <view class="cf-go {{bar.solo ? 'cf-go--solo' : ''}}">
        <button class="mk-btn {{bar.disabled ? 'mk-btn--disabled' : ''}}" hover-class="{{bar.disabled ? 'none' : 'mk-btn--hover'}}" bindtap="onBar">{{bar.btn}}</button>
        <text wx:if="{{bar.hint}}" class="mk-error cf-barhint">{{bar.hint}}</text>
      </view>
    </view>
  </view>

  <mk-sheet visible="{{sheet === 'idv'}}" title="{{T.idvTitle}}" bind:close="onSheetClose">
    <mk-field label="{{T.idvName}}" error="{{idvNameError}}">
      <view class="cf-field {{idvNameError ? 'cf-field--err' : ''}}"><input class="cf-input" type="text" maxlength="20" placeholder="{{T.idvNamePh}}" placeholder-class="mk-t-off" value="{{idvName}}" disabled="{{idvChecking}}" bindinput="onIdvName" /></view>
    </mk-field>
    <mk-field label="{{T.idvNo}}" error="{{idvError}}">
      <view class="cf-field {{idvError ? 'cf-field--err' : ''}}"><input class="cf-input" type="idcard" maxlength="18" placeholder="{{T.idvNoPh}}" placeholder-class="mk-t-off" value="{{idvNo}}" disabled="{{idvChecking}}" bindinput="onIdvNo" /></view>
    </mk-field>
    <text class="mk-mute cf-fine">{{T.idvFine}}</text>
    <button class="mk-btn {{idvReady && !idvChecking ? '' : 'mk-btn--disabled'}} cf-sheetbtn" hover-class="{{idvReady && !idvChecking ? 'mk-btn--hover' : 'none'}}" bindtap="onIdvSubmit">{{idvChecking ? T.idvChecking : T.idvSubmit}}</button>
  </mk-sheet>
  <mk-sheet visible="{{sheet === 'sign'}}" title="{{T.signTitle}}" bind:close="onSheetClose">
    <view wx:for="{{signRows}}" wx:key="k" class="mk-between cf-signrow"><text class="mk-sub">{{item.k}}</text><text class="{{item.strong ? 'cf-signamt mk-num' : 'cf-kvv'}}">{{item.v}}</text></view>
    <view hover-class="mk-tap--hover" hover-stop-propagation="{{true}}" class="mk-link cf-signlink" bindtap="onUsage" aria-role="button">{{T.signView}}{{docUsage}}</view>
    <text class="mk-mute cf-fine">{{T.signFine}}</text>
    <view class="cf-two">
      <button class="mk-btn mk-btn--ghost cf-half" hover-class="mk-btn--ghostHover" bindtap="onSheetClose">{{T.signBack}}</button>
      <button class="mk-btn cf-half" hover-class="mk-btn--hover" bindtap="onSignConfirm">{{T.signGo}}</button>
    </view>
  </mk-sheet>
  <mk-sheet visible="{{sheet === 'fees'}}" title="{{feesTitle}}" bind:close="onSheetClose">
    <mk-fee-detail order="{{cardOrder}}" plain="{{true}}" show-coupon="{{true}}" locked="{{locked}}" total-label="{{T.payable}}" coupon-text="{{couponText}}" />
    <button class="mk-btn cf-sheetbtn" hover-class="mk-btn--hover" bindtap="onSheetClose">{{TC.know}}</button>
  </mk-sheet>
  <mk-sheet visible="{{sheet === 'pay'}}" title="{{T.payTitle}}" bind:close="onPayLater">
    <mk-fee-detail order="{{cardOrder}}" plain="{{true}}" show-coupon="{{true}}" locked="{{true}}" total-label="{{T.payable}}" />
    <button class="mk-btn cf-sheetbtn" hover-class="mk-btn--hover" bindtap="onPayConfirm">{{payText}}</button>
    <view hover-class="mk-tap--hover" hover-stop-propagation="{{true}}" class="mk-link cf-later" bindtap="onPayLater" aria-role="button">{{T.payLater}}</view>
  </mk-sheet>
  <mk-sheet visible="{{sheet === 'protect'}}" title="{{T.protectTitle}}" bind:close="onSheetClose">
    <view class="cf-pi"><view class="mk-row"><text class="cf-entryt">{{T.protectBasic}}</text><text class="mk-tag mk-tag--ok mk-tag--end">{{T.protectBasicTag}}</text></view><text class="mk-sub cf-pidesc">{{T.protectBasicDesc}}</text></view>
    <view class="cf-pi"><view class="mk-row"><text class="cf-entryt">{{T.protectPlus}}</text><text class="mk-tag mk-tag--info mk-tag--end">{{T.protectPlusTag}}</text></view><text class="mk-sub cf-pidesc">{{T.protectPlusDesc}}</text><text class="mk-sub cf-pidesc">{{T.protectPrice}}</text></view>
    <text class="mk-mute cf-fine">{{T.protectClaim}}</text>
    <view class="cf-two">
      <button class="mk-btn mk-btn--ghost cf-half" hover-class="mk-btn--ghostHover" bindtap="onService">{{TC.contactService}}</button>
      <button class="mk-btn cf-half" hover-class="mk-btn--hover" bindtap="onSheetClose">{{TC.know}}</button>
    </view>
  </mk-sheet>
  <mk-sheet visible="{{sheet === 'coupon'}}" title="{{T.couponTitle}}" bind:close="onSheetClose">
    <view hover-class="mk-tap--hover" hover-stop-propagation="{{true}}" wx:for="{{couponRows}}" wx:key="id" class="cf-opt {{item.off ? 'cf-opt--off' : ''}}" data-i="{{index}}" bindtap="onPickCoupon" aria-role="button">
      <view class="mk-grow"><view>{{item.name}}</view><view wx:if="{{item.sub}}" class="mk-mute">{{item.sub}}</view></view>
      <text wx:if="{{item.amount}}" class="mk-num cf-optamt">{{item.amount}}</text>
      <image wx:if="{{couponChoice === item.id}}" class="mk-icon" src="/assets/icons/check-brand.svg" />
    </view>
    <view class="cf-two cf-twogap">
      <button class="mk-btn mk-btn--ghost cf-half" hover-class="mk-btn--ghostHover" bindtap="onSheetClose">{{TC.cancel}}</button>
      <button class="mk-btn cf-half" hover-class="mk-btn--hover" bindtap="onCouponConfirm">{{TC.confirm}}</button>
    </view>
  </mk-sheet>

  <view wx:if="{{priceDlg}}" class="cf-scrim mk-fade {{priceDlgLeave}}" catchtouchmove="noop">
    <view class="cf-dialog mk-fade-in {{priceDlgLeave ? 'mk-leave mk-leave--zoom' : ''}}">
      <view class="mk-title">{{T.priceTitle}}</view>
      <text class="mk-sub cf-dialogdesc">{{T.priceDesc}}</text>
      <view class="cf-reason"><text class="mk-sub">{{T.priceReason}}</text><text class="cf-reasonv">{{priceDlg.reason}}</text></view>
      <view wx:for="{{priceDlg.rows}}" wx:key="k" class="mk-between cf-diff">
        <text class="mk-sub">{{item.k}}</text>
        <view class="mk-row mk-num"><text wx:if="{{!item.same}}" class="cf-old">{{item.old}}</text><image wx:if="{{!item.same}}" class="mk-icon cf-arrow" src="/assets/icons/arrow-ink.svg" /><text class="cf-kvv">{{item.cur}}</text></view>
      </view>
      <view class="cf-two cf-twogap">
        <button class="mk-btn mk-btn--ghost mk-btn--md cf-half" hover-class="mk-btn--ghostHover" bindtap="onPriceOther">{{T.priceOther}}</button>
        <button class="mk-btn mk-btn--md cf-half" hover-class="mk-btn--hover" bindtap="onPriceAccept">{{T.priceAccept}}</button>
      </view>
    </view>
  </view>
  <view wx:if="{{payingDlg}}" class="cf-scrim mk-fade {{payingDlgLeave}}" catchtouchmove="noop">
    <view class="cf-dialog cf-dialog--center mk-fade-in {{payingDlgLeave ? 'mk-leave mk-leave--zoom' : ''}}">
      <view class="cf-spin"></view>
      <view class="mk-title">{{T.payingTitle}}</view>
      <text class="mk-sub cf-dialogdesc">{{T.payingDesc}}</text>
      <view class="cf-two cf-twogap">
        <button class="mk-btn mk-btn--ghost mk-btn--md cf-half" hover-class="mk-btn--ghostHover" bindtap="onPayProblem">{{T.payProblem}}</button>
        <button class="mk-btn mk-btn--md cf-half" hover-class="mk-btn--hover" bindtap="onPayDone">{{T.payDone}}</button>
      </view>
    </view>
  </view>
  <mk-login-sheet visible="{{loginVisible}}" tip="{{loginTip}}" bind:close="onLoginClose" bind:success="onLoginSuccess" />
</view>
