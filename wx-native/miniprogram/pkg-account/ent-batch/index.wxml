<view class="mk-page mk-page--plain">
  <view wx:if="{{sys}}" class="mk-sys-wrap"><mk-sys-state type="{{sys}}" skeleton="{{3}}" bind:retry="onRetry" /></view>
  <mk-empty wx:elif="{{!loggedIn}}" icon="/assets/icons/docs-ink.svg" title="{{T.guest.title}}" sub="{{T.guest.sub}}">
    <button class="mk-btn mk-btn--md mk-empty-btn" hover-class="mk-btn--hover" bindtap="onLogin">{{T.common.loginRegister}}</button>
  </mk-empty>
  <view wx:elif="{{view === 'gate'}}" class="ac-wrap">
    <mk-empty icon="/assets/icons/shield-ink.svg" title="{{gate.title}}" sub="{{gate.sub}}">
      <button class="mk-btn mk-btn--md mk-empty-btn" hover-class="mk-btn--hover" bindtap="onCert">{{gate.btn}}</button>
    </mk-empty>
    <text class="ac-fine eb-center">{{T.b.gateFine}}</text>
  </view>
  <view wx:elif="{{view === 'empty'}}" class="ac-wrap">
    <mk-empty icon="/assets/icons/docs-ink.svg" title="{{T.b.emptyTitle}}" sub="{{T.b.emptySub}}">
      <button class="mk-btn mk-btn--ghost mk-btn--md mk-empty-btn" hover-class="mk-btn--ghostHover" bindtap="onOrders">{{T.common.viewOrders}}</button>
    </mk-empty>
  </view>
  <view wx:elif="{{view === 'result'}}" class="ac-secs ac-secs--bar mk-fade">
    <view class="ac-pad ac-head">
      <view class="ac-head-row"><text class="mk-h2">{{result.title}}</text><text class="mk-tag mk-tag--end mk-tag--{{result.tone}}">{{result.tag}}</text></view>
      <text wx:if="{{result.sub}}" class="mk-sub ac-head-sub">{{result.sub}}</text>
      <mk-notice wx:if="{{result.status === 'failed'}}" class="eb-reason" plain="{{true}}" tone="err" title="{{result.reason}}" text="{{T.b.reasonSub}}" />
    </view>
    <view class="mk-sec">
      <view class="mk-sec__hd">{{T.b.progress}}</view>
      <view wx:for="{{result.steps}}" wx:key="t" class="ac-step">
        <view class="ac-dot ac-dot--{{item.cls}}"><image wx:if="{{item.cls === 'done'}}" class="ac-dot-ic" src="/assets/icons/check-white.svg" /></view>
        <view class="mk-grow"><text class="ac-step-t {{item.tcls}}">{{item.t}}</text><text wx:if="{{item.s}}" class="mk-mute">{{item.s}}</text></view>
      </view>
    </view>
    <view class="mk-sec">
      <view class="mk-sec__hd">{{T.b.content}}</view>
      <view class="ac-kv"><text class="ac-k">{{T.b.contentTitle}}</text><text class="ac-v">{{result.titleName}}</text></view>
      <view class="ac-kv"><text class="ac-k">{{T.b.contentOrders}}</text><text class="ac-v">{{result.count}}</text></view>
      <view class="ac-kv"><text class="ac-k">{{T.b.amount}}</text><text class="ac-v eb-b mk-num">{{result.amount}}</text></view>
      <view wx:if="{{result.lines.length}}" class="eb-lines"><view wx:for="{{result.lines}}" wx:key="no" class="mk-between eb-line"><text class="mk-sub mk-num">{{item.no}}</text><text class="mk-sub mk-num">{{item.amount}}</text></view></view>
    </view>
    <view class="mk-sec eb-another"><mk-cell title="{{result.another}}" bindtap="onAnother" /></view>
    <view class="mk-bottom-bar">
      <block wx:if="{{result.status === 'failed'}}">
        <button class="mk-btn ac-bar-btn" hover-class="mk-btn--hover" bindtap="onResubmit">{{T.b.retry}}</button>
        <button class="mk-btn mk-btn--ghost ac-bar-btn" hover-class="mk-btn--ghostHover" bindtap="onAdvisor">{{T.common.contactAdvisor}}</button>
      </block>
      <block wx:elif="{{result.status === 'issued'}}">
        <button class="mk-btn ac-bar-btn" hover-class="mk-btn--hover" bindtap="onDownload">{{T.b.download}}</button>
        <button class="mk-btn mk-btn--ghost ac-bar-btn" hover-class="mk-btn--ghostHover" bindtap="onResend">{{T.b.resend}}</button>
      </block>
      <button wx:else class="mk-btn mk-btn--ghost ac-bar-btn" hover-class="mk-btn--ghostHover" bindtap="onOrders">{{T.common.backOrders}}</button>
    </view>
  </view>
  <view wx:elif="{{view === 'confirm'}}" class="ac-secs ac-secs--bar mk-fade">
    <view class="mk-sec ac-noline">
      <view class="mk-sec__hd">{{T.b.titleSection}}</view>
      <mk-cell title="{{title ? title.name : T.b.noTitle}}" value="{{title ? T.b.change : ''}}" strong="{{true}}" bindtap="onChangeTitle" />
      <block wx:if="{{title}}">
        <view wx:if="{{title.tax}}" class="ac-kv"><text class="ac-k">{{T.b.taxId}}</text><text class="ac-v mk-num">{{title.tax}}</text></view>
        <view class="ac-kv"><text class="ac-k">{{T.b.email}}</text><text class="ac-v">{{title.email}}</text></view>
      </block>
    </view>
    <view class="mk-sec">
      <view class="mk-sec__hd">{{contentTitle}}</view>
      <view wx:for="{{lines}}" wx:key="id" class="eb-ord">
        <view class="mk-grow">
          <text class="eb-t">{{item.store}}</text>
          <view class="mk-row eb-s"><text wx:if="{{item.code}}" class="mk-unitno eb-no">{{item.code}}</text><text class="mk-num eb-vol">{{item.vol}}</text><text class="mk-sub eb-term">{{item.term}}</text></view>
          <text class="mk-mute mk-num eb-s eb-blk">{{item.noText}}</text>
          <view class="mk-row eb-s eb-wrap"><text class="mk-sub mk-num eb-fee">{{item.rentText}}</text><text class="mk-sub mk-num">{{item.feeText}}</text></view>
        </view>
        <text class="eb-b mk-num">{{item.amount}}</text>
      </view>
      <text class="ac-fine">{{T.b.contentFine}}</text>
    </view>
    <view class="mk-bottom-bar">
      <view class="mk-between ac-bar-sum"><text class="mk-sub">{{T.b.amount}}</text><text class="ac-amt mk-num">{{sumText}}</text></view>
      <button class="mk-btn {{busy ? 'mk-btn--disabled' : ''}}" hover-class="none" bindtap="onSubmit">{{submitText}}</button>
    </view>
  </view>
  <view wx:else class="ac-secs ac-secs--bar">
    <view class="ac-pad"><mk-notice plain="{{true}}" title="{{T.b.noticeTitle}}" text="{{T.b.noticeSub}}" /></view>
    <view class="mk-sec">
      <view hover-class="mk-tap--hover" hover-stop-propagation="{{true}}" class="eb-ord eb-ord--pick eb-all" bindtap="onToggleAll" aria-role="checkbox" aria-checked="{{allOn}}">
        <view class="eb-box mk-ease {{allOn ? 'eb-box--on' : ''}}"><image wx:if="{{allOn}}" class="eb-tick" src="/assets/icons/check-white.svg" /></view>
        <text class="mk-grow">{{allText}}</text>
      </view>
      <view hover-class="mk-tap--hover" hover-stop-propagation="{{true}}" wx:for="{{rows}}" wx:key="id" class="eb-ord eb-ord--pick" data-id="{{item.id}}" bindtap="onToggle" aria-role="checkbox" aria-checked="{{item.on}}">
        <view class="eb-box mk-ease {{item.on ? 'eb-box--on' : ''}}"><image wx:if="{{item.on}}" class="eb-tick" src="/assets/icons/check-white.svg" /></view>
        <view class="mk-grow">
          <text class="eb-t">{{item.store}}</text>
          <view class="mk-row eb-s"><text wx:if="{{item.code}}" class="mk-unitno eb-no">{{item.code}}</text><text class="mk-num eb-vol">{{item.vol}}</text><text class="mk-sub eb-term">{{item.term}}</text></view>
          <text class="mk-mute mk-num eb-s eb-blk">{{item.noText}}</text>
          <text class="mk-mute mk-num eb-s eb-blk">{{item.paidText}}</text>
        </view>
        <text class="eb-b mk-num">{{item.amount}}</text>
      </view>
    </view>
    <view class="mk-bottom-bar">
      <view class="mk-between ac-bar-sum"><text class="mk-sub">{{selText}}</text><text class="ac-amt mk-num">{{sumText}}</text></view>
      <text wx:if="{{!hasSel}}" class="mk-sub ac-bar-need">{{T.b.needOne}}</text>
      <button class="mk-btn {{hasSel ? '' : 'mk-btn--disabled'}}" hover-class="none" bindtap="onNext">{{T.b.next}}</button>
    </view>
  </view>
  <mk-login-sheet visible="{{loginVisible}}" bind:close="onLoginClose" bind:success="onLoginSuccess" />
</view>
