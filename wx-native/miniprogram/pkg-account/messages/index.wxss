/* 消息页。IMPL-01 去卡片化：页面白底，列表不再包卡；行间发丝线从正文左缘起（与文字对齐），未读点变已读时颜色过渡（mk-ease）。 */
.ms-list { padding-top: var(--mk-space-1); }
.ms-row { display: flex; align-items: flex-start; padding: 0 var(--mk-space-pageGutter); }
.ms-body { padding: var(--mk-space-3) 0; }
.ms-row + .ms-row .ms-body { border-top: var(--mk-border-hairline); }
.ms-dot { width: 16rpx; height: 16rpx; flex: none; border-radius: 50%; margin: 36rpx var(--mk-space-2) 0 0; background: var(--mk-color-status-errorStrong); }
.ms-dot--read { background: var(--mk-color-line-strong); }
.ms-title { display: block; margin-top: var(--mk-space-1); font-size: var(--mk-font-size-md); }
.ms-title--unread { font-weight: var(--mk-font-weight-medium); }
.ms-text { display: block; margin-top: var(--mk-space-1); }
.ms-link { min-height: 64rpx; }
