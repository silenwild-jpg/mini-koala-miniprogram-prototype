<view class="mk-page {{mode === 'form' || !loggedIn ? 'mk-page--plain' : ''}}">
  <view wx:if="{{sys}}" class="mk-sys-wrap"><mk-sys-state type="{{sys}}" skeleton="{{3}}" bind:retry="onRetry" /></view>
  <mk-empty wx:elif="{{!loggedIn}}" icon="/assets/icons/order-ink.svg" title="{{T.guest.title}}" sub="{{T.guest.sub}}">
    <button class="mk-btn mk-btn--md mk-empty-btn" hover-class="mk-btn--hover" bindtap="onLogin">{{T.common.loginRegister}}</button>
  </mk-empty>
  <view wx:elif="{{mode === 'form'}}" class="ac-secs ac-secs--bar">
    <view class="mk-sec">
      <view class="mk-sec__hd">{{T.t.formSection}}</view>
      <mk-field label="{{T.t.type}}">
        <view class="et-seg">
          <view hover-class="mk-tap--hover" hover-stop-propagation="{{true}}" class="et-seg-i mk-ease {{form.type === 'company' ? 'et-seg-i--on' : ''}} {{lock.on ? 'et-seg-i--off' : ''}}" data-v="company" bindtap="onType" aria-role="radio" aria-checked="{{form.type === 'company'}}" aria-disabled="{{lock.on}}">{{T.t.typeCompany}}</view>
          <view hover-class="mk-tap--hover" hover-stop-propagation="{{true}}" class="et-seg-i mk-ease {{form.type === 'person' ? 'et-seg-i--on' : ''}}" data-v="person" bindtap="onType" aria-role="radio" aria-checked="{{form.type === 'person'}}">{{T.t.typePerson}}</view>
        </view>
      </mk-field>
      <mk-notice wx:if="{{lock.on}}" class="et-lock" plain="{{true}}" text="{{lock.text}}" link="{{lock.link}}" bind:link="onCert" />
      <mk-field label="{{form.type === 'person' ? T.t.personName : T.t.name}}">
        <view class="ac-input"><input class="ac-inp" type="text" maxlength="60" placeholder="{{form.type === 'person' ? T.t.personNamePh : T.t.namePh}}" placeholder-class="ac-ph" value="{{form.name}}" data-f="name" bindinput="onField" /></view>
      </mk-field>
      <mk-field wx:if="{{form.type !== 'person'}}" label="{{T.t.tax}}" error="{{taxError}}">
        <view class="ac-input {{taxError ? 'ac-input--err' : ''}}"><input class="ac-inp" type="text" maxlength="20" placeholder="{{T.t.taxPh}}" placeholder-class="ac-ph" value="{{form.tax}}" data-f="tax" bindinput="onField" bindblur="onTaxBlur" /></view>
      </mk-field>
      <mk-field label="{{T.t.email}}" error="{{emailError}}">
        <view class="ac-input {{emailError ? 'ac-input--err' : ''}}"><input class="ac-inp" type="text" maxlength="60" placeholder="{{T.t.emailPh}}" placeholder-class="ac-ph" value="{{form.email}}" data-f="email" bindinput="onField" bindblur="onEmailBlur" /></view>
      </mk-field>
    </view>
    <view wx:if="{{form.type !== 'person'}}" class="mk-sec">
      <view class="mk-sec__hd">{{T.t.vatSection}}</view>
      <mk-field label="{{T.t.bank}}" mark="{{T.common.optional}}">
        <view class="ac-input"><input class="ac-inp" type="text" maxlength="60" placeholder="{{T.t.bankPh}}" placeholder-class="ac-ph" value="{{form.bank}}" data-f="bank" bindinput="onField" /></view>
      </mk-field>
      <mk-field label="{{T.t.account}}" mark="{{T.common.optional}}">
        <view class="ac-input"><input class="ac-inp" type="text" maxlength="40" placeholder="{{T.t.accountPh}}" placeholder-class="ac-ph" value="{{form.account}}" data-f="account" bindinput="onField" /></view>
      </mk-field>
      <mk-field label="{{T.t.addr}}" mark="{{T.common.optional}}">
        <view class="ac-input"><input class="ac-inp" type="text" maxlength="100" placeholder="{{T.t.addrPh}}" placeholder-class="ac-ph" value="{{form.addr}}" data-f="addr" bindinput="onField" /></view>
      </mk-field>
      <text class="ac-fine">{{T.t.vatFine}}</text>
    </view>
    <view class="mk-sec">
      <view class="ac-kv"><text class="ac-k">{{T.t.asDefault}}</text><switch checked="{{form.isDefault}}" bindchange="onDefault" /></view>
    </view>
    <view class="mk-bottom-bar">
      <button class="mk-btn ac-bar-btn {{ready ? '' : 'mk-btn--disabled'}}" hover-class="none" loading="{{busy}}" bindtap="onSave">{{T.t.save}}</button>
      <button wx:if="{{isEdit}}" class="mk-btn mk-btn--ghost ac-bar-btn et-danger" hover-class="mk-btn--ghostHover" bindtap="onRemove">{{T.t.remove}}</button>
    </view>
  </view>
  <view wx:elif="{{rows.length === 0}}" class="ac-wrap">
    <mk-empty icon="/assets/icons/order-ink.svg" title="{{T.t.emptyTitle}}" sub="{{T.t.emptySub}}">
      <button class="mk-btn mk-btn--md mk-empty-btn" hover-class="mk-btn--hover" bindtap="onAdd">{{T.t.add}}</button>
    </mk-empty>
  </view>
  <view wx:else class="ac-wrap ac-wrap--bar">
    <view wx:for="{{rows}}" wx:key="id" class="mk-card {{index < 6 ? 'mk-fade-in mk-fade-in--d' + index : ''}}">
      <view class="mk-row"><text class="mk-title mk-ellipsis et-name">{{item.name}}</text><text class="mk-tag et-type">{{item.typeText}}</text><view class="mk-grow"></view><text wx:if="{{item.isDefault}}" class="mk-tag mk-tag--end mk-tag--ok">{{T.t.defaultTag}}</text></view>
      <text wx:if="{{item.taxText}}" class="mk-sub mk-num et-line">{{item.taxText}}</text>
      <text class="mk-sub et-line">{{item.email}}</text>
      <view class="et-acts">
        <button class="mk-btn mk-btn--ghost mk-btn--md et-neutral" hover-class="mk-btn--ghostHover" data-id="{{item.id}}" bindtap="onEdit">{{T.t.edit}}</button>
        <button wx:if="{{!item.isDefault}}" class="mk-btn mk-btn--ghost mk-btn--md et-neutral" hover-class="mk-btn--ghostHover" data-id="{{item.id}}" bindtap="onSetDefault">{{T.t.setDefault}}</button>
      </view>
    </view>
    <view class="mk-bottom-bar">
      <button class="mk-btn" hover-class="mk-btn--hover" bindtap="onAdd">{{T.t.add}}</button>
    </view>
  </view>
  <acc-dialog visible="{{dialog.visible}}" title="{{T.t.deleteDialog.title}}" desc="{{T.t.deleteDialog.desc}}" cancel-text="{{T.t.deleteDialog.cancel}}" confirm-text="{{T.t.deleteDialog.confirm}}" danger="{{true}}" bind:cancel="onDialogCancel" bind:confirm="onDialogConfirm" />
  <mk-login-sheet visible="{{loginVisible}}" bind:close="onLoginClose" bind:success="onLoginSuccess" />
</view>
