<view class="mk-page">
  <view wx:if="{{sys}}" class="mk-sys-wrap"><mk-sys-state type="{{sys}}" skeleton="{{3}}" bind:retry="onRetry" /></view>
  <view wx:else class="ac-wrap">
    <mk-empty wx:if="{{empty}}" icon="/assets/icons/heart-ink.svg" title="{{T.empty}}">
      <button class="mk-btn mk-btn--md mk-empty-btn" hover-class="mk-btn--hover" bindtap="onFindStores">{{T.findStores}}</button>
    </mk-empty>
    <block wx:if="{{stores.length}}">
      <text class="fv-sec">{{T.stores}}</text>
      <view hover-class="mk-press--hover" hover-stop-propagation="{{true}}" wx:for="{{stores}}" wx:key="id" class="mk-card fv-card mk-press {{item.leaving ? 'ac-leave' : ''}} {{index < 6 ? 'mk-fade-in mk-fade-in--d' + index : ''}}" data-id="{{item.id}}" data-gone="{{item.gone}}" bindtap="onStore" aria-role="button">
        <view class="fv-head">
          <image wx:if="{{item.photo}}" class="fv-ph {{item.gone ? 'fv-ph--off' : ''}}" mode="aspectFill" src="{{item.photo}}" />
          <view class="mk-grow fv-info">
            <text class="mk-title mk-ellipsis fv-n">{{item.name}}</text>
            <view class="fv-loc">
              <text wx:if="{{item.kmText}}" class="mk-num fv-km">{{item.kmText}}</text>
              <text wx:if="{{item.kmText && item.place}}" class="fv-dot"> · </text>
              <text class="mk-ellipsis mk-grow">{{item.place}}</text>
            </view>
            <view wx:if="{{item.gone}}" class="fv-tags"><text class="mk-tag">{{T.storeGone}}</text></view>
          </view>
          <image wx:if="{{!item.gone}}" class="mk-icon fv-chev" src="/assets/icons/chev-mute.svg" />
        </view>
        <view wx:if="{{item.gone}}" class="mk-between fv-foot">
          <text class="mk-sub mk-grow">{{T.storeGoneSub}}</text>
          <button wx:if="{{item.gone}}" class="mk-bare mk-link fv-rm" hover-class="mk-bare--hover" data-kind="stores" data-id="{{item.id}}" catchtap="onRemove">{{T.remove}}</button>
        </view>
      </view>
    </block>
    <block wx:if="{{units.length}}">
      <text class="fv-sec {{stores.length ? 'fv-sec--next' : ''}}">{{T.units}}</text>
      <view hover-class="mk-press--hover" hover-stop-propagation="{{true}}" wx:for="{{units}}" wx:key="id" class="mk-card fv-card mk-press {{item.leaving ? 'ac-leave' : ''}}" data-store="{{item.storeId}}" bindtap="onUnit" aria-role="button">
        <view class="fv-head">
          <image class="fv-ph fv-ph--unit {{item.gone ? 'fv-ph--off' : ''}}" mode="aspectFill" src="{{item.thumb}}" />
          <view class="mk-grow fv-info">
            <text class="mk-title mk-ellipsis fv-n">{{item.name}}</text>
            <view class="fv-unit">
              <text wx:if="{{item.code}}" class="mk-unitno fv-no">{{item.code}}</text>
              <text class="mk-num fv-vol">{{item.vol}}</text>
              <text wx:if="{{item.gone}}" class="mk-tag mk-tag--end">{{T.unitGone}}</text>
            </view>
            <text wx:if="{{item.dims}}" class="mk-sub mk-num fv-dims">{{item.dims}}</text>
          </view>
          <image wx:if="{{!item.gone}}" class="mk-icon fv-chev" src="/assets/icons/chev-mute.svg" />
        </view>
        <view wx:if="{{item.gone}}" class="mk-between fv-foot">
          <text class="mk-sub mk-grow">{{T.unitGoneSub}}</text>
          <button wx:if="{{item.gone}}" class="mk-bare mk-link fv-rm" hover-class="mk-bare--hover" data-kind="units" data-id="{{item.id}}" catchtap="onRemove">{{T.remove}}</button>
        </view>
      </view>
    </block>
  </view>
</view>
