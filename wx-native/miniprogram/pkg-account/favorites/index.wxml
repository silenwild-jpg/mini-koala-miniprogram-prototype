<view class="mk-page">
  <view wx:if="{{sys}}" class="mk-sys-wrap"><mk-sys-state type="{{sys}}" skeleton="{{3}}" bind:retry="onRetry" /></view>
  <view wx:else class="ac-wrap">
    <mk-empty wx:if="{{empty}}" icon="/assets/icons/heartfill-brand.svg" title="{{T.empty}}" card="{{true}}">
      <button class="mk-btn mk-btn--md mk-empty-btn" hover-class="mk-btn--hover" bindtap="onFindStores">{{T.findStores}}</button>
    </mk-empty>
    <view wx:if="{{stores.length}}" class="mk-card">
      <text class="ac-sec">{{T.stores}}</text>
      <view hover-class="mk-tap--hover" hover-stop-propagation="{{true}}" wx:for="{{stores}}" wx:key="id" class="ac-lrow fv-row" data-id="{{item.id}}" data-gone="{{item.gone}}" bindtap="onStore" aria-role="button">
        <image wx:if="{{item.photo}}" class="fv-ph" mode="aspectFill" src="{{item.photo}}" />
        <view class="mk-grow">
          <view class="mk-row"><text class="fv-n mk-ellipsis">{{item.name}}</text><text wx:if="{{item.gone}}" class="mk-tag mk-tag--end">{{T.storeGone}}</text></view>
          <text class="mk-sub fv-sub mk-ellipsis">{{item.sub}}</text>
        </view>
        <button wx:if="{{item.gone}}" class="mk-bare mk-link fv-rm" hover-class="mk-bare--hover" data-kind="stores" data-id="{{item.id}}" catchtap="onRemove">{{T.remove}}</button>
        <image class="mk-icon" src="/assets/icons/chev-mute.svg" />
      </view>
    </view>
    <view wx:if="{{units.length}}" class="mk-card">
      <text class="ac-sec">{{T.units}}</text>
      <view hover-class="mk-tap--hover" hover-stop-propagation="{{true}}" wx:for="{{units}}" wx:key="id" class="ac-lrow fv-row" data-store="{{item.storeId}}" bindtap="onUnit" aria-role="button">
        <image class="fv-ph" mode="aspectFill" src="{{item.thumb}}" />
        <view class="mk-grow">
          <view class="mk-row"><text class="fv-n mk-ellipsis">{{item.name}}</text><text wx:if="{{item.gone}}" class="mk-tag mk-tag--end">{{T.unitGone}}</text></view>
          <text class="mk-sub fv-sub">{{item.sub}}</text>
        </view>
        <button wx:if="{{item.gone}}" class="mk-bare mk-link fv-rm" hover-class="mk-bare--hover" data-kind="units" data-id="{{item.id}}" catchtap="onRemove">{{T.remove}}</button>
        <image class="mk-icon" src="/assets/icons/chev-mute.svg" />
      </view>
    </view>
  </view>
</view>
