<view class="mk-page">
  <view wx:if="{{sys}}" class="mk-sys-wrap"><mk-sys-state type="{{sys}}" skeleton="{{3}}" bind:retry="onRetry" /></view>
  <mk-empty wx:elif="{{guest}}" icon="/assets/icons/note-ink.svg" title="{{T.v.guestTitle}}" sub="{{T.v.guestSub}}">
    <button class="mk-btn mk-btn--md mk-empty-btn" hover-class="mk-btn--hover" bindtap="onLogin">{{T.login}}</button>
  </mk-empty>
  <view wx:elif="{{list.length === 0}}" class="mk-gutter lnd-top">
    <mk-empty icon="/assets/icons/note-ink.svg" title="{{T.n.emptyTitle}}">
      <button class="mk-btn mk-btn--md mk-empty-btn" hover-class="mk-btn--hover" bindtap="onBook">{{T.n.book}}</button>
    </mk-empty>
  </view>
  <block wx:else>
    <view class="mk-gutter lnd-top">
      <mk-notice wx:if="{{active}}" plain="{{true}}" text="{{T.ack.both}}" />
      <view wx:for="{{list}}" wx:key="id" class="mk-card lnd-card {{index < 6 ? 'mk-fade-in mk-fade-in--d' + index : ''}}">
        <view class="mk-between"><text class="mk-title mk-grow">{{item.title}}</text><text class="mk-tag mk-tag--end {{item.off ? '' : 'mk-tag--warn'}}">{{item.status}}</text></view>
        <view class="lnd-loc"><image class="mk-icon lnd-ic" src="/assets/icons/pin-ink.svg" /><view class="mk-grow"><text class="lnd-line">{{item.loc}}</text><text wx:if="{{item.addr}}" class="mk-sub lnd-addr">{{item.addr}}</text></view></view>
        <text class="lnd-spec mk-num">{{item.detail}}</text>
        <text wx:if="{{item.extra}}" class="mk-sub lnd-sub mk-num">{{item.extra}}</text>
        <view wx:if="{{item.phone}}" class="mk-row lnd-sub"><image class="mk-icon lnd-ic" src="/assets/icons/phone-ink.svg" /><text class="mk-sub mk-num">{{item.phone}}</text></view>
        <text wx:if="{{item.note}}" class="mk-sub lnd-sub">{{item.note}}</text>
        <view wx:if="{{!item.off}}" class="lnd-acts">
          <button wx:if="{{item.visit}}" class="mk-btn mk-btn--md mk-btn--plain lnd-btn" hover-class="mk-btn--plainHover" data-id="{{item.id}}" bindtap="onWithdraw">{{T.n.withdraw}}</button>
          <block wx:elif="{{item.ent}}">
            <button class="mk-btn mk-btn--md mk-btn--plain lnd-btn" hover-class="mk-btn--plainHover" data-id="{{item.id}}" bindtap="onEdit">{{T.n.edit}}</button>
            <button class="mk-btn mk-btn--md mk-btn--ghost lnd-btn" hover-class="mk-btn--ghostHover" data-id="{{item.id}}" bindtap="onFill">{{T.n.fill}}</button>
            <button class="mk-btn mk-btn--md mk-btn--plain lnd-more" hover-class="mk-btn--plainHover" data-id="{{item.id}}" bindtap="onMore" aria-label="更多操作">{{T.n.more}}</button>
          </block>
          <block wx:else>
            <button class="mk-btn mk-btn--md mk-btn--plain lnd-btn" hover-class="mk-btn--plainHover" data-id="{{item.id}}" bindtap="onWithdraw">{{T.n.withdraw}}</button>
            <button class="mk-btn mk-btn--md mk-btn--ghost lnd-btn" hover-class="mk-btn--ghostHover" data-id="{{item.id}}" bindtap="onEdit">{{T.n.edit}}</button>
          </block>
        </view>
      </view>
      <button class="mk-btn mk-btn--ghost lnd-again" hover-class="mk-btn--ghostHover" bindtap="onBook">{{T.v.bookAgain}}</button>
    </view>
  </block>
  <mk-sheet visible="{{sheet === 'more'}}" title="{{T.n.moreTitle}}" bind:close="onSheetClose">
    <mk-cell title="{{T.n.withdrawNeed}}" bindtap="onMoreWithdraw" />
    <mk-cell title="{{T.n.contact}}" divider="{{false}}" bindtap="onMoreContact" />
    <button class="mk-btn mk-btn--plain lnd-sheetbtn" hover-class="mk-btn--plainHover" bindtap="onSheetClose">{{T.c.cancel}}</button>
  </mk-sheet>
  <mk-sheet visible="{{sheet === 'edit'}}" title="{{T.n.editTitle}}" bind:close="onSheetClose">
    <mk-field label="{{T.n.address}}" error="{{editErr}}">
      <view class="lnd-input {{editErr ? 'lnd-input--err' : ''}}"><input class="lnd-native" value="{{editAddress}}" maxlength="{{addressMax}}" placeholder="{{T.n.addressPh}}" placeholder-class="lnd-ph" bindinput="onEditAddress" /></view>
    </mk-field>
    <mk-field label="{{T.n.note}}" hint="{{T.n.editRule}}">
      <view class="lnd-input"><input class="lnd-native" value="{{editNote}}" maxlength="{{noteMax}}" placeholder="{{T.n.notePh}}" placeholder-class="lnd-ph" bindinput="onEditNote" /></view>
    </mk-field>
    <button class="mk-btn lnd-sheetbtn" hover-class="mk-btn--hover" loading="{{busy}}" bindtap="onSave">{{T.n.save}}</button>
  </mk-sheet>
  <mk-login-sheet visible="{{loginVisible}}" bind:close="onLoginClose" bind:success="onLoginSuccess" />
</view>
