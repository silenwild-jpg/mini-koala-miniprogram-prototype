/* 预约记录 */
.lnd-top { padding-top: var(--mk-space-3); }
.lnd-card { margin-bottom: var(--mk-space-cardGap); }
.lnd-line { display: block; margin-top: var(--mk-space-1); font-size: var(--mk-font-size-md); }
.lnd-sub { display: block; margin-top: var(--mk-space-1); }
.lnd-acts { display: flex; margin-top: var(--mk-space-3); }
.mk-btn.mk-btn.lnd-btn { flex: 1; min-width: 0; margin-right: var(--mk-space-2); white-space: nowrap; }
.lnd-acts .mk-btn.mk-btn.lnd-btn:last-child { margin-right: 0; }
.lnd-more { flex: none; }
.mk-btn.mk-btn.lnd-again { margin-bottom: var(--mk-space-5); }
.lnd-sheetbtn { margin-top: var(--mk-space-4); }
.lnd-input { display: flex; align-items: center; height: var(--mk-size-inputHeight); padding: 0 var(--mk-space-3); border: var(--mk-border-strong); border-radius: var(--mk-radius-control); }
.lnd-input--err { border: var(--mk-border-error); }
.lnd-native { flex: 1; min-width: 0; height: var(--mk-size-inputHeight); font-size: var(--mk-font-size-md); }
.lnd-ph { color: var(--mk-color-ink-tertiary); }
