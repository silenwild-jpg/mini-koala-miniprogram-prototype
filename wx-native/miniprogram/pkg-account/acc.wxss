/* 账户分包 9 个子页共用的样式（类名前缀 ac-）。只用令牌。 */
.ac-wrap { padding: var(--mk-space-3) var(--mk-space-pageGutter) 0; }
.ac-wrap--bar { padding-bottom: 280rpx; }
.ac-sec { display: flex; align-items: center; justify-content: space-between; font-size: var(--mk-font-size-lg); font-weight: var(--mk-font-weight-semibold); padding-bottom: var(--mk-space-2); }
.ac-kv { display: flex; align-items: center; justify-content: space-between; min-height: 88rpx; }
.ac-kv + .ac-kv { border-top: var(--mk-border-hairline); }
.ac-k { color: var(--mk-color-ink-secondary); flex: none; margin-right: var(--mk-space-3); }
.ac-v { text-align: right; min-width: 0; word-break: break-all; }
.ac-soft { color: var(--mk-color-ink-hint); }
.ac-lrow { display: flex; align-items: center; min-height: 104rpx; }
.ac-lrow + .ac-lrow { border-top: var(--mk-border-hairline); }
.ac-label { display: block; font-size: var(--mk-font-size-sm); color: var(--mk-color-ink-secondary); margin-bottom: var(--mk-space-1); }
.ac-input { height: var(--mk-size-inputHeight); border: var(--mk-border-strong); border-radius: var(--mk-radius-control); padding: 0 var(--mk-space-3); display: flex; align-items: center; box-sizing: border-box; }
.ac-input--err { border: var(--mk-border-error); }
.ac-inp { flex: 1; height: 100%; font-size: var(--mk-font-size-md); }
.ac-ph { color: var(--mk-color-ink-tertiary); }
.ac-ferr { display: block; margin-top: var(--mk-space-1); }
.ac-acts { display: flex; margin-top: var(--mk-space-3); }
.ac-act { flex: 1; }
.ac-act + .mk-btn.mk-btn.ac-act { margin-left: var(--mk-space-3); }
.ac-block { margin-top: var(--mk-space-3); }
.ac-fine { display: block; color: var(--mk-color-ink-hint); font-size: var(--mk-font-size-xs); line-height: var(--mk-font-lineHeight-loose); margin-top: var(--mk-space-2); }
.ac-para { display: block; color: var(--mk-color-ink-secondary); line-height: var(--mk-font-lineHeight-loose); }
.ac-head { padding: var(--mk-space-2) 0 var(--mk-space-4); }
.ac-head-row { display: flex; align-items: center; }
.ac-head-sub { display: block; margin-top: var(--mk-space-1); }
.ac-step { display: flex; padding: var(--mk-space-2) 0; }
.ac-dot { width: 36rpx; height: 36rpx; border-radius: 50%; border: var(--mk-border-strong); box-sizing: border-box; flex: none; margin: 4rpx var(--mk-space-3) 0 0; display: flex; align-items: center; justify-content: center; }
.ac-dot--done { background: var(--mk-color-action-primaryFill); border: 1px solid var(--mk-color-action-primaryFill); }
.ac-dot--cur { border: var(--mk-border-brand); background: var(--mk-color-brand-tint); }
.ac-dot--fail { background: var(--mk-color-status-errorStrong); border: 1px solid var(--mk-color-status-errorStrong); }
.ac-dot-ic { width: 24rpx; height: 24rpx; }
.ac-step-t { display: block; }
.ac-step-t--mute { color: var(--mk-color-ink-tertiary); }
.ac-step-t--fail { color: var(--mk-color-status-errorText); }
.ac-bar-btn + .ac-bar-btn { margin-top: var(--mk-space-2); }
.ac-bar-sum { margin-bottom: var(--mk-space-2); }
.ac-bar-need { display: block; margin-bottom: var(--mk-space-2); }
.ac-amt { font-size: var(--mk-font-size-xl); font-weight: var(--mk-font-weight-semibold); }
.ac-login { display: flex; flex-direction: column; align-items: center; padding-top: var(--mk-space-8); padding-bottom: var(--mk-space-6); }
/* IMPL-01 去卡片化：账户各页白底（页面根节点 mk-page--plain），键值、说明、表单分组改成通栏小节（app.wxss mk-sec），小节之间 16rpx 浅灰分区带。
   ac-secs = 小节序列（不带左右页边距，mk-sec 自带）；ac-pad = 小节之外的提示句、空态（带页边距）；ac-noline = 两行以内的键值组不画发丝线。 */
.ac-secs--bar { padding-bottom: 280rpx; }
.ac-secs .mk-sec__hd { margin-bottom: var(--mk-space-2); }
.ac-pad { padding: var(--mk-space-3) var(--mk-space-pageGutter) 0; }
.ac-pad + .mk-sec { border-top: 16rpx solid var(--mk-color-canvas-sunken); }
.ac-noline .ac-kv + .ac-kv { border-top: 0; }
.ac-note { display: block; color: var(--mk-color-ink-secondary); font-size: var(--mk-font-size-sm); line-height: var(--mk-font-lineHeight-loose); }
/* 行尾操作（文字 + 箭头）：键值行里的明确入口 */
.ac-tail { display: flex; align-items: center; flex: none; min-height: 64rpx; margin-left: var(--mk-space-3); padding-left: var(--mk-space-2); border-radius: var(--mk-radius-control); }
/* 失效条目移除时的淡出（收藏页）；时长取 tokens */
.ac-leave { opacity: 0; transform: translateY(-8rpx); transition: opacity var(--mk-motion-base) var(--mk-motion-easing), transform var(--mk-motion-base) var(--mk-motion-easing); }
.ac-pad.ac-head { padding-bottom: var(--mk-space-4); }
