/* 找仓进度 */
.lpg-top { padding-top: var(--mk-space-3); }
.lpg-card { margin-top: var(--mk-space-cardGap); }
.lpg-accent { border-left: 6rpx solid var(--mk-color-brand-fill); }
.lpg-kicker { display: block; margin-bottom: 4rpx; color: var(--mk-color-brand-text); font-size: var(--mk-font-size-xs); }
.lpg-badge { flex: none; display: inline-flex; align-items: center; height: var(--mk-size-tagHeight); padding: 0 var(--mk-space-2); border-radius: var(--mk-radius-control); background: var(--mk-color-brand-tint); color: var(--mk-color-brand-text); font-size: var(--mk-font-size-xs); }
.lpg-sub { display: block; margin-top: 4rpx; }
.lpg-btn { margin-top: var(--mk-space-3); }
.lpg-sec { display: flex; margin-bottom: var(--mk-space-2); }
.lpg-tag { display: inline-flex; align-items: center; height: var(--mk-size-tagHeight); padding: 0 var(--mk-space-2); margin-left: var(--mk-space-2); border-radius: var(--mk-radius-control); background: var(--mk-color-canvas-sunken); color: var(--mk-color-ink-secondary); font-size: var(--mk-font-size-xs); }
.lpg-tag--warn { background: var(--mk-color-status-warningFill); color: var(--mk-color-status-warningText); }
.lpg-store { display: block; font-size: var(--mk-font-size-md); font-weight: var(--mk-font-weight-medium); }
.lpg-kv { display: flex; align-items: center; justify-content: space-between; padding: var(--mk-space-3) 0; border-top: var(--mk-border-hairline); font-size: var(--mk-font-size-md); }
.lpg-kv + .lpg-kv { margin-top: 0; }
.lpg-sub + .lpg-kv { margin-top: var(--mk-space-2); }
.lpg-amt { font-size: var(--mk-font-size-xl); font-weight: var(--mk-font-weight-bold); }
.lpg-empty { display: flex; flex-direction: column; align-items: center; text-align: center; margin-top: var(--mk-space-cardGap); }
.lpg-pic { display: flex; align-items: center; justify-content: center; width: 144rpx; height: 144rpx; margin: var(--mk-space-2) 0 var(--mk-space-3); border-radius: 50%; background: var(--mk-color-brand-tint); }
.lpg-eacts { display: flex; margin: var(--mk-space-4) 0 var(--mk-space-2); }
.lpg-ebtn { padding: 0 var(--mk-space-4); }
.lpg-ebtn--r { margin-left: var(--mk-space-3); }
.lpg-neutral { background: var(--mk-color-canvas-card); color: var(--mk-color-ink-primary); border: var(--mk-border-strong); font-weight: var(--mk-font-weight-regular); }
