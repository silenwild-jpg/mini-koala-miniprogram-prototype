<view class="mk-page">
  <mk-sys-state wx:if="{{sys}}" type="{{sys}}" bind:retry="onRetry" />
  <view wx:else class="mk-gutter lpg-top">
    <mk-need-card id="need" />
    <view wx:if="{{reference}}" class="mk-card lpg-card lpg-accent">
      <text class="lpg-kicker">{{T.kicker}}</text>
      <view class="mk-between"><text class="mk-h2 mk-num">{{reference.title}}</text><text class="lpg-badge">{{T.reference}}</text></view>
      <text class="mk-sub lpg-sub">{{reference.sub}}</text>
      <button class="mk-btn mk-btn--md lpg-btn" hover-class="mk-btn--hover" bindtap="onRefind">{{T.refind}}</button>
    </view>
    <view wx:if="{{selected}}" class="mk-card lpg-card">
      <text class="mk-title lpg-sec">{{T.selected}}</text>
      <text class="lpg-store mk-ellipsis">{{selected.store}}</text>
      <text class="mk-sub lpg-sub mk-num">{{selected.line}}</text>
      <button class="mk-btn mk-btn--md lpg-btn" hover-class="mk-btn--hover" bindtap="onConfirm">{{T.toConfirm}}</button>
    </view>
    <view wx:if="{{quote}}" class="mk-card lpg-card">
      <view class="mk-row lpg-sec"><text class="mk-title">{{T.quoteTitle}}</text><text class="lpg-tag {{quote.valid ? 'lpg-tag--warn' : ''}}">{{quote.tag}}</text></view>
      <text class="lpg-store mk-ellipsis">{{quote.store}}</text>
      <text class="mk-sub lpg-sub mk-num">{{quote.line}}</text>
      <view class="lpg-kv"><text class="mk-sub">{{T.rent}}</text><text class="mk-num">{{quote.rent}}</text></view>
      <view wx:if="{{quote.coupon}}" class="lpg-kv"><text class="mk-sub">{{T.coupon}}</text><text class="mk-num">{{quote.coupon}}</text></view>
      <view class="lpg-kv"><text class="mk-sub">{{T.payable}}</text><text class="mk-num lpg-amt">{{quote.payable}}</text></view>
      <button class="mk-btn mk-btn--md lpg-btn" hover-class="mk-btn--hover" bindtap="onConfirm">{{quote.cta}}</button>
    </view>
    <view wx:if="{{empty}}" class="mk-card lpg-empty">
      <view class="lpg-pic"><image class="mk-icon mk-icon--md" src="/assets/icons/ic-flag.svg" /></view>
      <text class="mk-title">{{T.emptyTitle}}</text>
      <view class="lpg-eacts">
        <button class="mk-btn mk-btn--md lpg-ebtn" hover-class="mk-btn--hover" bindtap="onEstimate">{{T.estimate}}</button>
        <button class="mk-btn mk-btn--md lpg-neutral lpg-ebtn lpg-ebtn--r" hover-class="none" bindtap="onStores">{{T.findStores}}</button>
      </view>
    </view>
  </view>
  <mk-login-sheet visible="{{loginVisible}}" bind:close="onLoginClose" bind:success="onLoginSuccess" />
</view>
