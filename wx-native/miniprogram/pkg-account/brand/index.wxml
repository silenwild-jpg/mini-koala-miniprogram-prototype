<view class="mk-page">
  <mk-sys-state wx:if="{{sys}}" type="{{sys}}" bind:retry="onRetry" />
  <view wx:else class="ac-wrap">
    <view class="mk-card">
      <view class="mk-row br-logo"><view class="br-mark"></view><text class="mk-h2">{{T.logo}}</text></view>
      <view class="br-metrics">
        <view wx:for="{{metrics}}" wx:key="t" class="br-metric"><text class="br-num mk-num">{{item.n}}</text><text class="mk-sub br-block">{{item.t}}</text></view>
      </view>
      <view class="br-pillars">
        <view wx:for="{{pillars}}" wx:key="t" class="br-pillar mk-row">
          <image class="mk-icon mk-icon--md br-pic" src="{{item.icon}}" />
          <view class="mk-grow"><text class="br-pt">{{item.t}}</text><text class="mk-mute br-block">{{item.s}}</text></view>
        </view>
      </view>
      <view wx:if="{{proofs.length}}" class="br-proofs">
        <image wx:for="{{proofs}}" wx:key="*this" class="br-proof" mode="aspectFill" src="{{item}}" />
      </view>
    </view>
    <view class="mk-card">
      <text class="ac-para">{{T.para}}</text>
      <text class="mk-title br-h">{{T.howTitle}}</text>
      <view wx:for="{{T.how}}" wx:key="n" class="mk-row br-li"><text class="br-no mk-num">{{item.n}}</text><text class="mk-grow">{{item.t}}</text></view>
      <text class="mk-title br-h">{{T.storeTitle}}</text>
      <text class="ac-para">{{T.storePara}}</text>
      <text class="mk-title br-h">{{T.serviceTitle}}</text>
      <text class="ac-para">{{T.servicePara}}</text>
      <view class="ac-acts br-acts">
        <button class="mk-btn mk-btn--md ac-act" hover-class="mk-btn--hover" bindtap="onStores">{{T.viewStores}}</button>
        <button class="mk-btn mk-btn--ghost mk-btn--md ac-act" hover-class="none" bindtap="onContact">{{T.contact}}</button>
      </view>
    </view>
  </view>
</view>
