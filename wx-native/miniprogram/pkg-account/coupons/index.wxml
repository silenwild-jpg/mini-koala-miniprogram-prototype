<view class="mk-page mk-page--plain">
  <view wx:if="{{sys}}" class="mk-sys-wrap"><mk-sys-state type="{{sys}}" skeleton="{{3}}" bind:retry="onRetry" /></view>
  <view wx:else class="ac-secs">
    <view class="ac-pad"><mk-notice plain="{{true}}" text="{{notice}}" /></view>
    <mk-empty wx:if="{{empty}}" icon="/assets/icons/ticket-ink.svg" title="{{T.empty}}">
      <button class="mk-btn mk-btn--md mk-empty-btn" hover-class="mk-btn--hover" loading="{{busy}}" bindtap="onClaim">{{T.claim}}</button>
    </mk-empty>
    <view wx:else class="mk-sec">
      <view class="mk-sec__hd">{{T.coupons}}</view>
      <view wx:for="{{coupons}}" wx:key="id" class="cp-card {{item.off ? 'cp-off' : ''}} {{index < 6 ? 'mk-fade-in mk-fade-in--d' + index : ''}}">
        <view class="cp-amt">
          <text wx:if="{{item.amount}}" class="cp-num mk-num">{{item.amount}}</text>
          <text wx:else class="cp-gate">{{T.gateAmount}}</text>
        </view>
        <view class="mk-grow">
          <view class="mk-row"><text class="cp-n">{{item.name}}</text><text class="mk-tag mk-tag--end mk-tag--{{item.tone}}">{{item.tag}}</text></view>
          <text wx:if="{{item.condition}}" class="mk-sub cp-cond">{{item.condition}}</text>
          <view wx:if="{{item.valid || item.canUse}}" class="mk-between cp-line">
            <text class="mk-mute">{{item.valid}}</text>
            <view hover-class="mk-tap--hover" hover-stop-propagation="{{true}}" wx:if="{{item.canUse}}" class="mk-row cp-use" bindtap="onUse" aria-role="button"><text class="mk-link">{{T.use}}</text><image class="mk-icon" src="/assets/icons/chev-brand.svg" /></view>
          </view>
        </view>
      </view>
      <button wx:if="{{!loggedIn}}" class="mk-btn mk-btn--ghost mk-btn--md ac-block cp-login" hover-class="mk-btn--ghostHover" bindtap="onLogin">{{T.gateAmount}}</button>
    </view>
    <view wx:if="{{benefits.length}}" class="mk-sec">
      <view class="mk-sec__hd">{{T.benefits}}</view>
      <mk-cell wx:for="{{benefits}}" wx:key="id" icon="/assets/icons/truck-ink.svg" title="{{item.name}}" arrow="{{false}}" divider="{{index > 0 && benefits.length > 2}}" inset="{{true}}"><text class="mk-tag mk-tag--end mk-tag--{{item.tone}}">{{item.tag}}</text></mk-cell>
    </view>
  </view>
  <mk-login-sheet visible="{{loginVisible}}" bind:close="onLoginClose" bind:success="onLoginSuccess" />
</view>
