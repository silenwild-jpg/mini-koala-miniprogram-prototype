/* 迷你考拉仓 设计令牌 · 由冻结稿 design-system/tokens.css（94 项）换算 · 2026-11-18 W28
   规则：px × 2 = rpx（以 375 宽为基准）；1px 描边保持 1px；状态栏 / 顶栏 / tabBar 高度不换算，运行时取系统值。
   微信小程序不支持 :root，变量挂在 page 上。 */
page {
  --mk-color-brand-fill: #14AE68;
  --mk-color-brand-text: #0B7A48;
  --mk-color-brand-fillPressed: #0F8F55;
  --mk-color-action-primaryFill: #0B7A48;
  --mk-color-action-primaryPressed: #085C36;
  --mk-color-brand-tint: #E6F6EE;
  --mk-color-brand-tintStrong: #CDEBDC;
  --mk-color-canvas-page: #FFFFFF;
  --mk-color-canvas-card: #FFFFFF;
  --mk-color-canvas-sunken: #F5F7F6;
  --mk-color-ink-primary: #1F2A24;
  --mk-color-ink-secondary: #5F6B65;
  --mk-color-ink-tertiary: #8A948F;
  --mk-color-ink-inverse: #FFFFFF;
  --mk-color-line-hairline: #E3E8E5;
  --mk-color-line-strong: #C9D3CD;
  --mk-color-accent-promoFill: #FFF1E6;
  --mk-color-accent-promoText: #B4530A;
  --mk-color-accent-promoIcon: #F5821F;
  --mk-color-status-successFill: #14AE68;
  --mk-color-status-successText: #0B7A48;
  --mk-color-status-warningFill: #FFF1E6;
  --mk-color-status-warningText: #B4530A;
  --mk-color-status-errorFill: #FEF3F2;
  --mk-color-status-errorText: #B42318;
  --mk-color-status-errorStrong: #D92D20;
  --mk-color-status-infoFill: #F5F7F6;
  --mk-color-status-infoText: #5F6B65;
  --mk-color-overlay-scrim: rgba(31,42,36,0.45);
  --mk-color-overlay-photoLabel: rgba(0,0,0,0.65);
  --mk-color-overlay-photoFade: linear-gradient(180deg, rgba(255,255,255,0) 0%, #FFFFFF 100%);
  --mk-font-family-base: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'HarmonyOS Sans SC', 'MiSans', 'Helvetica Neue', 'Noto Sans CJK SC', 'Source Han Sans SC', sans-serif;
  --mk-font-family-numeric: 'DIN Alternate', 'Roboto', -apple-system, 'PingFang SC', sans-serif;
  --mk-font-size-xs: 24rpx;
  --mk-font-size-sm: 26rpx;
  --mk-font-size-md: 28rpx;
  --mk-font-size-lg: 32rpx;
  --mk-font-size-xl: 36rpx;
  --mk-font-size-2xl: 40rpx;
  --mk-font-size-3xl: 48rpx;
  --mk-font-size-4xl: 56rpx;
  --mk-font-weight-regular: 400;
  --mk-font-weight-medium: 500;
  --mk-font-weight-semibold: 600;
  --mk-font-weight-bold: 700;
  --mk-font-lineHeight-tight: 1.2;
  --mk-font-lineHeight-normal: 1.45;
  --mk-font-lineHeight-loose: 1.6;
  --mk-font-feature-tabularNums: 'tnum' 1;
  --mk-space-1: 8rpx;
  --mk-space-2: 16rpx;
  --mk-space-3: 24rpx;
  --mk-space-4: 32rpx;
  --mk-space-5: 40rpx;
  --mk-space-6: 48rpx;
  --mk-space-8: 64rpx;
  --mk-space-10: 80rpx;
  --mk-space-pageGutter: 32rpx;
  --mk-space-cardPad: 32rpx;
  --mk-space-cardPadCompact: 24rpx;
  --mk-space-cardGap: 24rpx;
  --mk-space-sectionGap: 48rpx;
  --mk-space-inlineGap: 16rpx;
  --mk-radius-control: 8rpx;
  --mk-radius-thumb: 16rpx;
  --mk-radius-card: 24rpx;
  --mk-radius-media: 24rpx;
  --mk-radius-none: 0px;
  --mk-elevation-card: 0 1px 0 #E3E8E5;
  --mk-elevation-float: 0 8rpx 28rpx rgba(20,174,104,0.08);
  --mk-elevation-sheet: 0 -4rpx 24rpx rgba(31,42,36,0.08);
  --mk-size-ctaHeight: 88rpx;
  --mk-size-btnMdHeight: 72rpx;
  --mk-size-btnSmHeight: 64rpx;
  --mk-size-inputHeight: 88rpx;
  --mk-size-chipHeight: 56rpx;
  --mk-size-tagHeight: 40rpx;
  --mk-size-thumb: 176rpx;
  --mk-size-thumbCompact: 128rpx;
  --mk-size-cardMediaRatio: 16/10;
  --mk-size-recCardWidth: 284rpx;
  --mk-size-iconMd: 48rpx;
  --mk-size-iconSm: 32rpx;
  /* --mk-size-tabBarHeight: 50px;  设计稿示意值，实现时用 wx.getWindowInfo / 胶囊位置计算，不写死 */
  /* --mk-size-topBarHeight: 44px;  设计稿示意值，实现时用 wx.getWindowInfo / 胶囊位置计算，不写死 */
  /* --mk-size-statusBar: 44px;  设计稿示意值，实现时用 wx.getWindowInfo / 胶囊位置计算，不写死 */
  --mk-size-heroMaxFold: 25%;
  --mk-motion-fast: 120ms;
  --mk-motion-base: 200ms;
  --mk-motion-sheet: 260ms;
  --mk-motion-easing: cubic-bezier(0.2, 0, 0, 1);
  --mk-border-hairline: 1px solid #E3E8E5;
  --mk-border-strong: 1px solid #C9D3CD;
  --mk-border-brand: 1px solid #14AE68;
  --mk-border-error: 1px solid #D92D20;
}
