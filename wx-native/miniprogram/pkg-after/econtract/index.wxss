@import "../after.wxss";
/* —— 电子合同页 —— */
.ec-doc { display: flex; align-items: center; min-height: 96rpx; }
.ec-docs--lined .ec-doc + .ec-doc { border-top: var(--mk-border-hairline); }
.ec-doc-v { flex: none; margin: 0 var(--mk-space-1) 0 var(--mk-space-2); }
.ec-foot { display: block; line-height: var(--mk-font-lineHeight-loose); }
