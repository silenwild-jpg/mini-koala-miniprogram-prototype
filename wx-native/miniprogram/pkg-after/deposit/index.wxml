<view class="mk-page mk-page--plain {{bar ? 'af-pad' : ''}}">
  <view wx:if="{{sys === 'loading'}}" class="af-body af-loading"><mk-sys-state type="loading" skeleton="{{3}}" /></view>
  <mk-sys-state wx:elif="{{sys}}" type="{{sys}}" bind:retry="onRetry" />
  <mk-empty wx:elif="{{empty}}" icon="/assets/icons/order-sub.svg" title="{{T.c.emptyTitle}}" sub="{{T.c.emptySub}}">
    <button class="mk-btn mk-btn--md mk-empty-btn" hover-class="mk-btn--hover" bindtap="onOrders">{{T.c.backOrders}}</button>
  </mk-empty>
  <block wx:else>
    <view class="{{stFx}}"><mk-after-head title="{{head.title}}" tag="{{head.tag}}" tone="{{head.tone}}" subs="{{head.subs}}" /></view>
    <view class="af-body af-top {{stFx}}">
      <view wx:if="{{picks.length}}" class="dp-switch" hover-class="mk-tap--hover" hover-stop-propagation="{{true}}" bindtap="onPick" aria-role="button">
        <text class="mk-sub mk-grow">{{pickCount}}</text><text class="mk-link">{{T.d.switchOrder}}</text><image class="mk-icon" src="/assets/icons/chev-brand.svg" />
      </view>
      <view wx:if="{{part}}" class="dp-amtbox">
        <text class="mk-sub">{{part.label}}</text>
        <text class="mk-num dp-amt">{{part.amt}}</text>
        <view class="dp-part">
          <view wx:for="{{part.rows}}" wx:key="k" class="dp-part-row"><text class="dp-part-k">{{item.k}}</text><text class="mk-num">{{item.v}}</text></view>
        </view>
        <text class="af-rule">{{part.note}}</text>
      </view>
      <view wx:else class="dp-amtbox">
        <view class="mk-row"><text class="mk-sub">{{T.d.amountLabel}}</text><text class="dp-basis">{{T.d.amountBasis}}</text></view>
        <text class="mk-num dp-amt">{{amount}}</text>
      </view>
      <mk-after-fail wx:if="{{fail}}" title="{{T.d.failTitle}}" reason="{{reason}}" fixes="{{T.d.failFixes}}" bind:call="onCall" />
    </view>
    <view class="af-secs {{stFx}}">
      <view class="mk-sec">
        <view class="mk-sec__hd">{{T.d.progress}}</view>
        <mk-after-steps steps="{{steps}}" />
      </view>
      <view class="mk-sec">
        <view class="mk-sec__hd">{{T.d.info}}</view>
        <view class="{{moreFx}}"><mk-after-kv rows="{{info}}" /></view>
        <text wx:if="{{more}}" class="mk-link dp-more" bindtap="onMore" aria-role="button">{{T.d.more}}</text>
      </view>
    </view>
  <view wx:if="{{bar}}" class="mk-bottom-bar af-bar">
    <view wx:if="{{bar.lab}}" class="af-bar-info">
      <text class="mk-mute">{{bar.lab}}</text>
      <text class="mk-num af-bar-amt {{bar.muted ? 'af-bar-amt--muted' : ''}}">{{bar.amt}}</text>
    </view>
    <button wx:for="{{bar.btns}}" wx:key="text" class="mk-btn af-bar-btn {{item.kind === 'ghost' ? 'mk-btn--ghost' : ''}} {{item.off ? 'mk-btn--disabled' : ''}} af-btn--{{item.kind}}" hover-class="{{item.off ? 'none' : item.kind === 'ghost' ? 'mk-btn--ghostHover' : item.kind === 'neutral' ? 'mk-btn--plainHover' : item.kind === 'danger' ? 'mk-btn--dimHover' : 'mk-btn--hover'}}" loading="{{item.loading}}" disabled="{{item.off}}" data-act="{{item.act}}" bindtap="onBar">{{item.text}}</button>
  </view>
    <mk-sheet visible="{{sheet}}" title="{{T.d.sheet}}" bind:close="onSheetClose">
      <mk-after-steps steps="{{sheetSteps}}" />
      <view class="af-acts"><button class="mk-btn af-btn--neutral" hover-class="mk-btn--plainHover" bindtap="onSheetClose">{{T.c.known}}</button></view>
    </mk-sheet>
    <mk-sheet visible="{{pickSheet}}" title="{{T.d.switchTitle}}" bind:close="onPickClose">
      <view hover-class="mk-tap--hover" hover-stop-propagation="{{true}}" wx:for="{{picks}}" wx:key="id" class="dp-opt {{item.on ? 'dp-opt--on' : ''}}" data-id="{{item.id}}" bindtap="onPickOrder" aria-role="button">
        <view class="mk-grow dp-opt-main"><text class="dp-opt-t mk-ellipsis">{{item.t}}</text><view wx:if="{{item.codes.length}}" class="dp-opt-unit"><text wx:for="{{item.codes}}" wx:for-item="c" wx:key="*this" class="mk-unitno dp-opt-no">{{c}}</text><text class="mk-num">{{item.vol}}</text></view><text class="mk-mute dp-opt-s">{{item.s}}</text></view>
        <mk-after-tag text="{{item.tag}}" tone="{{item.tone}}" />
      </view>
    </mk-sheet>
  </block>
</view>
