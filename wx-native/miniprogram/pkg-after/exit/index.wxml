<view class="mk-page mk-page--plain {{bar ? 'af-pad' : ''}}">
  <view wx:if="{{sys === 'loading'}}" class="af-body af-loading"><mk-sys-state type="loading" skeleton="{{3}}" /></view>
  <mk-sys-state wx:elif="{{sys}}" type="{{sys}}" bind:retry="onRetry" />
  <mk-empty wx:elif="{{empty}}" icon="/assets/icons/order-sub.svg" title="{{T.c.emptyTitle}}" sub="{{T.c.emptySub}}">
    <button class="mk-btn mk-btn--md mk-empty-btn" hover-class="mk-btn--hover" bindtap="onOrders">{{T.c.backOrders}}</button>
  </mk-empty>
  <block wx:else>
    <view class="{{stFx}}"><mk-after-head title="{{head.title}}" tag="{{head.tag}}" tone="{{head.tone}}" subs="{{head.subs}}" /></view>
    <view class="af-body af-top">
      <mk-notice wx:if="{{note}}" title="{{note.title}}" text="{{note.text}}" tone="{{note.tone}}" link="{{note.link}}" bind:link="onAgreement" />
      <mk-order-card order="{{order}}" />
    </view>
    <view class="af-secs {{stFx}}">
      <view wx:if="{{cancel}}" class="mk-sec">
        <view class="mk-sec__hd">{{T.x.cancelTitle}}</view>
        <mk-after-kv rows="{{cancel}}" />
        <text class="af-rule">{{T.x.cancelFoot}}</text>
      </view>
      <view wx:if="{{steps.length}}" class="mk-sec">
        <view class="mk-sec__hd">{{T.x.progress}}</view>
        <mk-after-steps steps="{{steps}}" />
      </view>
      <view wx:if="{{form}}" class="mk-sec">
        <view class="mk-sec__hd">{{T.x.arrange}}</view>
        <mk-field label="{{T.x.typeLabel}}">
          <view wx:if="{{form.canEarly}}" class="af-seg">
            <view hover-class="mk-tap--hover" hover-stop-propagation="{{true}}" wx:for="{{form.types}}" wx:key="v" class="af-seg-item mk-ease {{item.on ? 'af-seg-item--on' : ''}}" data-v="{{item.v}}" bindtap="onType" aria-role="button">{{item.t}}</view>
          </view>
          <view wx:else class="af-input"><text>{{form.typeText}}</text></view>
        </mk-field>
        <mk-field label="{{T.x.dateLabel}}">
          <picker mode="date" value="{{form.date}}" start="{{form.min}}" end="{{form.max}}" bindchange="onDate">
            <view class="af-input"><text class="{{form.date ? '' : 'af-ph'}}">{{form.date || T.x.datePlaceholder}}</text><image class="mk-icon" src="/assets/icons/cal-ink.svg" /></view>
          </picker>
        </mk-field>
        <text class="af-rule">{{form.rule}}</text>
        <text wx:if="{{form.tip}}" class="af-rule">{{form.tip}}</text>
      </view>
      <view wx:if="{{depositRows.length}}" class="mk-sec"><mk-after-kv rows="{{depositRows}}" /></view>
      <view wx:if="{{plan.length}}" class="mk-sec">
        <view class="mk-sec__hd">{{T.x.arrange}}</view>
        <mk-after-kv rows="{{plan}}" />
      </view>
      <view wx:if="{{fail}}" class="mk-sec"><mk-after-fail title="{{T.x.failTitle}}" reason="{{order.exit.fail_reason}}" fixes="{{T.x.failFixes}}" bind:call="onCall" /></view>
      <view wx:if="{{before}}" class="mk-sec">
        <view class="mk-sec__hd">{{T.x.beforeInspect}}</view>
        <text>{{T.x.beforeInspectText}}</text>
      </view>
      <view wx:if="{{waitNote}}" class="mk-sec">
      <mk-notice text="{{waitNote}}">
        <view wx:if="{{sub}}" class="ex-sub">
          <image wx:if="{{sub.ok}}" class="mk-icon" src="/assets/icons/check-brand.svg" />
          <text class="mk-sub mk-grow">{{sub.text}}</text>
          <text wx:if="{{!sub.ok}}" class="mk-link ex-subbtn" bindtap="onSubAsk" aria-role="button">{{T.c.subOn}}</text>
        </view>
      </mk-notice>
      </view>
      <view wx:if="{{canWithdraw}}" class="af-alt">
        <view class="af-altbtn" hover-class="mk-tap--hover" hover-stop-propagation="{{true}}" bindtap="onWithdraw" aria-role="button">{{T.x.withdraw}}</view>
      </view>
    </view>
  <view wx:if="{{bar}}" class="mk-bottom-bar af-bar">
    <view wx:if="{{bar.lab}}" class="af-bar-info">
      <text class="mk-mute">{{bar.lab}}</text>
      <text class="mk-num af-bar-amt {{bar.muted ? 'af-bar-amt--muted' : ''}}">{{bar.amt}}</text>
    </view>
    <button wx:for="{{bar.btns}}" wx:key="text" class="mk-btn af-bar-btn {{item.kind === 'ghost' ? 'mk-btn--ghost' : ''}} {{item.off ? 'mk-btn--disabled' : ''}} af-btn--{{item.kind}}" hover-class="{{item.off ? 'none' : item.kind === 'ghost' ? 'mk-btn--ghostHover' : item.kind === 'neutral' ? 'mk-btn--plainHover' : item.kind === 'danger' ? 'mk-btn--dimHover' : 'mk-btn--hover'}}" loading="{{item.loading}}" disabled="{{item.off}}" data-act="{{item.act}}" bindtap="onBar">{{item.text}}</button>
  </view>
    <mk-sheet visible="{{confirm}}" title="{{T.x.confirmTitle}}" bind:close="onConfirmClose">
      <mk-after-kv rows="{{confirmRows}}" bind:link="onAgreement" />
      <text class="af-rule ex-confirm">{{T.x.confirmText}}</text>
      <view class="ex-acts">
        <button class="mk-btn af-btn--neutral ex-act" hover-class="mk-btn--plainHover" bindtap="onConfirmClose">{{T.x.think}}</button>
        <button class="mk-btn af-btn--danger ex-act" hover-class="mk-btn--dimHover" bindtap="onConfirm">{{T.x.confirm}}</button>
      </view>
    </mk-sheet>
    <mk-sheet visible="{{early}}" title="{{T.x.earlyTitle}}" bind:close="onEarlyClose">
      <text class="af-rule ex-early">{{earlyText}}</text>
      <mk-after-kv rows="{{earlyRows}}" bind:link="onAgreement" />
      <view class="ex-acts">
        <button class="mk-btn af-btn--neutral ex-act" hover-class="mk-btn--plainHover" bindtap="onEarlyClose">{{T.x.think}}</button>
        <button class="mk-btn af-btn--danger ex-act" hover-class="mk-btn--dimHover" bindtap="onEarlyConfirm">{{T.x.earlyConfirm}}</button>
      </view>
    </mk-sheet>
  </block>
</view>
