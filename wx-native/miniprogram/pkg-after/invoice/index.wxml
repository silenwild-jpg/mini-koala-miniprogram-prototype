<view class="mk-page mk-page--plain {{bar ? 'af-pad' : ''}}">
  <view wx:if="{{sys === 'loading'}}" class="af-body af-loading"><mk-sys-state type="loading" skeleton="{{3}}" /></view>
  <mk-sys-state wx:elif="{{sys}}" type="{{sys}}" bind:retry="onRetry" />
  <mk-empty wx:elif="{{empty}}" icon="/assets/icons/order-sub.svg" title="{{T.c.emptyTitle}}" sub="{{T.c.emptySub}}">
    <button class="mk-btn mk-btn--md mk-empty-btn" hover-class="mk-btn--hover" bindtap="onOrders">{{T.c.backOrders}}</button>
  </mk-empty>
  <block wx:else>
    <view class="{{stFx}}"><mk-after-head title="{{head.title}}" tag="{{head.tag}}" tone="{{head.tone}}" subs="{{head.subs}}" /></view>
    <view wx:if="{{fail || sla}}" class="af-body af-top {{stFx}}">
      <mk-after-fail wx:if="{{fail}}" title="{{T.i.failTitle}}" reason="{{reason}}" fixes="{{T.i.failFixes}}" extra="{{T.i.failKeep}}" bind:call="onCall" />
      <mk-notice wx:if="{{sla}}" text="{{sla}}" />
    </view>
    <view class="af-secs {{stFx}}">
      <view wx:if="{{records.length}}" class="mk-sec">
        <view class="mk-sec__hd">{{T.i.records}}</view>
        <view wx:for="{{records}}" wx:key="id" class="iv-rec">
          <view class="mk-grow iv-rec-main">
            <view class="iv-rec-top"><text class="iv-rec-t">{{item.t}}</text><text class="mk-num iv-rec-amt">{{item.amt}}</text></view>
            <view class="iv-rec-line"><text class="mk-tag iv-rec-kind">{{item.kind}}</text><text class="mk-sub iv-rec-title">{{item.s}}</text></view>
            <text wx:if="{{item.tax}}" class="mk-sub mk-num iv-rec-s">{{item.tax}}</text>
            <text class="mk-sub iv-rec-s">{{item.email}}</text>
            <view wx:if="{{item.acts}}" class="iv-rec-acts">
              <text class="mk-link iv-rec-act" data-id="{{item.id}}" bindtap="onSend" aria-role="button">{{T.i.send}}</text>
              <text class="mk-link iv-rec-act" data-id="{{item.id}}" bindtap="onDownload" aria-role="button">{{T.i.download}}</text>
            </view>
          </view>
          <mk-after-tag text="{{item.tag}}" tone="{{item.tone}}" />
        </view>
      </view>
      <view wx:if="{{showPays}}" class="mk-sec">
        <view class="mk-sec__hd">{{T.i.payments}}</view>
        <block wx:if="{{pays.length}}">
          <view wx:for="{{pays}}" wx:key="id" class="iv-pay">
            <view hover-class="mk-tap--hover" hover-stop-propagation="{{true}}" class="iv-pay-row" bindtap="onPickPay" aria-role="button">
              <text class="mk-grow iv-pay-k">{{item.label}}</text>
              <text class="mk-num iv-pay-k">{{item.amt}}</text>
              <image wx:if="{{item.multi}}" class="mk-icon iv-pay-ico" src="{{item.on ? '/assets/icons/check-brand.svg' : '/assets/icons/chev-mute.svg'}}" />
            </view>
            <view wx:for="{{item.split}}" wx:for-item="s" wx:key="k" class="mk-between iv-split"><text class="mk-sub">{{s.k}}<text wx:if="{{s.no}}" class="iv-split-no">{{s.no}}</text></text><text class="mk-sub mk-num">{{s.a}}</text></view>
          </view>
          <view class="iv-notes"><mk-after-kv rows="{{notes}}" /></view>
        </block>
        <text wx:else class="af-rule">{{T.i.noPayments}}</text>
      </view>
      <view wx:if="{{form}}" class="mk-sec">
        <view class="mk-sec__hd">{{T.i.info}}</view>
        <mk-field label="{{T.i.kindLabel}}">
          <view class="af-seg">
            <view hover-class="mk-tap--hover" hover-stop-propagation="{{true}}" wx:for="{{form.kinds}}" wx:key="v" class="af-seg-item mk-ease {{item.on ? 'af-seg-item--on' : ''}}" data-v="{{item.v}}" bindtap="onKind" aria-role="button">{{item.t}}</view>
          </view>
        </mk-field>
        <mk-field label="{{T.i.title}}">
          <view class="af-input"><input class="af-input-el" value="{{form.title}}" placeholder="{{form.titlePh}}" placeholder-class="af-ph" maxlength="60" data-f="title" bindinput="onInput" /></view>
        </mk-field>
        <mk-field wx:if="{{form.ent}}" label="{{T.i.tax}}">
          <view class="af-input"><input class="af-input-el" value="{{form.tax}}" placeholder="{{T.i.taxPh}}" placeholder-class="af-ph" maxlength="20" data-f="tax" bindinput="onInput" /></view>
        </mk-field>
        <mk-field label="{{T.i.email}}" error="{{form.emailErr ? T.i.emailErr : ''}}">
          <view class="af-input {{form.emailErr ? 'af-input--err' : ''}}"><input class="af-input-el" value="{{form.email}}" placeholder="{{T.i.emailPh}}" placeholder-class="af-ph" maxlength="60" data-f="email" bindinput="onInput" bindblur="onEmailBlur" /></view>
        </mk-field>
        <view wx:if="{{form.ent}}" class="iv-links">
          <view hover-class="mk-tap--hover" hover-stop-propagation="{{true}}" class="iv-link" bindtap="onTitles" aria-role="button"><text class="mk-grow">{{T.i.titles}}</text><image class="mk-icon" src="/assets/icons/chev-mute.svg" /></view>
          <view hover-class="mk-tap--hover" hover-stop-propagation="{{true}}" class="iv-link" bindtap="onBatch" aria-role="button"><text class="mk-grow">{{T.i.batch}}</text><text class="mk-sub">{{T.i.batchSub}}</text><image class="mk-icon" src="/assets/icons/chev-mute.svg" /></view>
        </view>
      </view>
      <view wx:if="{{file.length}}" class="mk-sec">
        <view class="mk-sec__hd">{{T.i.file}}</view>
        <mk-after-kv rows="{{file}}" />
      </view>
    </view>
  <view wx:if="{{bar}}" class="mk-bottom-bar af-bar">
    <view wx:if="{{bar.lab}}" class="af-bar-info">
      <text class="mk-mute">{{bar.lab}}</text>
      <text class="mk-num af-bar-amt {{bar.muted ? 'af-bar-amt--muted' : ''}}">{{bar.amt}}</text>
    </view>
    <button wx:for="{{bar.btns}}" wx:key="text" class="mk-btn af-bar-btn {{item.kind === 'ghost' ? 'mk-btn--ghost' : ''}} {{item.off ? 'mk-btn--disabled' : ''}} af-btn--{{item.kind}}" hover-class="{{item.off ? 'none' : item.kind === 'ghost' ? 'mk-btn--ghostHover' : item.kind === 'neutral' ? 'mk-btn--plainHover' : item.kind === 'danger' ? 'mk-btn--dimHover' : 'mk-btn--hover'}}" loading="{{item.loading}}" disabled="{{item.off}}" data-act="{{item.act}}" bindtap="onBar">{{item.text}}</button>
  </view>
    <mk-sheet visible="{{sheet}}" title="{{T.i.pickPayment}}" bind:close="onSheetClose">
      <view hover-class="mk-tap--hover" hover-stop-propagation="{{true}}" wx:for="{{opts}}" wx:key="id" class="iv-opt {{item.on ? 'iv-opt--on' : ''}}" data-id="{{item.id}}" bindtap="onOpt" aria-role="button">
        <text class="mk-grow">{{item.label}}</text><text class="mk-num iv-opt-amt">{{item.amt}}</text>
        <image wx:if="{{item.on}}" class="mk-icon" src="/assets/icons/check-brand.svg" />
      </view>
      <view class="iv-acts">
        <button class="mk-btn af-btn--neutral iv-act" hover-class="mk-btn--plainHover" bindtap="onSheetClose">{{T.z.cancel}}</button>
        <button class="mk-btn iv-act" hover-class="mk-btn--hover" bindtap="onSheetOk">{{T.z.confirm}}</button>
      </view>
    </mk-sheet>
  </block>
</view>
