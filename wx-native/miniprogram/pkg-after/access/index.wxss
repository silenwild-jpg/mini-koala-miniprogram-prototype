@import "../after.wxss";
/* —— 入仓指引页 —— */
.ac-top { padding-top: var(--mk-space-3); }
.ac-card { margin-top: var(--mk-space-cardGap); }
.ac-headrow { margin-bottom: var(--mk-space-1); }
.ac-guide { min-height: 64rpx; flex: none; }
.ac-row { display: flex; align-items: flex-start; padding: var(--mk-space-3) 0; border-bottom: var(--mk-border-hairline); }
.ac-k { width: 140rpx; flex: none; color: var(--mk-color-ink-secondary); margin-right: var(--mk-space-3); }
.ac-v { flex: 1; min-width: 0; line-height: var(--mk-font-lineHeight-loose); }
.ac-v--key { font-weight: var(--mk-font-weight-medium); }
.ac-sub { display: block; margin: var(--mk-space-3) 0 var(--mk-space-2); }
.ac-step { display: flex; align-items: flex-start; padding: var(--mk-space-1) 0; }
.ac-n { width: 40rpx; height: 40rpx; flex: none; margin-right: var(--mk-space-2); border-radius: 50%; background: var(--mk-color-brand-tint); color: var(--mk-color-brand-text); font-size: var(--mk-font-size-sm); display: flex; align-items: center; justify-content: center; }
.ac-path { display: block; line-height: var(--mk-font-lineHeight-loose); }
.ac-facts { display: flex; flex-wrap: wrap; margin-top: var(--mk-space-3); }
.ac-fact { display: flex; align-items: center; height: var(--mk-size-chipHeight); padding: 0 var(--mk-space-2); margin: 0 var(--mk-space-2) var(--mk-space-2) 0; border-radius: var(--mk-radius-control); background: var(--mk-color-canvas-sunken); }
.ac-fact-v { margin-left: var(--mk-space-1); font-size: var(--mk-font-size-sm); font-weight: var(--mk-font-weight-medium); }
.mk-btn.mk-btn.ac-nav { margin-top: var(--mk-space-3); width: 100%; }
.ac-nav-ico { margin-right: var(--mk-space-1); }
