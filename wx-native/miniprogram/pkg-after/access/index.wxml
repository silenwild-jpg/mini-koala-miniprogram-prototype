<view class="mk-page mk-page--plain {{bar ? 'af-pad' : ''}}">
  <view wx:if="{{sys === 'loading'}}" class="af-body af-loading"><mk-sys-state type="loading" skeleton="{{3}}" /></view>
  <mk-sys-state wx:elif="{{sys}}" type="{{sys}}" bind:retry="onRetry" />
  <mk-empty wx:elif="{{empty}}" icon="/assets/icons/door-ink.svg" title="{{T.x.emptyTitle}}" sub="{{T.x.emptySub}}">
    <button class="mk-btn mk-btn--md mk-empty-btn" hover-class="mk-btn--hover" bindtap="onOrders">{{T.x.viewOrders}}</button>
  </mk-empty>
  <block wx:else>
    <mk-after-head title="{{head.title}}" tag="{{head.tag}}" tone="{{head.tone}}" subs="{{head.subs}}" />
    <view class="af-body af-top">
      <mk-notice wx:if="{{note}}" text="{{note}}" tone="warn" />
      <mk-notice wx:if="{{overdue}}" text="{{overdue}}" tone="warn" link="{{T.c.callStore}}" bind:link="onCall" />
      <mk-order-card order="{{order}}" mode="brief" />
    </view>
    <view class="af-secs">
      <view wx:if="{{showArrival && arr}}" class="mk-sec">
        <view class="mk-sec__hd ac-headrow">
          <text>{{T.x.arrival}}</text>
          <view hover-class="mk-tap--hover" hover-stop-propagation="{{true}}" class="mk-row ac-guide" bindtap="onStoreGuide" aria-role="link"><text class="mk-link">{{T.x.storeGuide}}</text><image class="mk-icon" src="/assets/icons/chev-brand.svg" /></view>
        </view>
        <view class="{{arr.rows.length > 2 ? 'ac-rows--lined' : ''}}">
          <view wx:for="{{arr.rows}}" wx:key="k" class="ac-row">
            <text class="ac-k">{{item.k}}</text>
            <text class="ac-v {{item.key ? 'ac-v--key' : ''}}">{{item.v}}</text>
          </view>
        </view>
        <block wx:if="{{arr.steps.length || arr.path}}">
          <text class="mk-sub ac-sub">{{T.x.path}}</text>
          <view wx:for="{{arr.steps}}" wx:key="n" class="ac-step"><text class="mk-num ac-n">{{item.n}}</text><text class="mk-grow">{{item.t}}</text></view>
          <text wx:if="{{arr.path && !arr.steps.length}}" class="ac-path">{{arr.path}}</text>
        </block>
        <view wx:if="{{arr.facts.length}}" class="ac-facts">
          <view wx:for="{{arr.facts}}" wx:key="k" class="ac-fact"><text class="mk-sub">{{item.k}}</text><text class="ac-fact-v">{{item.v}}</text></view>
        </view>
        <button class="mk-btn mk-btn--ghost mk-btn--md ac-nav" hover-class="mk-btn--ghostHover" bindtap="onNavigate"><image class="mk-icon ac-nav-ico" src="/assets/icons/nav-brand.svg" />{{T.x.navigate}}</button>
      </view>
      <view class="mk-sec">
        <view class="mk-sec__hd">{{T.x.stepsTitle}}</view>
        <mk-after-steps steps="{{steps}}" />
        <mk-notice wx:if="{{before}}" title="{{T.x.beforeTitle}}" text="{{T.x.beforeText}}" />
      </view>
    </view>
    <view wx:if="{{bar}}" class="mk-bottom-bar af-bar">
      <button wx:for="{{bar.btns}}" wx:key="text" class="mk-btn af-bar-btn {{item.kind === 'ghost' ? 'mk-btn--ghost' : ''}}" hover-class="{{item.kind === 'ghost' ? 'mk-btn--ghostHover' : 'mk-btn--hover'}}" data-act="{{item.act}}" bindtap="onBar">{{item.text}}</button>
    </view>
  </block>
  <mk-login-sheet visible="{{loginVisible}}" bind:close="onLoginClose" bind:success="onLoginSuccess" />
</view>
