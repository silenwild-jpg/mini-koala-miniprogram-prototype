/* 租后各页共用的页面样式：各页 wxss 第一行 @import "../after.wxss"。 */
.af-body { padding: 0 var(--mk-space-pageGutter); }
.af-pad { padding-bottom: calc(220rpx + env(safe-area-inset-bottom)); }
.af-sec { display: block; margin-bottom: var(--mk-space-2); }
.af-gap { margin-bottom: var(--mk-space-cardGap); }
.af-rule { display: block; color: var(--mk-color-ink-secondary); font-size: var(--mk-font-size-sm); margin-top: var(--mk-space-2); line-height: var(--mk-font-lineHeight-loose); }
.af-bar { display: flex; align-items: center; }
.af-bar-info { flex: 1; min-width: 0; margin-right: var(--mk-space-3); display: flex; flex-direction: column; }
.af-bar-amt { font-size: var(--mk-font-size-2xl); font-weight: var(--mk-font-weight-bold); line-height: var(--mk-font-lineHeight-tight); }
.af-bar-amt--muted { font-size: var(--mk-font-size-md); font-weight: var(--mk-font-weight-regular); color: var(--mk-color-ink-secondary); }
.mk-btn.mk-btn.af-bar-btn { flex: 1; min-width: 0; width: auto; }
.af-bar-btn + .mk-btn.mk-btn.af-bar-btn { margin-left: var(--mk-space-3); }
.af-bar-info + .mk-btn.mk-btn.af-bar-btn { flex: none; width: auto; min-width: 280rpx; }
.af-btn--neutral { background: var(--mk-color-canvas-card); color: var(--mk-color-ink-primary); border: var(--mk-border-strong); }
.af-btn--danger { background: var(--mk-color-canvas-card); color: var(--mk-color-status-errorText); border: var(--mk-border-error); }
.af-acts { margin-top: var(--mk-space-4); }
.af-acts .mk-btn { width: 100%; }
.af-acts .mk-btn + .mk-btn { margin-top: var(--mk-space-2); }
/* 表单输入与分段选择（退仓、发票、实名） */
.af-input { display: flex; align-items: center; justify-content: space-between; height: var(--mk-size-inputHeight); padding: 0 var(--mk-space-3); border: var(--mk-border-strong); border-radius: var(--mk-radius-control); background: var(--mk-color-canvas-card); box-sizing: border-box; }
.af-input--err { border: var(--mk-border-error); }
.af-input-el { flex: 1; min-width: 0; height: 100%; font-size: var(--mk-font-size-lg); }
.af-ph { color: var(--mk-color-ink-tertiary); }
.af-seg { display: flex; padding: 6rpx; border-radius: var(--mk-radius-control); background: var(--mk-color-canvas-sunken); }
.af-seg-item { flex: 1; height: 72rpx; display: flex; align-items: center; justify-content: center; border-radius: var(--mk-radius-control); color: var(--mk-color-ink-secondary); }
.af-seg-item--on { background: var(--mk-color-canvas-card); color: var(--mk-color-brand-text); font-weight: var(--mk-font-weight-medium); }
.af-loading { padding-top: var(--mk-space-3); }
/* 页面正文末尾的次要文字操作（如「撤回退仓申请」） */
.af-alt { display: flex; justify-content: center; border-top: 16rpx solid var(--mk-color-canvas-sunken); }
.af-altbtn { padding: var(--mk-space-3) var(--mk-space-4); color: var(--mk-color-ink-secondary); border-radius: var(--mk-radius-control); }
/* IMPL-01 去卡片化：租后各页白底（页面根节点 mk-page--plain）。订单卡是可点的独立对象，保留卡片；进度、键值、表单、费用改成通栏小节（app.wxss mk-sec），
   小节之间用 16rpx 浅灰分区带，不再每段包一张卡。af-top = 状态头下方的提示条与订单卡；af-secs = 其后的小节序列。 */
.af-top { padding-top: var(--mk-space-1); padding-bottom: var(--mk-space-1); }
.af-secs .mk-sec { border-top: 16rpx solid var(--mk-color-canvas-sunken); }
.af-secs .mk-sec__hd { margin-bottom: var(--mk-space-2); }
.af-hd-tag { flex: none; margin-left: var(--mk-space-2); }
.af-foot { padding: var(--mk-space-3) var(--mk-space-pageGutter); border-top: 16rpx solid var(--mk-color-canvas-sunken); }
/* 底栏金额上方的说明行：文字 + 折扣标签（续租沿用原折扣） */
.af-bar-lab { display: flex; align-items: center; }
.af-bar-tag { margin-left: var(--mk-space-2); margin-right: 0; }
