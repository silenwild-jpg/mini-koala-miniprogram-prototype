/* —— 租后各页共用的页面样式（每页各带一份） —— */
.af-body { padding: 0 var(--mk-space-pageGutter); }
.af-pad { padding-bottom: calc(220rpx + env(safe-area-inset-bottom)); }
.af-sec { display: block; margin-bottom: var(--mk-space-2); }
.af-gap { margin-bottom: var(--mk-space-cardGap); }
.af-empty { display: flex; flex-direction: column; align-items: center; text-align: center; padding: var(--mk-space-10) var(--mk-space-5); }
.af-empty-ico { width: 96rpx; height: 96rpx; margin-bottom: var(--mk-space-3); }
.af-empty-sub { margin: var(--mk-space-2) 0 var(--mk-space-5); }
.af-rule { display: block; color: var(--mk-color-ink-secondary); font-size: var(--mk-font-size-sm); margin-top: var(--mk-space-2); line-height: var(--mk-font-lineHeight-loose); }
.af-bar { display: flex; align-items: center; }
.af-bar-info { flex: 1; min-width: 0; margin-right: var(--mk-space-3); display: flex; flex-direction: column; }
.af-bar-amt { font-size: var(--mk-font-size-2xl); font-weight: var(--mk-font-weight-bold); line-height: var(--mk-font-lineHeight-tight); }
.af-bar-amt--muted { font-size: var(--mk-font-size-md); font-weight: var(--mk-font-weight-regular); color: var(--mk-color-ink-secondary); }
.mk-btn.mk-btn.af-bar-btn { flex: 1; min-width: 0; width: auto; }
.af-bar-btn + .mk-btn.mk-btn.af-bar-btn { margin-left: var(--mk-space-3); }
.af-bar-info + .mk-btn.mk-btn.af-bar-btn { flex: none; width: auto; min-width: 280rpx; }
.af-btn--neutral { background: var(--mk-color-canvas-card); color: var(--mk-color-ink-primary); border: var(--mk-border-strong); }
.af-btn--danger { background: var(--mk-color-canvas-card); color: var(--mk-color-status-errorText); border: var(--mk-border-error); }
.af-acts { margin-top: var(--mk-space-4); }
.af-acts .mk-btn { width: 100%; }
.af-acts .mk-btn + .mk-btn { margin-top: var(--mk-space-2); }
.af-fee-row { display: flex; align-items: center; justify-content: space-between; padding: var(--mk-space-2) 0; }
.af-fee-k { display: flex; align-items: center; flex-wrap: wrap; min-width: 0; }
.af-fee-sub { color: var(--mk-color-ink-secondary); font-size: var(--mk-font-size-sm); margin-left: var(--mk-space-2); }
.af-disc { margin-left: var(--mk-space-2); margin-right: 0; }
.af-amt { font-weight: var(--mk-font-weight-semibold); flex: none; margin-left: var(--mk-space-3); }
.af-amt--muted { font-weight: var(--mk-font-weight-regular); color: var(--mk-color-ink-tertiary); }
.af-amt--strike { text-decoration: line-through; }
.af-fee-sec { display: block; color: var(--mk-color-ink-secondary); font-size: var(--mk-font-size-sm); margin-bottom: var(--mk-space-1); }
.af-total { display: flex; align-items: center; justify-content: space-between; margin-top: var(--mk-space-2); padding-top: var(--mk-space-3); border-top: var(--mk-border-hairline); font-weight: var(--mk-font-weight-semibold); }
.af-total-amt { font-size: var(--mk-font-size-xl); }
/* —— 续租页 —— */
.rn-top { margin-top: var(--mk-space-cardGap); }
.rn-stepper { display: flex; align-items: center; border: var(--mk-border-strong); border-radius: var(--mk-radius-control); }
.rn-step { width: 72rpx; height: 68rpx; display: flex; align-items: center; justify-content: center; font-size: var(--mk-font-size-xl); color: var(--mk-color-brand-text); }
.rn-step--off { color: var(--mk-color-ink-tertiary); }
.rn-stepval { min-width: 128rpx; height: 68rpx; line-height: 68rpx; text-align: center; border-left: var(--mk-border-strong); border-right: var(--mk-border-strong); }
.rn-chips { display: flex; flex-wrap: wrap; margin-top: var(--mk-space-3); }
.rn-chip { margin-right: var(--mk-space-2); }
.rn-hint { display: block; margin-top: var(--mk-space-2); color: var(--mk-color-accent-promoText); font-size: var(--mk-font-size-sm); }
.rn-keep { margin: var(--mk-space-3) 0 var(--mk-space-1); padding: var(--mk-space-2) var(--mk-space-3); border-radius: var(--mk-radius-control); background: var(--mk-color-accent-promoFill); color: var(--mk-color-accent-promoText); font-size: var(--mk-font-size-sm); line-height: var(--mk-font-lineHeight-loose); }
.rn-alt { display: flex; justify-content: center; }
.rn-altbtn { padding: var(--mk-space-3) var(--mk-space-4); color: var(--mk-color-ink-secondary); }
.rn-sub { display: flex; align-items: center; margin-top: var(--mk-space-2); }
.rn-subbtn { padding: var(--mk-space-2) var(--mk-space-3); font-size: var(--mk-font-size-md); }
