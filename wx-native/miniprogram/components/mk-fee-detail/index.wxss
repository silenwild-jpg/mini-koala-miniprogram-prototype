/* IMPL-01：每行三段——名称、说明（单价 × 月数、折扣标签、选择入口）、金额；金额靠右单列。行间不画线，合计行用留白与字号区分。 */
.fd-card { margin-bottom: var(--mk-space-cardGap); }
.fd-title { margin-bottom: var(--mk-space-2); }
.fd-item { padding: var(--mk-space-2) 0; }
.fd-line { display: flex; align-items: center; min-height: 48rpx; }
.fd-k { flex: none; min-width: 140rpx; margin-right: var(--mk-space-2); }
.fd-mid { flex: 1; min-width: 0; display: flex; align-items: center; flex-wrap: wrap; }
.fd-sub { margin-right: var(--mk-space-2); color: var(--mk-color-ink-secondary); font-size: var(--mk-font-size-xs); }
.fd-tag { margin-right: var(--mk-space-2); }
.fd-link { min-height: 64rpx; margin: -8rpx 0; padding-right: var(--mk-space-2); display: inline-flex; align-items: center; border-radius: var(--mk-radius-control); }
.fd-chev { margin-left: 4rpx; }
.fd-amt { margin-left: var(--mk-space-2); text-align: right; flex: none; max-width: 56%; font-weight: var(--mk-font-weight-medium); }
.fd-muted { color: var(--mk-color-ink-secondary); font-weight: var(--mk-font-weight-regular); font-size: var(--mk-font-size-sm); }
.fd-good { color: var(--mk-color-brand-text); }
.fd-sec { margin-top: 4rpx; color: var(--mk-color-ink-secondary); font-size: var(--mk-font-size-xs); line-height: var(--mk-font-lineHeight-loose); }
.fd-total { margin-top: var(--mk-space-3); padding: var(--mk-space-3); border-radius: var(--mk-radius-thumb); background: var(--mk-color-canvas-sunken); }
.fd-tl { font-size: var(--mk-font-size-md); font-weight: var(--mk-font-weight-semibold); }
.fd-tamt { font-size: var(--mk-font-size-2xl); font-weight: var(--mk-font-weight-bold); line-height: var(--mk-font-lineHeight-tight); }
.fd-tmuted { color: var(--mk-color-ink-secondary); font-weight: var(--mk-font-weight-medium); }
.fd-note { margin-top: var(--mk-space-3); color: var(--mk-color-ink-secondary); font-size: var(--mk-font-size-xs); line-height: var(--mk-font-lineHeight-loose); }
