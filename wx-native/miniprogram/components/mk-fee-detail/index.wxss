.fd-card { margin-bottom: var(--mk-space-cardGap); }
.fd-title { margin-bottom: var(--mk-space-2); }
.fd-item { padding: var(--mk-space-2) 0; }
.fd-k { display: flex; align-items: center; flex-wrap: wrap; min-width: 0; }
.fd-sub { margin-left: var(--mk-space-2); color: var(--mk-color-ink-secondary); font-size: var(--mk-font-size-xs); }
.fd-tag { margin-left: var(--mk-space-2); margin-right: 0; }
.fd-link { margin-left: var(--mk-space-2); min-height: 64rpx; display: inline-flex; align-items: center; }
.fd-amt { margin-left: var(--mk-space-3); text-align: right; flex: none; max-width: 60%; }
.fd-muted { color: var(--mk-color-ink-secondary); }
.fd-good { color: var(--mk-color-brand-text); }
.fd-sec { margin-top: 4rpx; padding-left: var(--mk-space-3); color: var(--mk-color-ink-secondary); font-size: var(--mk-font-size-sm); }
.fd-total { margin-top: var(--mk-space-2); padding-top: var(--mk-space-3); border-top: var(--mk-border-hairline); }
.fd-tl { font-size: var(--mk-font-size-lg); font-weight: var(--mk-font-weight-semibold); }
.fd-tamt { font-size: var(--mk-font-size-2xl); font-weight: var(--mk-font-weight-bold); }
.fd-tmuted { color: var(--mk-color-ink-secondary); font-weight: var(--mk-font-weight-medium); }
.fd-note { margin-top: var(--mk-space-3); color: var(--mk-color-ink-secondary); font-size: var(--mk-font-size-xs); line-height: var(--mk-font-lineHeight-loose); }
