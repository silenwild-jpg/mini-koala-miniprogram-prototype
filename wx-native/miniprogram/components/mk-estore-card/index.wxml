<!-- IMPL-01 M-07：考拉E存入口重新设计为一条品牌色横幅（与门店卡区分开：它是另一种服务，不是一家门店）。文字沿用原有的，不新编套餐与价格。 -->
<view hover-class="mk-press--hover" hover-stop-propagation="{{true}}" class="ec-card mk-press" bindtap="onTap" aria-role="button">
  <view class="ec-ic"><image class="mk-icon mk-icon--md" src="/assets/icons/truck-brand.svg" /></view>
  <view class="mk-grow ec-main">
    <view class="mk-row"><text class="ec-t">{{name}}</text><text class="ec-k">{{kicker}}</text></view>
    <text wx:if="{{sub}}" class="ec-s">{{sub}}</text>
  </view>
  <text class="ec-go">{{link}}</text>
</view>
