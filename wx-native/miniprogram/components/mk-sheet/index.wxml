<view wx:if="{{show}}" class="sh-sheet-root" catchtouchmove="noop">
  <view class="sh-scrim {{open ? 'sh-scrim--on' : ''}}" bindtap="onMask"></view>
  <view class="sh-panel {{open ? 'sh-panel--on' : ''}}">
    <view class="sh-head mk-between">
      <text class="mk-title">{{title}}</text>
      <view hover-class="mk-tap--hover" hover-stop-propagation="{{true}}" class="sh-close" bindtap="onClose" aria-role="button" aria-label="关闭"><image class="mk-icon" src="/assets/icons/close-sub.svg" /></view>
    </view>
    <view class="sh-body"><slot></slot></view>
  </view>
</view>
