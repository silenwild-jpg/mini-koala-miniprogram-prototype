<view wx:if="{{v}}" class="mk-card oc-card {{dead ? 'oc-off' : ''}}">
  <block wx:if="{{variant === 'list'}}">
    <view class="oc-row">
      <view class="oc-ph"><image class="mk-icon mk-icon--md" src="/assets/icons/store-brand.svg" /></view>
      <view class="mk-grow">
        <view class="mk-title mk-ellipsis">{{v.storeName}}</view>
        <view class="mk-sub mk-ellipsis oc-line2">{{v.noText}}</view>
      </view>
      <text wx:if="{{v.stageLabel}}" class="oc-tag oc-tag--{{v.stageTone}}">{{v.stageLabel}}</text>
    </view>
    <view class="oc-bot mk-between">
      <view class="mk-sub mk-ellipsis mk-grow">{{v.lineText}}</view>
      <text class="mk-num oc-amt">{{v.payableText}}</text>
    </view>
  </block>
  <block wx:else>
    <view wx:if="{{dead}}" class="mk-title oc-sec">{{T.origin}}</view>
    <view class="oc-row">
      <view class="oc-ph"><image class="mk-icon mk-icon--md" src="/assets/icons/store-brand.svg" /></view>
      <view class="mk-grow">
        <view class="mk-title mk-ellipsis">{{v.storeName}}</view>
        <view class="oc-line2 oc-meta"><text wx:if="{{v.kmText}}" class="oc-km">{{v.kmText}}</text><view class="mk-sub mk-ellipsis mk-grow">{{v.address}}</view></view>
      </view>
    </view>
    <view class="oc-row oc-unit">
      <view class="oc-ph"><image class="mk-icon mk-icon--md" src="/assets/icons/cube-brand.svg" /></view>
      <view class="mk-grow">
        <view class="mk-title mk-ellipsis">{{v.unitName}}</view>
        <view class="mk-sub oc-line2">{{v.unitSub}}</view>
        <text wx:if="{{v.comboTag}}" class="mk-tag oc-combo">{{v.comboTag}}</text>
      </view>
      <view hover-class="mk-tap--hover" hover-stop-propagation="{{true}}" wx:if="{{swap}}" class="mk-link oc-swap" bindtap="onSwap" aria-role="button">{{swap}}</view>
    </view>
    <view class="oc-kv mk-between">
      <text class="mk-sub">{{T.term}}</text>
      <view wx:if="{{editable}}" class="oc-stepper">
        <view hover-class="mk-tap--hover" hover-stop-propagation="{{true}}" class="oc-step {{canMinus ? '' : 'oc-step--off'}}" bindtap="onMinus" aria-role="button" aria-label="减少">−</view>
        <text class="oc-stepval">{{v.termText}}</text>
        <view hover-class="mk-tap--hover" hover-stop-propagation="{{true}}" class="oc-step {{canPlus ? '' : 'oc-step--off'}}" bindtap="onPlus" aria-role="button" aria-label="增加">+</view>
      </view>
      <text wx:else class="oc-val">{{v.termText}}</text>
    </view>
    <view wx:if="{{hint}}" class="oc-hint">{{hint}}</view>
    <view class="oc-kv mk-between">
      <text class="mk-sub">{{v.periodLabel}}</text>
      <picker wx:if="{{editable}}" mode="date" value="{{v.startDate}}" start="{{startMin}}" end="{{startMax}}" bindchange="onDate">
        <view class="oc-date"><text class="{{v.startDate ? '' : 'oc-dateph'}}">{{v.startDate || T.pickDate}}</text><image class="mk-icon oc-cal" src="/assets/icons/cal-ink.svg" /></view>
      </picker>
      <text wx:else class="oc-val">{{v.periodText}}</text>
    </view>
  </block>
</view>
