/* IMPL-01：卡内不用分割线，分组靠留白与浅灰底块；仓位编号是标签（app.wxss mk-unitno），与容量同一行；金额单列。 */
.oc-card { margin-bottom: var(--mk-space-cardGap); }
.oc-off { opacity: 0.72; }
.oc-sec { margin-bottom: var(--mk-space-3); }
.oc-row { display: flex; align-items: center; }
.oc-main { min-width: 0; }
.oc-namerow { display: flex; align-items: center; }
.oc-ph { width: 112rpx; height: 112rpx; border-radius: var(--mk-radius-thumb); background: var(--mk-color-brand-tint); display: flex; align-items: center; justify-content: center; flex: none; margin-right: var(--mk-space-3); }
.oc-unitline { display: flex; align-items: center; flex-wrap: wrap; margin-top: 12rpx; }
.oc-no { margin-right: var(--mk-space-2); }
.oc-vol { font-size: var(--mk-font-size-md); font-weight: var(--mk-font-weight-medium); }
.oc-vol--lg { font-size: var(--mk-font-size-lg); font-weight: var(--mk-font-weight-semibold); }
.oc-line2 { display: block; margin-top: 8rpx; }
.oc-line3 { margin-top: 4rpx; }
.oc-meta { display: flex; align-items: center; margin-top: 8rpx; }
.oc-pin { flex: none; margin-right: 6rpx; }
.oc-km { flex: none; font-size: var(--mk-font-size-sm); margin-right: 12rpx; white-space: nowrap; }
.oc-combo { margin-right: 0; }
.oc-unit { display: flex; align-items: center; margin-top: var(--mk-space-3); padding: var(--mk-space-3); border-radius: var(--mk-radius-thumb); background: var(--mk-color-canvas-sunken); }
.oc-unit .oc-unitline { margin-top: 0; }
.oc-swap { flex: none; min-height: 64rpx; padding-left: var(--mk-space-3); display: flex; align-items: center; white-space: nowrap; }
.oc-swapchev { margin-left: 4rpx; }
.oc-kv { min-height: 72rpx; margin-top: var(--mk-space-3); box-sizing: border-box; }
.oc-val { font-weight: var(--mk-font-weight-medium); text-align: right; }
.oc-hint { margin-top: var(--mk-space-2); color: var(--mk-color-accent-promoText); font-size: var(--mk-font-size-sm); }
.oc-stepper { display: flex; align-items: center; border: var(--mk-border-strong); border-radius: var(--mk-radius-control); height: 72rpx; }
.oc-step { width: 76rpx; height: 72rpx; display: flex; align-items: center; justify-content: center; color: var(--mk-color-brand-text); font-size: var(--mk-font-size-xl); }
.oc-step--off { color: var(--mk-color-ink-tertiary); }
.oc-stepval { min-width: 124rpx; height: 72rpx; display: flex; align-items: center; justify-content: center; border-left: var(--mk-border-strong); border-right: var(--mk-border-strong); font-weight: var(--mk-font-weight-medium); }
.oc-date { display: flex; align-items: center; justify-content: space-between; min-width: 300rpx; height: 72rpx; padding: 0 var(--mk-space-3); border: var(--mk-border-strong); border-radius: var(--mk-radius-control); box-sizing: border-box; }
.oc-note { margin-top: var(--mk-space-2); color: var(--mk-color-ink-secondary); font-size: var(--mk-font-size-xs); }
.oc-dateph { color: var(--mk-color-ink-tertiary); }
.oc-cal { margin-left: var(--mk-space-2); }
/* 列表卡：租期与起止日一行；订单号、日期小字在左，金额在右单列 */
.oc-span { display: flex; align-items: baseline; margin-top: var(--mk-space-3); }
.oc-spanterm { flex: none; margin-right: var(--mk-space-2); font-weight: var(--mk-font-weight-medium); }
.oc-foot { display: flex; align-items: flex-end; margin-top: var(--mk-space-2); }
.oc-footl { min-width: 0; }
.oc-amt { flex: none; font-size: var(--mk-font-size-xl); font-weight: var(--mk-font-weight-bold); line-height: var(--mk-font-lineHeight-tight); margin-left: var(--mk-space-3); white-space: nowrap; }
/* REVIEW-02 E2-09：列表卡状态标签改用全站公共类 mk-tag mk-tag--ok/warn/err/info mk-tag--end（app.wxss），这里只保留不换行 */
.oc-tag { white-space: nowrap; }
/* REVIEW-02 C2-14：列表卡店名最多两行（标签较长时不再把店名截成看不出是哪家店）；标签贴第一行 */
.oc-namerow { align-items: flex-start; }
.oc-name2 { min-width: 0; display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow: hidden; word-break: break-all; }
/* REVIEW-02 C2-13：已取消 / 已超时的列表卡金额减淡 */
.oc-amt--off { color: var(--mk-color-ink-secondary); font-weight: var(--mk-font-weight-regular); }
.oc-img { display: block; background: var(--mk-color-canvas-sunken); }
/* IMPL-02 M-28 紧凑摘要（mode="brief"）：浅灰底块不描边，三行：店名、编号标签 + 容量、起止日期 */
.oc-brief { margin-bottom: var(--mk-space-cardGap); padding: var(--mk-space-3); border-radius: var(--mk-radius-thumb); background: var(--mk-color-canvas-sunken); }
.oc-brief .oc-brief-line { margin-top: var(--mk-space-2); }
.oc-brief .oc-no { margin-top: 4rpx; margin-bottom: 4rpx; }
.oc-brief-span { margin-top: var(--mk-space-2); }
