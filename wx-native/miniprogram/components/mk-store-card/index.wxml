<!-- IMPL-02：仓位行的编号用 mk-unitno 标签（组合仓每个编号一个），容量跟在后面，与订单卡同一写法；满额减是价格次行后的优惠标签。 -->
<!-- IMPL-01 门店卡骨架（四种形态同一套）：图（角标压在图左上）｜店名 → 距离 · 区名 · 商圈 → 标签一行；发丝线下：规格在左、价格独立在右（或价格 + 按钮）。 -->
<view class="mk-card sc-card mk-press {{variant === 'compact' ? 'sc-card--compact' : ''}} {{enterCls}}" hover-class="mk-press--hover">
  <view hover-class="mk-tap--hover" hover-stop-propagation="{{true}}" class="sc-head" bindtap="onStore" aria-role="button" aria-label="{{card.name}}，查看门店和全部仓位">
    <view wx:if="{{card.photo}}" class="sc-pic">
      <image class="sc-photo" src="{{card.photo}}" mode="aspectFill" />
      <text wx:if="{{card.rankTag}}" class="mk-corner {{card.rankKind === 'price' ? 'mk-corner--price' : ''}}">{{card.rankTag}}</text>
    </view>
    <view class="mk-grow sc-info">
      <text class="mk-title mk-ellipsis sc-name">{{card.name}}</text>
      <view class="sc-loc">
        <text wx:if="{{card.kmText}}" class="mk-num sc-km">{{card.kmText}}</text>
        <text wx:if="{{card.kmText && place}}" class="sc-dot"> · </text>
        <text class="mk-ellipsis mk-grow sc-place">{{place}}</text>
      </view>
      <view wx:if="{{(card.rankTag && !card.photo) || card.lowText || visibleTags.length}}" class="sc-tags">
        <text wx:if="{{card.rankTag && !card.photo}}" class="mk-tag mk-tag--brand">{{card.rankTag}}</text>
        <text wx:if="{{card.lowText}}" class="mk-tag mk-tag--warn">{{card.lowText}}</text>
        <text wx:for="{{visibleTags}}" wx:key="t" class="mk-tag {{item.promo ? 'mk-tag--promo' : ''}}">{{item.t}}</text>
      </view>
    </view>
  </view>

  <!-- 一行收尾：紧凑卡，或没有仓位行的浏览卡 / 该店无匹配。左：规格或可租容量；右：价格单列 -->
  <view wx:if="{{variant === 'compact' || lines.length === 0}}" class="mk-between sc-foot" bindtap="onStore">
    <view wx:if="{{variant === 'compact' && card.row}}" class="sc-spec">
      <text class="mk-sub sc-lab">{{T.matched}}</text><text class="sc-uname">{{card.row.volText}}</text>
      <text wx:if="{{card.row.combo}}" class="mk-tag sc-tier">{{card.row.comboTag}}</text>
      <text wx:if="{{card.nearText}}" class="mk-tag mk-tag--promo sc-tier">{{card.nearText}}</text>
    </view>
    <text wx:elif="{{card.emptyText}}" class="mk-sub mk-grow">{{card.emptyText}}</text>
    <view wx:elif="{{variant !== 'plain'}}" class="sc-spec"><text class="mk-sub sc-lab">{{T.range}}</text><text class="sc-uname">{{card.rangeText}}</text></view>
    <view wx:else class="mk-grow"></view>
    <view class="mk-row sc-fr">
      <view wx:if="{{variant === 'compact' && card.row}}" class="sc-cprice">
        <view class="{{bump}}"><mk-price amount="{{card.row.price.amount}}" unit="{{card.row.price.unit}}" size="sm" /></view>
        <text wx:if="{{card.row.totalText}}" class="mk-mute sc-ctotal">{{card.row.totalText}}</text>
      </view>
      <block wx:elif="{{!card.emptyText}}">
        <mk-price wx:if="{{card.fromPrice}}" amount="{{card.fromPrice}}" unit="{{T.cubic}}" size="sm" />
        <text wx:else class="mk-sub">{{T.none}}</text>
      </block>
      <image class="mk-icon sc-chev" src="/assets/icons/chev-mute.svg" />
    </view>
  </view>

  <block wx:else>
    <view wx:for="{{lines}}" wx:key="id" class="sc-line {{index > 0 ? 'sc-line--alt' : ''}}">
      <view class="sc-unit">
        <text wx:if="{{item.combo}}" class="mk-tag mk-tag--brand sc-ctag">{{item.comboTag}}</text>
        <block wx:if="{{item.codeList.length}}"><text wx:for="{{item.codeList}}" wx:for-item="c" wx:key="*this" class="mk-unitno sc-no">{{c}}</text><text class="mk-num sc-vol">{{item.volText}}</text></block>
        <text wx:else class="sc-uname">{{item.name}}</text>
        <text wx:if="{{item.bigTag}}" class="mk-tag sc-tier">{{item.bigTag}}</text>
        <text wx:if="{{item.nearText}}" class="mk-tag mk-tag--promo sc-tier">{{item.nearText}}</text>
        <text wx:if="{{item.diffText}}" class="mk-sub sc-diff">{{item.diffText}}</text>
      </view>
      <view class="mk-between sc-buy">
        <view class="mk-grow" data-i="{{index}}" bindtap="onPrice">
          <view class="{{bump}}"><mk-price amount="{{item.price.amount}}" unit="{{item.price.unit}}" discount="{{item.price.discount}}" /></view>
          <view wx:if="{{item.price.sub || item.price.off}}" class="sc-subline"><text wx:if="{{item.price.sub}}" class="mk-sub sc-sub">{{item.price.sub}}</text><text wx:if="{{item.price.off}}" class="mk-tag mk-tag--promo mk-num sc-off">{{item.price.off}}</text></view>
        </view>
        <button class="mk-btn mk-btn--md sc-cta {{item.secondary ? 'mk-btn--ghost' : ''}}" hover-class="{{item.secondary ? 'mk-btn--ghostHover' : 'mk-btn--hover'}}" hover-stop-propagation="{{true}}" data-i="{{index}}" bindtap="onAction">{{item.cta}}</button>
      </view>
    </view>
  </block>
</view>
