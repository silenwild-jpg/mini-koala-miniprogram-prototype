.sc-card { margin-bottom: var(--mk-space-cardGap); }
.sc-card--compact { padding: var(--mk-space-cardPadCompact); }
.sc-head { display: flex; align-items: flex-start; }
.sc-name { display: block; }
.sc-meta { margin-top: 8rpx; }
.sc-km { margin-left: var(--mk-space-2); white-space: nowrap; font-size: var(--mk-font-size-sm); }
.sc-tags { margin-top: var(--mk-space-2); display: flex; flex-wrap: wrap; }
.sc-chev { margin-left: var(--mk-space-2); margin-top: 8rpx; }
.sc-cline { margin-top: var(--mk-space-2); display: flex; align-items: baseline; flex-wrap: wrap; }
.sc-cmeta { margin-left: var(--mk-space-2); }
.sc-foot { margin-top: var(--mk-space-3); padding-top: var(--mk-space-3); border-top: var(--mk-border-hairline); }
.sc-line { margin-top: var(--mk-space-3); padding-top: var(--mk-space-3); border-top: var(--mk-border-hairline); }
.sc-unit { font-size: var(--mk-font-size-sm); line-height: var(--mk-font-lineHeight-loose); }
.sc-uname { font-weight: var(--mk-font-weight-medium); color: var(--mk-color-ink-primary); }
.sc-tier { margin-left: var(--mk-space-1); margin-right: 0; }
.sc-buy { margin-top: var(--mk-space-2); align-items: flex-end; }
.sc-sub { display: block; margin-top: 4rpx; }
.mk-btn.mk-btn.sc-cta { min-width: 208rpx; margin-left: var(--mk-space-3); }
.sc-storelink { margin-top: var(--mk-space-3); padding-top: var(--mk-space-3); border-top: var(--mk-border-hairline); min-height: 64rpx; display: flex; align-items: center; justify-content: center; }

.sc-km { margin:0 12rpx 0 6rpx; }
/* 价格与按钮同一行（FIX-01 R-23，冻结稿：价格在左、104px 按钮靠右）；整期那一行放不下时在左栏内折行 */
.sc-buy { align-items:flex-end; flex-wrap:nowrap; }
.sc-buy > .mk-grow { flex-basis:auto; min-width:0; }
.mk-btn.mk-btn.sc-cta { margin-left:var(--mk-space-3); flex:none; }
.sc-sub { white-space:normal; overflow-wrap:anywhere; }

.sc-photo { width:136rpx; height:112rpx; border-radius:var(--mk-radius-thumb); margin-right:20rpx; flex:none; }
