.tk-wrap { margin-bottom: var(--mk-space-cardGap); }
.tk-card { border-left: 8rpx solid var(--mk-color-brand-fill); }
.tk-card--strong { border-left: 8rpx solid var(--mk-color-status-errorStrong); }
.tk-kicker { color: var(--mk-color-brand-text); font-size: var(--mk-font-size-xs); margin-bottom: 8rpx; }
.tk-head { display: flex; align-items: flex-start; }
.tk-title--strong { color: var(--mk-color-status-errorText); }
.tk-store { margin-top: 8rpx; font-weight: var(--mk-font-weight-semibold); color: var(--mk-color-ink-secondary); }
.tk-addr { margin-top: 4rpx; }
.tk-badge { flex: none; margin-left: var(--mk-space-2); display: inline-flex; align-items: center; height: var(--mk-size-tagHeight); padding: 0 var(--mk-space-2); border-radius: var(--mk-radius-control); font-size: var(--mk-font-size-xs); white-space: nowrap; background: var(--mk-color-brand-tint); color: var(--mk-color-brand-text); }
.tk-badge--warn { background: var(--mk-color-status-warningFill); color: var(--mk-color-status-warningText); }
.tk-badge--err { background: var(--mk-color-status-errorFill); color: var(--mk-color-status-errorText); }
.tk-facts { display: flex; margin-top: var(--mk-space-3); }
.tk-fact { display: flex; flex-direction: column; margin-right: var(--mk-space-5); min-width: 0; }
.tk-fv { font-size: var(--mk-font-size-xl); font-weight: var(--mk-font-weight-medium); white-space: nowrap; }
.tk-acts { display: flex; margin-top: var(--mk-space-3); }
.tk-btn { flex: 1; }
.tk-btn + .tk-btn { margin-left: var(--mk-space-2); }
.tk-svc { display: flex; margin-top: var(--mk-space-3); padding-top: var(--mk-space-3); border-top: var(--mk-border-hairline); }
.tk-svcitem { flex: 1; min-height: 64rpx; display: flex; flex-direction: column; align-items: center; }
.tk-svct { margin-top: 8rpx; font-size: var(--mk-font-size-xs); text-align: center; }
.tk-note { display: flex; align-items: flex-start; margin-top: var(--mk-space-3); padding-top: var(--mk-space-3); border-top: var(--mk-border-hairline); }
.tk-notetext { color: var(--mk-color-ink-secondary); font-size: var(--mk-font-size-xs); line-height: var(--mk-font-lineHeight-loose); }
.tk-noteb { color: var(--mk-color-ink-primary); font-weight: var(--mk-font-weight-semibold); }
.tk-notelink { flex: none; margin-left: var(--mk-space-2); font-size: var(--mk-font-size-xs); min-height: 64rpx; }
.tk-strip { margin-top: var(--mk-space-2); padding-top: 0; padding-bottom: 0; }
.tk-todo { display: flex; align-items: center; min-height: 88rpx; }
.tk-todo + .tk-todo { border-top: var(--mk-border-hairline); }
.tk-todok { flex: none; color: var(--mk-color-ink-secondary); font-size: var(--mk-font-size-xs); margin-right: var(--mk-space-2); }
.tk-todot { font-size: var(--mk-font-size-md); }
