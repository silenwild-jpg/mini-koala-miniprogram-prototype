.afn-note { background: var(--mk-color-canvas-card); border-radius: var(--mk-radius-card); padding: var(--mk-space-3) var(--mk-space-cardPad); box-shadow: var(--mk-elevation-card); border-left: 8rpx solid var(--mk-color-brand-fill); margin-bottom: var(--mk-space-cardGap); }
.afn-note--warn { border-left-color: var(--mk-color-accent-promoIcon); }
.afn-note--err { border-left-color: var(--mk-color-status-errorStrong); }
.afn-t { display: block; font-weight: var(--mk-font-weight-semibold); margin-bottom: var(--mk-space-1); }
.afn-s { color: var(--mk-color-ink-secondary); font-size: var(--mk-font-size-sm); line-height: var(--mk-font-lineHeight-loose); }
.afn-link { display: inline-block; padding: var(--mk-space-2) 0 var(--mk-space-2) var(--mk-space-2); color: var(--mk-color-ink-primary); }
